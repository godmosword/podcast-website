{
  "version": 1,
  "hooks": {
    "beforeMCPExecution": [
      {
        "command": ".cursor/hooks/block-auq.mjs",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/block-auq.mjs",
        "matcher": "AskQuestion|CallMcpTool",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/block-fable.mjs",
        "matcher": "Task|CallDynamicTool|CallMcpTool",
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/block-fable.mjs",
        "failClosed": true
      }
    ]
  }
}
