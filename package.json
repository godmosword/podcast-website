{
  "name": "chechecar",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:kart && next build",
    "build:kart": "npm ci --prefix kart-game --include=dev && npm run build --prefix kart-game",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "font:subset": "python3 scripts/subset_font.py",
    "sync:apple": "tsx scripts/sync-apple-podcast.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "illustrate": "tsx --env-file-if-exists=.env.local scripts/illustrate.ts",
    "verify:episodes": "tsx scripts/verify-episodes.ts",
    "backfill:captions": "tsx scripts/backfill-scene-captions.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^15.1.0",
    "openai": "^6.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fast-xml-parser": "^5.2.5",
    "opencc-js": "^1.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
