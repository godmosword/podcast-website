{
  "name": "chechecar",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run generate:llms-full",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "font:subset": "python3 scripts/subset_font.py",
    "sync:apple": "tsx scripts/sync-apple-podcast.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "illustrate": "tsx --env-file-if-exists=.env.local scripts/illustrate.ts",
    "verify:episodes": "tsx scripts/verify-episodes.ts",
    "verify:browse-index": "tsx scripts/verify-browse-index.ts",
    "verify:zone-art": "tsx scripts/verify-zone-art.ts",
    "verify:map-art": "tsx scripts/verify-map-art.ts",
    "proofread:subtitles": "tsx scripts/proofread-subtitles.ts",
    "check": "npm test && npm run verify:episodes && npm run verify:zone-art && npm run verify:map-art && npm run build",
    "backfill:captions": "tsx scripts/backfill-scene-captions.ts",
    "generate:map-art": "tsx --env-file-if-exists=.env.local scripts/generate-map-art.ts",
    "generate:forest-zone": "tsx --env-file-if-exists=.env.local scripts/generate-forest-zone-art.ts",
    "fix:map-art": "tsx scripts/fix-map-art.ts",
    "fix:forest-zone": "tsx scripts/fix-forest-zone-art.ts",
    "generate:character-portraits": "tsx --env-file-if-exists=.env.local scripts/generate-character-portraits.ts",
    "generate:landing-art": "tsx --env-file-if-exists=.env.local scripts/generate-landing-art.ts",
    "generate:roamer-assets": "tsx --env-file-if-exists=.env.local scripts/generate-roamer-assets.ts",
    "generate:llms-full": "tsx scripts/generate-llms-full.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/run-migration.ts",
    "generate:page-freshness": "tsx scripts/generate-page-freshness.ts",
    "optimize:roamer-assets": "tsx scripts/optimize-roamer-assets.ts",
    "optimize:adventures": "tsx scripts/optimize-adventure-assets.ts",
    "fix:roamer-alpha": "tsx scripts/fix-roamer-alpha.ts",
    "export:video": "tsx scripts/export-video-assets.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.1.0",
    "openai": "^6.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "fast-xml-parser": "^5.2.5",
    "opencc-js": "^1.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "knip": {
    "ignore": [
      "public/candy-kart/index.audio.worklet.js",
      "public/candy-kart/index.js",
      "public/sw.js"
    ],
    "ignoreBinaries": [
      "ffmpeg",
      "ffprobe",
      "gh",
      "python3",
      "which"
    ],
    "ignoreDependencies": [
      "eslint-config-next"
    ]
  }
}
