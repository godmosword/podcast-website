/models/

# CI 本機編譯 whisper.cpp 快取
/.cache/

# AI 插圖暫存（人工審圖前的草稿，勿入庫）
/public/.illustrate-staging/

# Landing Hero 生圖暫存（人工審圖前的草稿，勿入庫）
/public/.landing-staging/

# 漫遊者小車生圖暫存（人工審圖前的草稿，勿入庫）
/public/.roamer-staging/

