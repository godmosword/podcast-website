# 正式站網址（Open Graph / Twitter 分享圖的 metadataBase）
# Vercel Production 環境請設為同一值，勿依賴 preview 部署網域
NEXT_PUBLIC_SITE_URL=https://podcast-website-mu.vercel.app

# Optional production error monitoring. Keep user PII and query strings out of events.
# SENTRY_DSN=https://...
# NEXT_PUBLIC_SENTRY_DSN=https://...
# SENTRY_ENVIRONMENT=production

# Required in production for distributed public-form rate limiting.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# 可選：公開音檔 CDN／物件儲存 origin。未設定時開發與現有部署使用 /stories fallback。
# 只放免費／公開 Podcast 音檔；會員私有內容與 entitlement 另列於 TODOS 的 STEM-P4。
# NEXT_PUBLIC_AUDIO_BASE_URL=https://audio.example.com

# 新集通知 double opt-in（LIST-2）；不等同會員登入／付費驗證。
# RESEND_API_KEY=re_...
# SUBSCRIBE_FROM_EMAIL=車車遊樂園 <hello@example.com>

# 樂園地圖「通知我開幕」許願表（Neon Postgres；未設定時表單降級 mailto）
# DATABASE_URL=postgresql://...

# 首頁聯絡按鈕（未設定則不顯示該按鈕）
# NEXT_PUBLIC_CONTACT_FORM_URL=https://forms.example.com/contact
# NEXT_PUBLIC_WISH_FORM_URL=https://forms.example.com/wish
# NEXT_PUBLIC_FEEDBACK_FORM_URL=https://forms.example.com/feedback

# Apple Podcast 自動同步（npm run sync:apple / GitHub Actions）使用公開 iTunes Lookup + RSS，無需 API key。
#
# ── GHA 同步後通知（GitHub Issue + GitHub App 手機推播，設於 GitHub Secrets）──
# 1. 手機安裝 GitHub App，Settings → Notifications 開啟 Assigned / Mention
# 2. SYNC_ISSUE_ASSIGNEES=godmosword,teammate   # 新集 Issue 自動指派（Repository secret）
# 3. SYNC_ISSUE_MENTIONS=@godmosword @teammate  # Issue 開頭 @mention（可選）
# 4. NOTIFY_SITE_URL=https://podcast-website-mu.vercel.app  # Issue 內故事連結（可選）

# 每集劇情插圖自動生成（npm run illustrate -- <slug>）。
# 本機手動執行、人工審圖後才上線；CI 不放此 key、不生圖。
# 送出的是已公開的劇本文字（非音檔），用於切場景與生圖。
OPENAI_API_KEY=sk-...
# 可選：覆寫預設 model id（圖像模型若 gpt-image-2 不可用可改 gpt-image-1）
# OPENAI_TEXT_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-2
