# 正式站網址（Open Graph / Twitter 分享圖的 metadataBase）
# Vercel Production 環境請設為同一值，勿依賴 preview 部署網域
NEXT_PUBLIC_SITE_URL=https://podcast-website-mu.vercel.app

# 首頁聯絡按鈕（未設定則不顯示該按鈕）
# NEXT_PUBLIC_CONTACT_FORM_URL=https://forms.example.com/contact
# NEXT_PUBLIC_WISH_FORM_URL=https://forms.example.com/wish
# NEXT_PUBLIC_FEEDBACK_FORM_URL=https://forms.example.com/feedback

# Apple Podcast 自動同步（npm run sync:apple / GitHub Actions）使用公開 iTunes Lookup + RSS，無需 API key。
#
# ── GHA 同步後推播（LINE + Email，選填；設於 GitHub Secrets）──
#
# LINE Messaging API（推薦台灣維護者）
# 1. https://developers.line.biz/ 建立 Messaging API Channel
# 2. 發行 Channel access token（長期）→ LINE_CHANNEL_ACCESS_TOKEN
# 3. 將官方帳號加為好友，或邀進營運群組
# 4. 從 webhook 事件或 LINE Official Account Manager 取得 userId / groupId
#    → LINE_PUSH_TO（多人逗號分隔時走 multicast）
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_PUSH_TO=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LINE_PUSH_TO=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # 群組 groupId 範例
#
# Email 方式 A：Resend（https://resend.com ，免費額度）
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL_FROM=車車遊樂園 <notify@你的網域>
# NOTIFY_EMAIL_TO=bonbon@example.com,mami@example.com
#
# Email 方式 B：SMTP（Gmail 應用程式密碼等）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=you@gmail.com
# SMTP_PASS=應用程式密碼
# NOTIFY_EMAIL_FROM=車車遊樂園 <you@gmail.com>
# NOTIFY_EMAIL_TO=bonbon@example.com
#
# NOTIFY_SITE_URL=https://podcast-website-mu.vercel.app

# 每集劇情插圖自動生成（npm run illustrate -- <slug>）。
# 本機手動執行、人工審圖後才上線；CI 不放此 key、不生圖。
# 送出的是已公開的劇本文字（非音檔），用於切場景與生圖。
OPENAI_API_KEY=sk-...
# 可選：覆寫預設 model id（圖像模型若 gpt-image-2 不可用可改 gpt-image-1）
# OPENAI_TEXT_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-2
