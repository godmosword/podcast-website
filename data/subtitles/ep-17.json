[{"t":90,"text":"好大好大 好熱啊"},{"t":92.1,"text":"飄飄河上面的水花閃閃的"},{"t":94.9,"text":"泡泡呢 一顆一顆的飄上天空"},{"t":101.3,"text":"恐龍多多最期待的就是"},{"t":104.1,"text":"飄飄河"},{"t":106.2,"text":"多多呢 坐進了一個綠色的游泳圈裡面"},{"t":110.4,"text":"開心的說"},{"t":111.5,"text":"呦呼 飄飄河我來咯"},{"t":114.6,"text":"泳圈呢 慢慢的往前飄"},{"t":120,"text":"多多呢 輕輕的搖啊搖"},{"t":121.6,"text":"多多呢 覺得好舒服哦"},{"t":124.4,"text":"這時候呢 旁邊傳來了一個聲音"},{"t":128.4,"text":"噗噗噗 噗噗噗 最帥的車來咯"},{"t":132.2,"text":"嗨 多多"},{"t":133.7,"text":"我是噗噗豬"},{"t":135.9,"text":"我可以跟你一起飄嗎"},{"t":138,"text":"多多呢 點點頭說"},{"t":140.9,"text":"可以呀"},{"t":141.9,"text":"噗噗豬呢 也坐進了泳圈裡面"},{"t":145.1,"text":"兩臺車車呢 一起飄啊飄"},{"t":148.6,"text":"飄啊飄"},{"t":150.5,"text":"飄飄河呢 是一條慢慢流動的小河"},{"t":155.1,"text":"河水藍藍的"},{"t":157.1,"text":"旁邊呢 含有各式各樣顏色的游泳圈"},{"t":161.3,"text":"白色的泡泡呢 隨著風呢"},{"t":165.8,"text":"吹起慢慢往天空上飛"},{"t":168.6,"text":"涼涼的風吹來 好舒服哦"},{"t":173.4,"text":"恐龍多多 跟噗噗豬"},{"t":177.2,"text":"都快呀"},{"t":178.6,"text":"要睡著了呢"},{"t":188.3,"text":"忽然"},{"t":189.6,"text":"河邊傳來一個奇怪的聲音"},{"t":200.3,"text":"多多的眼睛睜大了"},{"t":202.9,"text":"ㄟ 瀑布豬你有聽到嗎"},{"t":206,"text":"瀑布豬呢也停了下來"},{"t":208,"text":"豬鼻子呢聞了聞揍了起來"},{"t":210.8,"text":"我聽到了"},{"t":212.9,"text":"會不會是"},{"t":214.1,"text":"會打呼"},{"t":215.4,"text":"的泡泡怪啊"},{"t":218,"text":"多多呢有一點緊張"},{"t":220,"text":"身體呢縮排了游泳圈裡面"},{"t":223.4,"text":"泡泡怪"},{"t":224.4,"text":"他會不會躲在河裡啊"},{"t":226.7,"text":"聲音又來了"},{"t":234.6,"text":"這一次聲音更大了"},{"t":237.4,"text":"瀑布豬呢跟多多呢都嚇到了"},{"t":240.5,"text":"瀑布豬呢"},{"t":241.8,"text":"喊著說"},{"t":242.8,"text":"啊我不要被泡泡怪吃掉了怎麼辦怎麼辦"},{"t":246.7,"text":"就在這個時候"},{"t":248.4,"text":"海龜暖暖老師遊了過來"},{"t":251.5,"text":"暖暖老師問"},{"t":253.3,"text":"多多"},{"t":254.3,"text":"瀑布豬你們怎麼停在這裡啊"},{"t":258.2,"text":"多多說"},{"t":259.7,"text":"飄飄河裡面有很奇怪的聲音"},{"t":262.5,"text":"很像會打呼的泡泡怪"},{"t":265.1,"text":"我們很害怕"},{"t":266.9,"text":"不知道怎麼辦"},{"t":269.7,"text":"暖暖老師呢沒有笑他們"},{"t":272,"text":"只是溫柔的說"},{"t":274,"text":"有一點怕怕的時候我們可以先停下來看清楚"},{"t":278.4,"text":"我們呢一起找答案好嗎"},{"t":281.5,"text":"瀑布豬呢躲在泳圈後面"},{"t":284,"text":"說"},{"t":285.1,"text":"那老師要走前面喔"},{"t":289.2,"text":"暖暖老師呢點點頭"},{"t":291.5,"text":"走在前面慢慢的帶路"},{"t":293.5,"text":"多多和瀑布豬呢就跟在後面"},{"t":296.3,"text":"他們呢先看看水面"},{"t":299.1,"text":"沒有看到泡泡怪"},{"t":301.7,"text":"再看河的兩邊岸上"},{"t":304.5,"text":"也沒有看到大腳印"},{"t":307.3,"text":"最後他們聽著聲音"},{"t":309.9,"text":"慢慢的靠近一座泡泡噴泉"},{"t":318.1,"text":"突然一大顆的泡泡呢從機器裡冒了出來"},{"t":322.7,"text":"瀑布豬呢和多多嚇得往後倒退"},{"t":325.8,"text":"泡泡怪出現啦"},{"t":328.8,"text":"暖暖老師呢仔細看了一下說"},{"t":332.4,"text":"不是泡泡怪啦"},{"t":334.2,"text":"只是泡泡的機器卡住了"},{"t":337,"text":"他呢正在努力的吐出大泡泡呢"},{"t":341.1,"text":"你們過來看泡泡機裡面卡著一片小葉子呢"},{"t":345.7,"text":"暖暖老師呢輕輕的把這個小葉子拿開"},{"t":350.3,"text":"好多的小泡泡又飛了出來"},{"t":355.2,"text":"飄飄河呢又變得亮晶晶的了"},{"t":358.5,"text":"也沒有怪怪的聲音囉"},{"t":361.1,"text":"多多這時候說"},{"t":363.4,"text":"喔"},{"t":364.2,"text":"原來是這樣"},{"t":365.7,"text":"泡泡豬呢眨眨眼的說"},{"t":368.5,"text":"喔原來不是怪物"},{"t":370.6,"text":"我承認我剛剛有一點怕啦"},{"t":373.4,"text":"不過我現在知道了"},{"t":375.2,"text":"我不怕囉"},{"t":376.2,"text":"我又變成"},{"t":377.5,"text":"最強最帥的泡泡豬了"},{"t":385.2,"text":"今天的故事是告訴我們"},{"t":389.6,"text":"有時候遇到一些害怕的事"},{"t":392.6,"text":"我們可以先停下來"},{"t":394.9,"text":"想一下"},{"t":396.2,"text":"看清楚"},{"t":397.7,"text":"也可以找朋友"},{"t":399.8,"text":"老師"},{"t":401.1,"text":"或是爸爸媽媽一起想辦法喔"},{"t":404.9,"text":"很多神秘的聲音"},{"t":407,"text":"或是黑黑的影子"},{"t":409,"text":"找到答案以後"},{"t":410.5,"text":"就會發現其實不是我們原本想的那樣喔"},{"t":414.6,"text":"我們千萬不要自己嚇自己喔"},{"t":419.2,"text":"好囉"},{"t":420,"text":"我們下次再一起來車車遊樂園玩吧"},{"t":424.1,"text":"拜拜"}]
