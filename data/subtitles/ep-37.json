[
  {
    "t": 0,
    "text": "我們一起出發去"
  },
  {
    "t": 4.5,
    "text": "嗨我是 Bonbon"
  },
  {
    "t": 10.9,
    "text": "我是馬米"
  },
  {
    "t": 12,
    "text": "小朋友你們有沒有看過啊"
  },
  {
    "t": 16.3,
    "text": "在稻田裡面農夫開著很大的一臺收割機"
  },
  {
    "t": 20.2,
    "text": "然後在稻田裡面開著的時候"
  },
  {
    "t": 22.8,
    "text": "很奇怪後面跟了很多的小鳥"
  },
  {
    "t": 27.3,
    "text": "你知道這些小鳥在做什麼嗎"
  },
  {
    "t": 29.9,
    "text": "他們在吃蟲"
  },
  {
    "t": 32.3,
    "text": "吃蟲哦"
  },
  {
    "t": 33.4,
    "text": "對啊"
  },
  {
    "t": 34.1,
    "text": "答對咯"
  },
  {
    "t": 37,
    "text": "這是Bonbon之前有問過我的問題對不對"
  },
  {
    "t": 42.8,
    "text": "對"
  },
  {
    "t": 43.1,
    "text": "好"
  },
  {
    "t": 43.9,
    "text": "那我們今天呢要說的故事就是"
  },
  {
    "t": 47,
    "text": "小鳥的稻田餐廳"
  },
  {
    "t": 50.7,
    "text": "收割機後面的小鳥在做什麼呢"
  },
  {
    "t": 53.8,
    "text": "那我們就來去聽故事吧"
  },
  {
    "t": 59.9,
    "text": "今天太陽公公露出了大大的笑臉"
  },
  {
    "t": 64.8,
    "text": "小鳥啾啾啾啾啾的唱著歌"
  },
  {
    "t": 68.3,
    "text": "秋天的風吹起來涼涼的"
  },
  {
    "t": 79,
    "text": "舒服極了"
  },
  {
    "t": 82.8,
    "text": "車車遊樂園的郊外"
  },
  {
    "t": 85.7,
    "text": "有一片又大又漂亮的金黃色稻田"
  },
  {
    "t": 90.3,
    "text": "一株一株的稻子長得又高又挺的"
  },
  {
    "t": 96.3,
    "text": "頂端的稻穗彎著腰"
  },
  {
    "t": 99.3,
    "text": "上面掛滿了一顆一顆金黃色胖嘟嘟的稻穀"
  },
  {
    "t": 105.1,
    "text": "每一顆稻穀的外面都包著一層硬硬的稻殼"
  },
  {
    "t": 111.1,
    "text": "就像穿著一件保護自己的小外套"
  },
  {
    "t": 115.5,
    "text": "就在這個時候"
  },
  {
    "t": 118.5,
    "text": "遠遠的地方傳來了一個聲音"
  },
  {
    "t": 122,
    "text": "開來了一臺又大又帥氣的收割機"
  },
  {
    "t": 127.1,
    "text": "它的名字叫做阿和"
  },
  {
    "t": 131.9,
    "text": "阿和說早安"
  },
  {
    "t": 135.6,
    "text": "阿和是一臺收割機"
  },
  {
    "t": 139.2,
    "text": "也有人叫它割稻機"
  },
  {
    "t": 141.8,
    "text": "它有著又大又寬的車身"
  },
  {
    "t": 145.3,
    "text": "車頭前面還有一個很特別的收割裝置"
  },
  {
    "t": 150.1,
    "text": "就像是有一個超級大嘴巴的機器"
  },
  {
    "t": 154.3,
    "text": "阿和一往前開"
  },
  {
    "t": 156.9,
    "text": "車頭的大嘴巴就會把一排又一排成熟的稻子收進來"
  },
  {
    "t": 165.7,
    "text": "接著它就會到裡面"
  },
  {
    "t": 170.3,
    "text": "然後它在開的時候它就會往後"
  },
  {
    "t": 173,
    "text": "它就會往後掉"
  },
  {
    "t": 175.1,
    "text": "對耶"
  },
  {
    "t": 176.7,
    "text": "它就掉下來"
  },
  {
    "t": 177.8,
    "text": "稻子進入阿和的機器裡"
  },
  {
    "t": 181.6,
    "text": "裡面有好多厲害的裝置"
  },
  {
    "t": 184.4,
    "text": "會把一顆一顆的稻穀和長長的稻草分開"
  },
  {
    "t": 189.8,
    "text": "金黃色的稻穀就會被收進去阿和的大骨倉裡面"
  },
  {
    "t": 197.3,
    "text": "那長長的稻草呢"
  },
  {
    "t": 198.9,
    "text": "就會從阿和的屁股後面排出來"
  },
  {
    "t": 204.9,
    "text": "有些還會被切成短短小小一段一段的小草"
  },
  {
    "t": 210.9,
    "text": "然後撒在田地上"
  },
  {
    "t": 212.8,
    "text": "哇"
  },
  {
    "t": 214.1,
    "text": "原來阿和不只會割稻子"
  },
  {
    "t": 216.8,
    "text": "他還會把稻穀跟稻草分開"
  },
  {
    "t": 220,
    "text": "很厲害吧"
  },
  {
    "t": 221.7,
    "text": "對呀"
  },
  {
    "t": 223.1,
    "text": "以前農夫如果用手割稻子的話"
  },
  {
    "t": 228,
    "text": "要花好多好多的時間"
  },
  {
    "t": 229.8,
    "text": "現在有這個收割機的幫忙"
  },
  {
    "t": 232.7,
    "text": "就可以省下好多的力氣了"
  },
  {
    "t": 234.8,
    "text": "就在阿和認真工作的時候"
  },
  {
    "t": 239.1,
    "text": "有一隻叫啾啾的小麻雀"
  },
  {
    "t": 245.6,
    "text": "突然從大樹上飛了下來"
  },
  {
    "t": 248.4,
    "text": "啾啾呢"
  },
  {
    "t": 251.6,
    "text": "看見這個正在工作的阿和"
  },
  {
    "t": 253.7,
    "text": "眼睛突然亮了起來"
  },
  {
    "t": 255.8,
    "text": "哇是阿和耶"
  },
  {
    "t": 258.2,
    "text": "太好了"
  },
  {
    "t": 259.6,
    "text": "他興奮的呢"
  },
  {
    "t": 262.3,
    "text": "拍著他的翅膀"
  },
  {
    "t": 264.6,
    "text": "大聲的對他同伴們說"
  },
  {
    "t": 266.7,
    "text": "開門咯"
  },
  {
    "t": 268.9,
    "text": "大家趕快來呀"
  },
  {
    "t": 270.8,
    "text": "稻田的餐廳開門啦"
  },
  {
    "t": 274.2,
    "text": "嗯"
  },
  {
    "t": 276.2,
    "text": "稻田餐廳是什麼餐廳呢"
  },
  {
    "t": 279.9,
    "text": "沒多久"
  },
  {
    "t": 281.8,
    "text": "天空就飛來了好多隻的小麻雀"
  },
  {
    "t": 284.9,
    "text": "啾啾啾"
  },
  {
    "t": 286.3,
    "text": "啾啾啾啾啾啾啾"
  },
  {
    "t": 288.4,
    "text": "啾啾"
  },
  {
    "t": 290,
    "text": "餐廳在哪裡呀"
  },
  {
    "t": 291.4,
    "text": "有沒有好吃的"
  },
  {
    "t": 293.2,
    "text": "我的肚子都餓了"
  },
  {
    "t": 294.4,
    "text": "肚子都咕嚕咕嚕叫了"
  },
  {
    "t": 297.1,
    "text": "啾啾呢"
  },
  {
    "t": 297.8,
    "text": "很開心的介紹說"
  },
  {
    "t": 300.4,
    "text": "歡迎光臨"
  },
  {
    "t": 301.6,
    "text": "今天的主廚特餐是"
  },
  {
    "t": 304.2,
    "text": "黃金稻穀套餐"
  },
  {
    "t": 307.6,
    "text": "哇"
  },
  {
    "t": 309.9,
    "text": "小麻雀們呢"
  },
  {
    "t": 311.2,
    "text": "開心的拍著翅膀"
  },
  {
    "t": 313.4,
    "text": "原來阿和在收割稻子的時候"
  },
  {
    "t": 316.6,
    "text": "有時候呢"
  },
  {
    "t": 317.7,
    "text": "會把一些稻穀啊"
  },
  {
    "t": 319.1,
    "text": "就掉落在田地裡面"
  },
  {
    "t": 321.4,
    "text": "這些呢"
  },
  {
    "t": 322.2,
    "text": "掉落的稻穀"
  },
  {
    "t": 323.4,
    "text": "剛好就是"
  },
  {
    "t": 324.2,
    "text": "小麻雀最喜歡吃的食物哦"
  },
  {
    "t": 327,
    "text": "小麻雀呢"
  },
  {
    "t": 329,
    "text": "等阿和開了一段之後"
  },
  {
    "t": 330.8,
    "text": "就會飛到已經收割完的田地上"
  },
  {
    "t": 333.2,
    "text": "低頭往下一看"
  },
  {
    "t": 335.7,
    "text": "左看看"
  },
  {
    "t": 337.2,
    "text": "右看看"
  },
  {
    "t": 338.8,
    "text": "一顆"
  },
  {
    "t": 341.2,
    "text": "兩顆"
  },
  {
    "t": 343.1,
    "text": "三顆"
  },
  {
    "t": 344.9,
    "text": "四顆五顆六顆七八九十"
  },
  {
    "t": 347.2,
    "text": "哇"
  },
  {
    "t": 348.5,
    "text": "這裡還有好多好多顆耶"
  },
  {
    "t": 350.9,
    "text": "咚咚咚咚"
  },
  {
    "t": 352.8,
    "text": "小麻雀們呢"
  },
  {
    "t": 354,
    "text": "吃得津津有味的"
  },
  {
    "t": 356.4,
    "text": "嗯"
  },
  {
    "t": 357.1,
    "text": "真好吃"
  },
  {
    "t": 359.3,
    "text": "這一間稻田餐廳真棒"
  },
  {
    "t": 361.7,
    "text": "有好多美味的稻穀哦"
  },
  {
    "t": 365.1,
    "text": "就在這個時候"
  },
  {
    "t": 367.1,
    "text": "一隻白色的大鳥"
  },
  {
    "t": 368.9,
    "text": "從天空上慢慢飛了下來"
  },
  {
    "t": 375.5,
    "text": "它有著雪白色的羽毛"
  },
  {
    "t": 379.7,
    "text": "長長的脖子"
  },
  {
    "t": 382.3,
    "text": "還有兩隻細細長的魚毛"
  },
  {
    "t": 383.9,
    "text": "長長的腳"
  },
  {
    "t": 386.7,
    "text": "它是誰啊"
  },
  {
    "t": 388.5,
    "text": "白鹿獅"
  },
  {
    "t": 392.1,
    "text": "對"
  },
  {
    "t": 393.3,
    "text": "原來是白鹿獅"
  },
  {
    "t": 395.3,
    "text": "它的名字叫做白白"
  },
  {
    "t": 397.5,
    "text": "白白"
  },
  {
    "t": 398.7,
    "text": "白白好奇的問"
  },
  {
    "t": 400.5,
    "text": "你們怎麼都聚在這裡啊"
  },
  {
    "t": 404.1,
    "text": "啾啾呢立刻飛了過去"
  },
  {
    "t": 406.3,
    "text": "歡迎光臨歡迎光臨"
  },
  {
    "t": 408.2,
    "text": "請問這位客人要不要來一份"
  },
  {
    "t": 410.7,
    "text": "黃金稻穀套餐啊"
  },
  {
    "t": 413.7,
    "text": "白白愣了一下說"
  },
  {
    "t": 415.1,
    "text": "嗯"
  },
  {
    "t": 417,
    "text": "可是我不喜歡吃稻穀欸"
  },
  {
    "t": 420.3,
    "text": "你竟然不喜歡吃我們的招牌料理"
  },
  {
    "t": 424.9,
    "text": "因為我比較喜歡吃小魚"
  },
  {
    "t": 428.3,
    "text": "小蝦"
  },
  {
    "t": 429.3,
    "text": "還有小蟲子啦"
  },
  {
    "t": 430.8,
    "text": "就在這個時候"
  },
  {
    "t": 433.4,
    "text": "阿和呢從旁邊經過"
  },
  {
    "t": 436,
    "text": "一隻小蟲呢突然從稻草旁邊鑽了出來"
  },
  {
    "t": 443.5,
    "text": "接著"
  },
  {
    "t": 444.8,
    "text": "第二隻"
  },
  {
    "t": 446.3,
    "text": "第三隻"
  },
  {
    "t": 448.6,
    "text": "哎呀越來越多的小蟲也鑽了出來"
  },
  {
    "t": 453,
    "text": "白白的眼睛呢突然亮了起來"
  },
  {
    "t": 458.1,
    "text": "我的美食出現囉"
  },
  {
    "t": 460.7,
    "text": "噓"
  },
  {
    "t": 462.2,
    "text": "它伸長了脖子"
  },
  {
    "t": 464.2,
    "text": "左看看"
  },
  {
    "t": 466,
    "text": "右看看"
  },
  {
    "t": 468.1,
    "text": "白白呢放輕腳步"
  },
  {
    "t": 470.9,
    "text": "慢慢走過去"
  },
  {
    "t": 472.7,
    "text": "答對了"
  },
  {
    "t": 473.3,
    "text": "它慢慢慢慢地走著"
  },
  {
    "t": 477.2,
    "text": "一步"
  },
  {
    "t": 478.7,
    "text": "兩步"
  },
  {
    "t": 480.5,
    "text": "三步"
  },
  {
    "t": 482.8,
    "text": "突然"
  },
  {
    "t": 484.1,
    "text": "白白很迅速地伸出它尖尖的嘴巴"
  },
  {
    "t": 488.7,
    "text": "哇它抓到了"
  },
  {
    "t": 490.2,
    "text": "它抓到了小蟲子啦"
  },
  {
    "t": 493.3,
    "text": "啾啾呢"
  },
  {
    "t": 495.3,
    "text": "啾啾很驚訝地張大嘴巴說"
  },
  {
    "t": 497.9,
    "text": "哇白白"
  },
  {
    "t": 498.9,
    "text": "你抓小蟲子的速度也太快了吧"
  },
  {
    "t": 502.8,
    "text": "白白呢"
  },
  {
    "t": 503.1,
    "text": "得意地說"
  },
  {
    "t": 504.4,
    "text": "嘿嘿"
  },
  {
    "t": 505.2,
    "text": "這可是我的強項呢"
  },
  {
    "t": 509,
    "text": "原來阿和呢在收割稻子的時候"
  },
  {
    "t": 512.4,
    "text": "會驚動原本躲在稻草跟土裡的小蟲"
  },
  {
    "t": 516.2,
    "text": "這些小蟲呢就會跑出來"
  },
  {
    "t": 518.8,
    "text": "白鹿獅呢就會跟在收割機後面飽餐一頓"
  },
  {
    "t": 523.4,
    "text": "啾啾呢突然拍了一下翅膀說"
  },
  {
    "t": 526.4,
    "text": "噢"
  },
  {
    "t": 526.9,
    "text": "我知道了"
  },
  {
    "t": 528,
    "text": "原來"
  },
  {
    "t": 528.7,
    "text": "我們稻田餐廳"
  },
  {
    "t": 530.3,
    "text": "還有第二種選單喔"
  },
  {
    "t": 532.8,
    "text": "他輕輕喉嚨說"
  },
  {
    "t": 535.7,
    "text": "各位客人請注意"
  },
  {
    "t": 537.7,
    "text": "今天稻田餐廳"
  },
  {
    "t": 539.8,
    "text": "推出兩道招牌料理"
  },
  {
    "t": 542.6,
    "text": "第一道就是"
  },
  {
    "t": 543.8,
    "text": "麻雀最愛的黃金稻穀"
  },
  {
    "t": 547.2,
    "text": "第二道"
  },
  {
    "t": 548.2,
    "text": "就是白鹿獅最愛的小蟲"
  },
  {
    "t": 553.6,
    "text": "忙了一整個早上"
  },
  {
    "t": 555.1,
    "text": "阿和呢終於完成了今天的收割工作囉"
  },
  {
    "t": 559.5,
    "text": "他的大骨倉裡"
  },
  {
    "t": 561.5,
    "text": "裝了滿滿的"
  },
  {
    "t": 562.7,
    "text": "黃金稻穀喔"
  },
  {
    "t": 565.5,
    "text": "啾啾好奇問"
  },
  {
    "t": 567.3,
    "text": "阿和"
  },
  {
    "t": 568.3,
    "text": "這麼多的稻穀"
  },
  {
    "t": 569.6,
    "text": "接下來要怎麼做呢"
  },
  {
    "t": 572.4,
    "text": "我會先把收割好的稻穀"
  },
  {
    "t": 574.7,
    "text": "送去烘乾"
  },
  {
    "t": 576.5,
    "text": "接著再送去粘米場"
  },
  {
    "t": 578.8,
    "text": "讓機器呢把外面硬硬的殼去掉"
  },
  {
    "t": 582.4,
    "text": "再把米的外層磨一磨"
  },
  {
    "t": 585.2,
    "text": "就會變成我們平常吃的白米囉"
  },
  {
    "t": 588.8,
    "text": "哇"
  },
  {
    "t": 589.8,
    "text": "原來一碗香噴噴的白米飯要經過"
  },
  {
    "t": 592.4,
    "text": "這麼多的工作啊"
  },
  {
    "t": 594.7,
    "text": "阿和呢點點頭"
  },
  {
    "t": 596.7,
    "text": "每一粒米都很珍貴喔"
  },
  {
    "t": 599,
    "text": "我們要珍惜食物"
  },
  {
    "t": 601.3,
    "text": "好好的把這些白飯吃完"
  },
  {
    "t": 603.6,
    "text": "不可以浪費喔"
  },
  {
    "t": 607.5,
    "text": "阿和阿和"
  },
  {
    "t": 609,
    "text": "你明天還會來嗎"
  },
  {
    "t": 611.8,
    "text": "阿和想了一下說"
  },
  {
    "t": 613.9,
    "text": "明天啊"
  },
  {
    "t": 615.1,
    "text": "我要去隔壁的另一個稻田收割喔"
  },
  {
    "t": 619.2,
    "text": "啾啾的眼睛亮了起來說"
  },
  {
    "t": 622.1,
    "text": "那明天隔壁就有稻田餐廳囉"
  },
  {
    "t": 626.2,
    "text": "白白說"
  },
  {
    "t": 627.2,
    "text": "那我明天也要去"
  },
  {
    "t": 629.2,
    "text": "好啊"
  },
  {
    "t": 630.3,
    "text": "那我們明天一起去隔壁的稻田餐廳吧"
  },
  {
    "t": 636.4,
    "text": "那我們約好明天早上見囉"
  },
  {
    "t": 639.2,
    "text": "拜拜"
  },
  {
    "t": 648.9,
    "text": "小朋友今天的故事是不是很有趣呢"
  },
  {
    "t": 651.8,
    "text": "原來稻田不是只有農夫種稻米的地方喔"
  },
  {
    "t": 657.4,
    "text": "也是好多小動物會尋找食物的地方呢"
  },
  {
    "t": 662.8,
    "text": "下一次你們經過稻田的時候"
  },
  {
    "t": 665.3,
    "text": "看到收割機後面"
  },
  {
    "t": 667.4,
    "text": "出現一群小麻雀"
  },
  {
    "t": 669.4,
    "text": "或是白鹿絲"
  },
  {
    "t": 671.5,
    "text": "你就知道他們在做什麼囉"
  },
  {
    "t": 674.8,
    "text": "好囉"
  },
  {
    "t": 675.6,
    "text": "那今天的故事我們就說到這邊囉"
  },
  {
    "t": 679.4,
    "text": "下一次我們再一起來"
  },
  {
    "t": 681.5,
    "text": "特色遊樂園玩吧"
  },
  {
    "t": 684.3,
    "text": "拜拜"
  }
]
