[{"t":0,"text":"我們一起出發去"},{"t":4.5,"text":"車車遊樂園"},{"t":8,"text":"嗨我是 Bonbon"},{"t":10.8,"text":"我是馬米"},{"t":11.9,"text":"我們今天要講的是有關於賽車的故事哦"},{"t":17.1,"text":"哇今天天氣好好哦"},{"t":20,"text":"歡迎來到車車遊樂園"},{"t":22.7,"text":"我們呢今天呢遊樂園裡面要舉辦一場賽車比賽"},{"t":28.5,"text":"裡面有賽車還有跟一般的車"},{"t":32.4,"text":"有藍色的小巴士"},{"t":34.6,"text":"黃色的計程車"},{"t":36.6,"text":"拖吊車救護車"},{"t":38.9,"text":"還有跑得很快很有衝勁的小紅賽車"},{"t":42.4,"text":"小紅賽車呢一邊熱身"},{"t":45.4,"text":"然後一邊說"},{"t":46.4,"text":"嗯我今天一定是第一名"},{"t":49.2,"text":"我一定要贏"},{"t":50.5,"text":"他的輪胎啊不停的轉啊轉"},{"t":53.6,"text":"小紅賽車呢心裡又期待"},{"t":57.6,"text":"又有一點興奮"},{"t":58.4,"text":"這時候呢廣播聲響起咯"},{"t":62.4,"text":"請各位準備好要集合咯"},{"t":68.9,"text":"我們的比賽呢快要開始了"},{"t":71.9,"text":"這時候呢所有的車車呢都開到了起跑線上面"},{"t":76.9,"text":"準備就定位"},{"t":78.6,"text":"這時候呢裁判呢就舉起了旗子說"},{"t":82.4,"text":"各位車車們準備好了嗎"},{"t":85.3,"text":"準備好了之後呢"},{"t":87.4,"text":"我們等一下呢"},{"t":88.4,"text":"三二一之後"},{"t":89.7,"text":"聲響就出發咯"},{"t":92.2,"text":"小紅賽車呢"},{"t":97.7,"text":"咻一下就衝了出去"},{"t":99.7,"text":"他跑得好快好快"},{"t":102.1,"text":"一下子就跑到了最前面"},{"t":104.6,"text":"小紅賽車呢又開心又得意的說"},{"t":111.4,"text":"耶我最快我一定是第一名"},{"t":114.1,"text":"可是呢"},{"t":116.1,"text":"跑到一半的時候"},{"t":117.5,"text":"小紅賽車呢"},{"t":118.4,"text":"他突然看到前面有一個小水坑"},{"t":122,"text":"他太擠了"},{"t":123.2,"text":"他沒有減速"},{"t":124.5,"text":"也沒有慢慢的轉彎"},{"t":126.6,"text":"突然間"},{"t":129.3,"text":"哎呀"},{"t":130.3,"text":"小紅賽車的輪胎打滑了"},{"t":133.6,"text":"小紅賽車呢停了下來"},{"t":136.5,"text":"這時候呢旁邊呢有一臺藍色的小巴士開了過來"},{"t":141.9,"text":"很溫柔的問小紅你還好嗎"},{"t":146.3,"text":"這時候呢"},{"t":147.3,"text":"小紅呢"},{"t":148.3,"text":"很著急的快哭了"},{"t":150.1,"text":"小紅說"},{"t":151,"text":"我不好"},{"t":152,"text":"我本來是要第一名的"},{"t":153.8,"text":"可是我現在一定會輸"},{"t":155.8,"text":"藍色的小巴士說"},{"t":157.9,"text":"輸了會很難過"},{"t":159.4,"text":"這是很正常的哦"},{"t":161.2,"text":"可是比賽不是隻有看誰會得第一名哦"},{"t":164.7,"text":"很重要的是"},{"t":165.9,"text":"你有沒有努力的把它完成"},{"t":168.8,"text":"小紅賽車呢低著頭說"},{"t":170.9,"text":"可是我真的很想很想要第一名"},{"t":175.8,"text":"藍色的小巴士說"},{"t":177.8,"text":"想贏嗎"},{"t":178.2,"t