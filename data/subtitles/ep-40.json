[
  {
    "t": 0,
    "text": "我們一起出發去"
  },
  {
    "t": 4.4,
    "text": "嗨 我是 Bonbon"
  },
  {
    "t": 10.8,
    "text": "我是馬米"
  },
  {
    "t": 12,
    "text": "蹦蹦我們最近呢"
  },
  {
    "t": 15.1,
    "text": "有去日本的小松"
  },
  {
    "t": 16.9,
    "text": "參觀了一臺超級巨大的挖土機"
  },
  {
    "t": 20.5,
    "text": "對不對"
  },
  {
    "t": 21.4,
    "text": "它有三層樓這麼高"
  },
  {
    "t": 23.3,
    "text": "一般我們的挖土機"
  },
  {
    "t": 26.2,
    "text": "大概是一層樓那麼高"
  },
  {
    "t": 28,
    "text": "對對對"
  },
  {
    "t": 34.5,
    "text": "蹦蹦在示範它的那個挖鬥"
  },
  {
    "t": 38.1,
    "text": "好 謝謝"
  },
  {
    "t": 42.6,
    "text": "蹦蹦呢示範了一項"
  },
  {
    "t": 44.8,
    "text": "它是在學我們當時候在日本小松"
  },
  {
    "t": 48,
    "text": "看到的那個巨型挖土機"
  },
  {
    "t": 50,
    "text": "然後它的動作呢"
  },
  {
    "t": 52,
    "text": "非常的緩慢"
  },
  {
    "t": 53.3,
    "text": "但是呢"
  },
  {
    "t": 54.4,
    "text": "它的挖鬥呢"
  },
  {
    "t": 55.5,
    "text": "就會慢慢的往上"
  },
  {
    "t": 58,
    "text": "往下"
  },
  {
    "t": 59.2,
    "text": "我那時候還要去那裡"
  },
  {
    "t": 61.5,
    "text": "開小挖土機對不對"
  },
  {
    "t": 63.5,
    "text": "因為玩那個挖土機"
  },
  {
    "t": 65.1,
    "text": "它要挖石頭"
  },
  {
    "t": 66.4,
    "text": "那邊裡面還有可以給你操作"
  },
  {
    "t": 69.6,
    "text": "那個小小挖土機"
  },
  {
    "t": 71.2,
    "text": "對 還有給你操作模擬"
  },
  {
    "t": 73,
    "text": "對 很酷耶"
  },
  {
    "t": 74.7,
    "text": "很好玩對不對"
  },
  {
    "t": 76.1,
    "text": "好"
  },
  {
    "t": 76.9,
    "text": "我們今天呢"
  },
  {
    "t": 78.4,
    "text": "要說的故事呢"
  },
  {
    "t": 79.5,
    "text": "就是挖土機"
  },
  {
    "t": 81,
    "text": "東東的礦山大冒險"
  },
  {
    "t": 83.2,
    "text": "東東呢"
  },
  {
    "t": 85,
    "text": "要去認識這一臺"
  },
  {
    "t": 86.4,
    "text": "來自日本的巨型挖土機"
  },
  {
    "t": 88,
    "text": "巨型挖土機喔"
  },
  {
    "t": 90,
    "text": "那我們就一起來去聽故事吧"
  },
  {
    "t": 96.9,
    "text": "最近呢"
  },
  {
    "t": 97.9,
    "text": "挖土機東東"
  },
  {
    "t": 99.5,
    "text": "他收到了一封"
  },
  {
    "t": 100.8,
    "text": "特別的邀請函"
  },
  {
    "t": 102.8,
    "text": "裡面寫著"
  },
  {
    "t": 104.6,
    "text": "親愛的東東你好"
  },
  {
    "t": 106.9,
    "text": "我是日本小松的巨型挖土機"
  },
  {
    "t": 110.5,
    "text": "希望有機會呢"
  },
  {
    "t": 111.8,
    "text": "可以認識你"
  },
  {
    "t": 113,
    "text": "帶你參觀礦山"
  },
  {
    "t": 115.6,
    "text": "看看我們平常都在做哪些工作呢"
  },
  {
    "t": 118,
    "text": "然後呢"
  },
  {
    "t": 118.7,
    "text": "東東呢"
  },
  {
    "t": 120.8,
    "text": "很開心的說"
  },
  {
    "t": 121.8,
    "text": "哇"
  },
  {
    "t": 122.6,
    "text": "礦山"
  },
  {
    "t": 123.8,
    "text": "礦山到底是什麼地方啊"
  },
  {
    "t": 126.9,
    "text": "不知道"
  },
  {
    "t": 127.9,
    "text": "不知道是什麼地方"
  },
  {
    "t": 130,
    "text": "礦山啊"
  },
  {
    "t": 131.5,
    "text": "就是人們開採"
  },
  {
    "t": 132.8,
    "text": "石頭和礦物的地方"
  },
  {
    "t": 135.9,
    "text": "有些石頭可以拿來鋪馬路"
  },
  {
    "t": 139.2,
    "text": "蓋房子"
  },
  {
    "t": 142,
    "text": "有些石頭裡面還藏著金屬"
  },
  {
    "t": 145.1,
    "text": "像是"
  },
  {
    "t": 146.4,
    "text": "鐵啊"
  },
  {
    "t": 147.4,
    "text": "銅"
  },
  {
    "t": 148,
    "text": "鋁"
  },
  {
    "t": 150,
    "text": "這些金屬啊"
  },
  {
    "t": 151,
    "text": "經過工廠的加工"
  },
  {
    "t": 152.8,
    "text": "就可以製造成我們呢"
  },
  {
    "t": 155.1,
    "text": "常常在馬路上看到的汽車"
  },
  {
    "t": 158.2,
    "text": "火車"
  },
  {
    "t": 160.2,
    "text": "還有挖土機哦"
  },
  {
    "t": 163.3,
    "text": "火庫吧"
  },
  {
    "t": 164.3,
    "text": "好酷"
  },
  {
    "t": 166.9,
    "text": "今天一大早東東呢"
  },
  {
    "t": 168.7,
    "text": "就帶著好奇的心情"
  },
  {
    "t": 170.7,
    "text": "沿著彎彎的山路出發囉"
  },
  {
    "t": 173.6,
    "text": "一路上啊"
  },
  {
    "t": 176.6,
    "text": "風吹過樹林"
  },
  {
    "t": 178,
    "text": "小鳥呢"
  },
  {
    "t": 179.2,
    "text": "在樹上啾啾啾啾啾的唱歌"
  },
  {
    "t": 183.3,
    "text": "東東呢"
  },
  {
    "t": 184.1,
    "text": "開了好久好久"
  },
  {
    "t": 186.4,
    "text": "終於呢"
  },
  {
    "t": 187.2,
    "text": "來到了一座巨大的礦山"
  },
  {
    "t": 192,
    "text": "哇"
  },
  {
    "t": 192.8,
    "text": "這裡也太大了吧"
  },
  {
    "t": 196.6,
    "text": "眼前的山坡上啊"
  },
  {
    "t": 198.2,
    "text": "到處都是大大小小的石頭哦"
  },
  {
    "t": 202.3,
    "text": "有尖尖的石頭"
  },
  {
    "t": 204.3,
    "text": "圓圓的石頭"
  },
  {
    "t": 206.6,
    "text": "還有一個比"
  },
  {
    "t": 207.9,
    "text": "東東還要高的大石頭"
  },
  {
    "t": 211,
    "text": "哇"
  },
  {
    "t": 213,
    "text": "遠遠的地方呢"
  },
  {
    "t": 214.3,
    "text": "還有好多的大卡車正在忙碌的工作者"
  },
  {
    "t": 218.9,
    "text": "就在這個時候"
  },
  {
    "t": 220.5,
    "text": "一個很低沉的聲音突然響起"
  },
  {
    "t": 224.6,
    "text": "嗨東東"
  },
  {
    "t": 226.1,
    "text": "歡迎來到礦山"
  },
  {
    "t": 228.9,
    "text": "東東左看看"
  },
  {
    "t": 231.2,
    "text": "右看看"
  },
  {
    "t": 232.2,
    "text": "咦"
  },
  {
    "t": 232.8,
    "text": "是誰在叫我啊"
  },
  {
    "t": 235.3,
    "text": "東東"
  },
  {
    "t": 236.1,
    "text": "我在這裡啦"
  },
  {
    "t": 237.6,
    "text": "東東呢"
  },
  {
    "t": 238.4,
    "text": "抬頭一看"
  },
  {
    "t": 239.7,
    "text": "哇"
  },
  {
    "t": 241.5,
    "text": "你怎麼這麼高這麼大臺呀"
  },
  {
    "t": 245,
    "text": "眼前呢竟然是一臺"
  },
  {
    "t": 247.1,
    "text": "超級巨大的黃色挖土機哦"
  },
  {
    "t": 253.7,
    "text": "他有著兩條寬寬的黑色履帶"
  },
  {
    "t": 257.8,
    "text": "長長的挖鬥手臂"
  },
  {
    "t": 262.2,
    "text": "手臂前端還裝著一個很巨型的大挖鬥哦"
  },
  {
    "t": 267.3,
    "text": "東東"
  },
  {
    "t": 269.4,
    "text": "你好"
  },
  {
    "t": 270.1,
    "text": "我是小松挖土機"
  },
  {
    "t": 272.4,
    "text": "你可以叫我阿松哦"
  },
  {
    "t": 274.5,
    "text": "阿松"
  },
  {
    "t": 276.3,
    "text": "嘿嘿"
  },
  {
    "t": 277.6,
    "text": "我呢可是專門在大型的礦山工作的挖土機哦"
  },
  {
    "t": 282.7,
    "text": "東東好奇的問"
  },
  {
    "t": 285,
    "text": "阿松"
  },
  {
    "t": 285.8,
    "text": "你到底有多高啊"
  },
  {
    "t": 288.1,
    "text": "我也不知道你有多高"
  },
  {
    "t": 290.1,
    "text": "我有8.3公尺高哦"
  },
  {
    "t": 292.9,
    "text": "哇8.3公尺"
  },
  {
    "t": 295.7,
    "text": "比一層樓還高"
  },
  {
    "t": 297,
    "text": "8.3公尺那是多高啊"
  },
  {
    "t": 300.1,
    "text": "大約有三層樓這麼高哦"
  },
  {
    "t": 303.9,
    "text": "跟三層樓一樣"
  },
  {
    "t": 305,
    "text": "嗯"
  },
  {
    "t": 306,
    "text": "走吧"
  },
  {
    "t": 307.8,
    "text": "我帶你去看看我的工作"
  },
  {
    "t": 309.8,
    "text": "阿松呢慢慢的往前移動"
  },
  {
    "t": 313.7,
    "text": "東東呢跟在後面"
  },
  {
    "t": 316.7,
    "text": "咦"
  },
  {
    "t": 319.5,
    "text": "阿松"
  },
  {
    "t": 321.1,
    "text": "你怎麼開的這麼慢啊"
  },
  {
    "t": 323.1,
    "text": "因為我太大臺"
  },
  {
    "t": 326.5,
    "text": "太重了"
  },
  {
    "t": 326.7,
    "text": "所以呢只能用很慢"
  },
  {
    "t": 330.3,
    "text": "很慢的速度移動哦"
  },
  {
    "t": 332.6,
    "text": "原來是這樣啊"
  },
  {
    "t": 335.4,
    "text": "我雖然呢開的很慢"
  },
  {
    "t": 337.7,
    "text": "可是我的力氣很大哦"
  },
  {
    "t": 339.5,
    "text": "好謝謝你"
  },
  {
    "t": 346.7,
    "text": "太大聲了這樣變怪了"
  },
  {
    "t": 350,
    "text": "東東你看看我的挖鬥"
  },
  {
    "t": 352.6,
    "text": "我的挖鬥呢容量超級大哦"
  },
  {
    "t": 356.4,
    "text": "大約有家裡一百多個浴缸那麼大哦"
  },
  {
    "t": 360.3,
    "text": "哇"
  },
  {
    "t": 361,
    "text": "家裡一百個浴缸耶"
  },
  {
    "t": 363.1,
    "text": "他是說容量"
  },
  {
    "t": 365.1,
    "text": "就是可以裝的那個量"
  },
  {
    "t": 367.2,
    "text": "很多"
  },
  {
    "t": 369,
    "text": "哇"
  },
  {
    "t": 370.5,
    "text": "一百個"
  },
  {
    "t": 372,
    "text": "是我們平常在家裡泡澡的那種浴缸嗎"
  },
  {
    "t": 375.6,
    "text": "沒錯哦"
  },
  {
    "t": 377.2,
    "text": "東東呢開始數起來"
  },
  {
    "t": 379.5,
    "text": "一個"
  },
  {
    "t": 380.5,
    "text": "兩個"
  },
  {
    "t": 381.8,
    "text": "三個四個五個六個"
  },
  {
    "t": 383.8,
    "text": "太多了太多了我數不完耶"
  },
  {
    "t": 386.1,
    "text": "哈哈哈哈"
  },
  {
    "t": 388.1,
    "text": "四對我好辣"
  },
  {
    "t": 416.1,
    "text": "七十七七六七三七四七六七六七七七八七九八十八一八二八十八四八五八六八七八八八九九十九一九二九三九四九五九九九七十九八九十一百"
  },
  {
    "t": 430.1,
    "text": "謝謝你數這麼多"
  },
  {
    "t": 432.1,
    "text": "謝謝蹦蹦的幫忙"
  },
  {
    "t": 434.1,
    "text": "好的"
  },
  {
    "t": 436.1,
    "text": "阿松說"
  },
  {
    "t": 437.1,
    "text": "現在我來示範怎麼工作喔"
  },
  {
    "t": 440.1,
    "text": "阿松呢伸出他長長的蛙鬥手臂"
  },
  {
    "t": 444.1,
    "text": "他往下一蛙"
  },
  {
    "t": 446.1,
    "text": "嗯"
  },
  {
    "t": 450.1,
    "text": "好再往上一臺"
  },
  {
    "t": 452.1,
    "text": "嗯"
  },
  {
    "t": 454.1,
    "text": "哇"
  },
  {
    "t": 456.1,
    "text": "好多好多的石頭啊"
  },
  {
    "t": 458.1,
    "text": "一下子呢就裝進了大蛙鬥裡面了"
  },
  {
    "t": 462.1,
    "text": "接著呢阿松呢慢慢轉動他的上半身"
  },
  {
    "t": 470.1,
    "text": "把石頭呢倒進旁邊的大草堆"
  },
  {
    "t": 475.1,
    "text": "嗯"
  },
  {
    "t": 476.1,
    "text": "蹦蹦呢看的眼睛都亮了"
  },
  {
    "t": 479.1,
    "text": "哇好厲害喔"
  },
  {
    "t": 482.1,
    "text": "蹦蹦呢看看自己的小蛙鬥"
  },
  {
    "t": 485.1,
    "text": "再看看阿松的超級大蛙鬥"
  },
  {
    "t": 488.1,
    "text": "嗯"
  },
  {
    "t": 490.1,
    "text": "我的蛙鬥怎麼這麼小啊"
  },
  {
    "t": 493.1,
    "text": "蹦蹦每臺蛙土機的大小都不一樣喔"
  },
  {
    "t": 498.1,
    "text": "小蛙土機也有很厲害的地方喔"
  },
  {
    "t": 502.1,
    "text": "真的嗎"
  },
  {
    "t": 504.1,
    "text": "嗯"
  },
  {
    "t": 505.1,
    "text": "就在這個時候"
  },
  {
    "t": 507.1,
    "text": "遠方呢突然傳來很急促的喇叭聲"
  },
  {
    "t": 513.1,
    "text": "一臺載滿碎石的大卡車開了過來說"
  },
  {
    "t": 517.1,
    "text": "不好了不好了"
  },
  {
    "t": 519.1,
    "text": "前面的運送道路被大石頭都擋住了"
  },
  {
    "t": 522.1,
    "text": "我們沒有辦法把石頭送出去"
  },
  {
    "t": 525.1,
    "text": "這樣子要怎麼辦呢"
  },
  {
    "t": 528.1,
    "text": "阿松呢立刻說"
  },
  {
    "t": 530.1,
    "text": "咚咚我們去看看"
  },
  {
    "t": 532.1,
    "text": "兩臺蛙土機呢來到了山路旁邊"
  },
  {
    "t": 534.1,
    "text": "哇"
  },
  {
    "t": 536.1,
    "text": "一塊呢比蹦蹦還要高的巨大石頭竟然擋在路的中間耶"
  },
  {
    "t": 542.1,
    "text": "遠遠看過去簡直就像一座小山丘"
  },
  {
    "t": 546.1,
    "text": "旁邊呢還散落了好多的小石塊"
  },
  {
    "t": 550.1,
    "text": "蹦蹦驚訝的說"
  },
  {
    "t": 552.1,
    "text": "天啊這麼大顆的石頭怎麼會跑到馬路上啊"
  },
  {
    "t": 557.1,
    "text": "可能是山坡上的石頭鬆動滾了下來"
  },
  {
    "t": 562.1,
    "text": "阿松你不是力氣很大嗎"
  },
  {
    "t": 566.1,
    "text": "那你趕快把這顆石頭搬走吧"
  },
  {
    "t": 570.1,
    "text": "阿松呢仔細看了看說"
  },
  {
    "t": 573.1,
    "text": "嗯"
  },
  {
    "t": 574.1,
    "text": "可是這裡的空間太小了"
  },
  {
    "t": 577.1,
    "text": "我連開進去要轉身都很困難耶"
  },
  {
    "t": 581.1,
    "text": "原來山路旁邊除了這塊大石頭"
  },
  {
    "t": 584.1,
    "text": "還堆滿了好多的小碎石"
  },
  {
    "t": 588.1,
    "text": "阿松的身體實在太大了"
  },
  {
    "t": 590.1,
    "text": "他沒有足夠的空間了"
  },
  {
    "t": 592.1,
    "text": "只能在這空間可以安全的轉身"
  },
  {
    "t": 595.1,
    "text": "安全的工作"
  },
  {
    "t": 597.1,
    "text": "這樣該怎麼辦呢"
  },
  {
    "t": 599.1,
    "text": "連阿松都沒有辦法嗎"
  },
  {
    "t": 601.1,
    "text": "嗯"
  },
  {
    "t": 603.1,
    "text": "看來我們需要再想想有什麼方法喔"
  },
  {
    "t": 607.1,
    "text": "大家呢看著被擋住的山路想啊想"
  },
  {
    "t": 611.1,
    "text": "想啊想"
  },
  {
    "t": 613.1,
    "text": "突然東東眼睛一亮說"
  },
  {
    "t": 616.1,
    "text": "阿松我想到辦法了"
  },
  {
    "t": 618.1,
    "text": "你看旁邊是不是有好多的小石頭呢"
  },
  {
    "t": 621.1,
    "text": "喔把他挖起來你就可以把他挖起來"
  },
  {
    "t": 625.1,
    "text": "然後就可以走了"
  },
  {
    "t": 627.1,
    "text": "沒錯"
  },
  {
    "t": 629.1,
    "text": "如果呢先把這些小石頭都清乾淨了"
  },
  {
    "t": 632.1,
    "text": "是不是就可以騰出更多的空間了呢"
  },
  {
    "t": 636.1,
    "text": "阿松呢仔細看了看"
  },
  {
    "t": 639.1,
    "text": "對耶可是旁邊的通道太窄了"
  },
  {
    "t": 643.1,
    "text": "我的身體太大進不去"
  },
  {
    "t": 646.1,
    "text": "交給我吧我來試試看"
  },
  {
    "t": 649.1,
    "text": "嗯"
  },
  {
    "t": 650.1,
    "text": "大家呢在確認安全之後呢東東就開始進去工作了"
  },
  {
    "t": 656.1,
    "text": "東東呢很努力的呢"
  },
  {
    "t": 659.1,
    "text": "花牙挖"
  },
  {
    "t": 661.1,
    "text": "終於他把旁邊的小石頭全部都清乾淨了"
  },
  {
    "t": 665.1,
    "text": "這時候呢旁邊的空間就變得比較大了"
  },
  {
    "t": 670.1,
    "text": "阿松呢可以進去清理大石頭囉"
  },
  {
    "t": 674.1,
    "text": "東東呢退到安全的地方說"
  },
  {
    "t": 677.1,
    "text": "阿松換你上場了啦"
  },
  {
    "t": 679.1,
    "text": "阿松呢慢慢伸出他巨大的挖鬥手臂"
  },
  {
    "t": 685.1,
    "text": "用他大大的挖鬥"
  },
  {
    "t": 687.1,
    "text": "穩穩的呢移到那塊鋸瓷"
  },
  {
    "t": 690.1,
    "text": "嘿咻"
  },
  {
    "t": 693.1,
    "text": "太好了"
  },
  {
    "t": 695.1,
    "text": "大石頭呢終於被移到安全的地方了"
  },
  {
    "t": 698.1,
    "text": "卡車們呢大家都開心的按起來吧"
  },
  {
    "t": 702.1,
    "text": "太棒了道路終於可以重新開放了"
  },
  {
    "t": 706.1,
    "text": "任務結束後呢阿松對東東說"
  },
  {
    "t": 708.1,
    "text": "東東謝謝你今天的幫忙"
  },
  {
    "t": 712.1,
    "text": "像我這樣的大挖土機"
  },
  {
    "t": 715.1,
    "text": "適合在很寬敞的礦山裡面工作"
  },
  {
    "t": 718.1,
    "text": "搬運大石頭"
  },
  {
    "t": 720.1,
    "text": "可是像你這樣的小挖土機"
  },
  {
    "t": 723.1,
    "text": "反而可以在比較窄的地方"
  },
  {
    "t": 725.1,
    "text": "比較小的地方工作"
  },
  {
    "t": 727.1,
    "text": "有些任務反而是你比較適合呢"
  },
  {
    "t": 731.1,
    "text": "東東呢點點頭開心的轉了一圈說"
  },
  {
    "t": 736.1,
    "text": "阿松謝謝你"
  },
  {
    "t": 737.1,
    "text": "阿松謝謝你今天邀請我來參觀"
  },
  {
    "t": 740.1,
    "text": "我學到了好多的東西喔"
  },
  {
    "t": 743.1,
    "text": "這時候呢阿松從旁邊呢"
  },
  {
    "t": 745.1,
    "text": "挑選了一顆漂亮的石頭"
  },
  {
    "t": 747.1,
    "text": "輕輕的放進東東的挖鬥裡面說"
  },
  {
    "t": 751.1,
    "text": "來這個是送給你的小小禮物喔"
  },
  {
    "t": 755.1,
    "text": "東東低頭一看"
  },
  {
    "t": 757.1,
    "text": "是一顆圓溜溜亮晶晶的小石頭"
  },
  {
    "t": 761.1,
    "text": "哇好漂亮喔"
  },
  {
    "t": 763.1,
    "text": "謝謝你阿松"
  },
  {
    "t": 765.1,
    "text": "我要把它帶回車車遊樂園了喔"
  },
  {
    "t": 766.1,
    "text": "把它帶回車車遊樂園"
  },
  {
    "t": 768.1,
    "text": "放在我的工作桌上面"
  },
  {
    "t": 770.1,
    "text": "以後每次看到它"
  },
  {
    "t": 772.1,
    "text": "我就會想起今天"
  },
  {
    "t": 773.1,
    "text": "和阿松一起完成的任務喔"
  },
  {
    "t": 776.1,
    "text": "嗯謝謝你東東"
  },
  {
    "t": 785.1,
    "text": "小朋友今天的故事呢"
  },
  {
    "t": 787.1,
    "text": "跟我們說"
  },
  {
    "t": 788.1,
    "text": "大大的挖土機"
  },
  {
    "t": 789.1,
    "text": "可以一次挖起好多的石頭"
  },
  {
    "t": 792.1,
    "text": "但是呢因為身體很大"
  },
  {
    "t": 794.1,
    "text": "有些窄窄的地方"
  },
  {
    "t": 795.1,
    "text": "反而進不去"
  },
  {
    "t": 797.1,
    "text": "這時候呢"
  },
  {
    "t": 798.1,
    "text": "小挖土機就派上用場囉"
  },
  {
    "t": 801.1,
    "text": "就像平常有些人跑得很快"
  },
  {
    "t": 804.1,
    "text": "有些人很會畫畫"
  },
  {
    "t": 807.1,
    "text": "有些人很會唱歌"
  },
  {
    "t": 810.1,
    "text": "每個人呢"
  },
  {
    "t": 811.1,
    "text": "都有自己擅長的事情喔"
  },
  {
    "t": 813.1,
    "text": "只要發揮自己的強項"
  },
  {
    "t": 815.1,
    "text": "和朋友互相幫忙"
  },
  {
    "t": 817.1,
    "text": "就能完成好多厲害的任務喔"
  },
  {
    "t": 821.1,
    "text": "好囉"
  },
  {
    "t": 822.1,
    "text": "那我們今天的故事就說到這邊囉"
  },
  {
    "t": 824.1,
    "text": "下一次我們再一起來"
  },
  {
    "t": 826.1,
    "text": "車車遊樂園玩吧"
  },
  {
    "t": 829.1,
    "text": "掰掰"
  }
]
