[
  {
    "t": 0,
    "text": "我們一起出發去"
  },
  {
    "t": 4.4,
    "text": "車車遊樂園"
  },
  {
    "t": 8,
    "text": "嗨我是 Bonbon"
  },
  {
    "t": 10.8,
    "text": "我是馬米"
  },
  {
    "t": 12,
    "text": "我們今天要說的故事呢"
  },
  {
    "t": 15.2,
    "text": "是車車遊樂園的笑話比賽"
  },
  {
    "t": 18.8,
    "text": "不嘲笑別人"
  },
  {
    "t": 20.8,
    "text": "那我們就來去說故事吧"
  },
  {
    "t": 23.7,
    "text": "耶"
  },
  {
    "t": 24.5,
    "text": "今天的車車遊樂園好熱鬧哦"
  },
  {
    "t": 31.5,
    "text": "哇"
  },
  {
    "t": 31.9,
    "text": "彩虹廣場前面擠滿了好多的小車車"
  },
  {
    "t": 36,
    "text": "原來是一年一度的車車笑話比賽要開始咯"
  },
  {
    "t": 42.9,
    "text": "耶"
  },
  {
    "t": 43.4,
    "text": "歡迎大家來到車車笑話比賽"
  },
  {
    "t": 53,
    "text": "大家好"
  },
  {
    "t": 54,
    "text": "我叫Bonbon"
  },
  {
    "t": 54.5,
    "text": "我是今天的主持人海歸暖暖"
  },
  {
    "t": 57.5,
    "text": "今天呢"
  },
  {
    "t": 59.5,
    "text": "每位參賽者都要分享一個笑話"
  },
  {
    "t": 62.5,
    "text": "讓大家開心的一起笑哦"
  },
  {
    "t": 65.8,
    "text": "小朋友們"
  },
  {
    "t": 67.7,
    "text": "還有小車車們"
  },
  {
    "t": 69,
    "text": "你們準備好了嗎"
  },
  {
    "t": 71.5,
    "text": "準備好了"
  },
  {
    "t": 74.6,
    "text": "來"
  },
  {
    "t": 76.8,
    "text": "小朋友們跟小車車們"
  },
  {
    "t": 79.1,
    "text": "張大你的嘴巴"
  },
  {
    "t": 81.9,
    "text": "牙齒全部露出來"
  },
  {
    "t": 83.6,
    "text": "噓"
  },
  {
    "t": 84.5,
    "text": "哈哈哈哈大笑三聲"
  },
  {
    "t": 86.5,
    "text": "哈哈哈"
  },
  {
    "t": 90.2,
    "text": "好今天呢獲得最多笑聲的呢就是本屆的冠軍哦"
  },
  {
    "t": 95.9,
    "text": "獎品是老爺爺最好吃的爆米花超大杯"
  },
  {
    "t": 104.7,
    "text": "那我們歡迎第一位是恐龍車多多出場"
  },
  {
    "t": 114.4,
    "text": "多多呢開心的走上舞臺"
  },
  {
    "t": 118.8,
    "text": "開始自我介紹"
  },
  {
    "t": 121.1,
    "text": "阿家好"
  },
  {
    "t": 122.2,
    "text": "我是一號參賽者多多"
  },
  {
    "t": 125,
    "text": "我今天要講的笑話是"
  },
  {
    "t": 128.5,
    "text": "有一天我刷牙刷到睡著了"
  },
  {
    "t": 132.5,
    "text": "噓"
  },
  {
    "t": 138.1,
    "text": "早上起床發現牙刷還在嘴巴里面"
  },
  {
    "t": 143.3,
    "text": "大家都拍手下"
  },
  {
    "t": 144.4,
    "text": "笑了"
  },
  {
    "t": 150.3,
    "text": "好"
  },
  {
    "t": 151.6,
    "text": "第二位出場的是"
  },
  {
    "t": 153.1,
    "text": "蛙土雞東東"
  },
  {
    "t": 157.7,
    "text": "東東有點緊張"
  },
  {
    "t": 161.3,
    "text": "他走到麥克風前"
  },
  {
    "t": 163.6,
    "text": "深深的吸了一口氣"
  },
  {
    "t": 169.3,
    "text": "他說"
  },
  {
    "t": 171,
    "text": "大家好"
  },
  {
    "t": 172.3,
    "text": "我是參賽者"
  },
  {
    "t": 174.4,
    "text": "二號東東"
  },
  {
    "t": 176.9,
    "text": "我今天要講的笑話是"
  },
  {
    "t": 180.3,
    "text": "我昨天挖了一個洞"
  },
  {
    "t": 184.4,
    "text": "小出生們問"
  },
  {
    "t": 185.6,
    "text": "假話呢"
  },
  {
    "t": 187.2,
    "text": "東東很震驚的回答說"
  },
  {
    "t": 189.7,
    "text": "我今天"
  },
  {
    "t": 191.5,
    "text": "找不到那個洞了"
  },
  {
    "t": 198.7,
    "text": "大家笑得東倒西歪"
  },
  {
    "t": 201.3,
    "text": "笑到輪胎都快要滾走了"
  },
  {
    "t": 204.9,
    "text": "好"
  },
  {
    "t": 211.3,
    "text": "來坐起來換三號要出場了"
  },
  {
    "t": 216.1,
    "text": "最後呢輪到噗噗豬出場"
  },
  {
    "t": 219.2,
    "text": "噗噗豬呢最愛搞笑了"
  },
  {
    "t": 223.3,
    "text": "大家好"
  },
  {
    "t": 224.1,
    "text": "我是3號參賽者"
  },
  {
    "t": 226.1,
    "text": "噗噗豬"
  },
  {
    "t": 227.4,
    "text": "最帥的豬"
  },
  {
    "t": 231.7,
    "text": "有了他"
  },
  {
    "t": 233.5,
    "text": "他呢"
  },
  {
    "t": 234.3,
    "text": "到上舞臺"
  },
  {
    "t": 235.3,
    "text": "就學起恐龍車多多平常害怕的樣子"
  },
  {
    "t": 239.9,
    "text": "他把輪胎"
  },
  {
    "t": 241.2,
    "text": "抖啊抖"
  },
  {
    "t": 242.5,
    "text": "還故意縮著身體說"
  },
  {
    "t": 245.3,
    "text": "啊救命啊有泡泡怪"
  },
  {
    "t": 248.4,
    "text": "接著大喊說"
  },
  {
    "t": 249.9,
    "text": "多多是"
  },
  {
    "t": 250.9,
    "text": "車車遊樂園裡面最膽小的恐龍"
  },
  {
    "t": 254,
    "text": "恐龍不是很兇猛嗎"
  },
  {
    "t": 256.1,
    "text": "哪有恐龍會膽小的"
  },
  {
    "t": 258.4,
    "text": "這也太搞笑了吧"
  },
  {
    "t": 260.2,
    "text": "哈哈哈哈"
  },
  {
    "t": 262.5,
    "text": "我有小車車"
  },
  {
    "t": 263.7,
    "text": "一起"
  },
  {
    "t": 264.3,
    "text": "一起看向恐龍多多"
  },
  {
    "t": 266.8,
    "text": "可是"
  },
  {
    "t": 267.8,
    "text": "恐龍多多沒有笑"
  },
  {
    "t": 270.1,
    "text": "多多他低著頭"
  },
  {
    "t": 271.9,
    "text": "小小聲的說"
  },
  {
    "t": 274.2,
    "text": "原來"
  },
  {
    "t": 275,
    "text": "大家都覺得我很膽小"
  },
  {
    "t": 278.9,
    "text": "剛剛很熱鬧的舞臺"
  },
  {
    "t": 280.9,
    "text": "突然變得安安靜靜的"
  },
  {
    "t": 283.7,
    "text": "這時候"
  },
  {
    "t": 284.7,
    "text": "海龜暖暖滑了過來"
  },
  {
    "t": 289.1,
    "text": "他問噗噗豬說"
  },
  {
    "t": 291.4,
    "text": "你有沒有發現"
  },
  {
    "t": 293.2,
    "text": "現場變得"
  },
  {
    "t": 294.5,
    "text": "很安靜呢"
  },
  {
    "t": 297,
    "text": "多多沒有笑"
  },
  {
    "t": 299.9,
    "text": "真正的笑話"
  },
  {
    "t": 301.1,
    "text": "是讓大家一起開心的大笑喔"
  },
  {
    "t": 304.5,
    "text": "不是嘲笑別人"
  },
  {
    "t": 306.3,
    "text": "讓別人難過喔"
  },
  {
    "t": 309.3,
    "text": "噗噗豬看到多多難過的表情"
  },
  {
    "t": 312.4,
    "text": "才知道自己說錯了話"
  },
  {
    "t": 315,
    "text": "他到了多多面前跟多多說"
  },
  {
    "t": 318.3,
    "text": "多多對不起"
  },
  {
    "t": 320.3,
    "text": "我只想"
  },
  {
    "t": 321.9,
    "text": "逗大家笑"
  },
  {
    "t": 322.9,
    "text": "沒想到會害你了"
  },
  {
    "t": 324.4,
    "text": "難過"
  },
  {
    "t": 325.7,
    "text": "多多點點頭說"
  },
  {
    "t": 328.3,
    "text": "沒關係下次我們一起想好笑的笑話"
  },
  {
    "t": 333.1,
    "text": "噗噗豬想了一下"
  },
  {
    "t": 334.9,
    "text": "重新站上舞臺"
  },
  {
    "t": 338.8,
    "text": "這一次他沒有模仿任何人"
  },
  {
    "t": 341.6,
    "text": "他笑著說"
  },
  {
    "t": 343.9,
    "text": "有一天我在泡澡"
  },
  {
    "t": 346.5,
    "text": "看到了好多好多的泡泡"
  },
  {
    "t": 353.1,
    "text": "小車車們問"
  },
  {
    "t": 354.3,
    "text": "為什麼呢"
  },
  {
    "t": 357,
    "text": "噗噗豬"
  },
  {
    "t": 358,
    "text": "偷偷笑了一下"
  },
  {
    "t": 361.1,
    "text": "噗噗豬呢"
  },
  {
    "t": 362.1,
    "text": "左看看"
  },
  {
    "t": 363.4,
    "text": "右看看的說"
  },
  {
    "t": 365.1,
    "text": "你們真的想要知道嗎"
  },
  {
    "t": 368.5,
    "text": "想"
  },
  {
    "t": 370.5,
    "text": "因為"
  },
  {
    "t": 372.3,
    "text": "我的屁股"
  },
  {
    "t": 374.1,
    "text": "一直"
  },
  {
    "t": 375.4,
    "text": "噗噗噗噗噗"
  },
  {
    "t": 377.9,
    "text": "一直在放屁啦"
  },
  {
    "t": 384.3,
    "text": "現在呢所有的小車車們都笑囉"
  },
  {
    "t": 387.9,
    "text": "恐龍車多多也笑了"
  },
  {
    "t": 390.2,
    "text": "海龜老師拍拍手說"
  },
  {
    "t": 393.6,
    "text": "大家一起笑"
  },
  {
    "t": 394.9,
    "text": "才是最開心的笑喔"
  },
  {
    "t": 397.2,
    "text": "好囉"
  },
  {
    "t": 397.9,
    "text": "比賽結束了"
  },
  {
    "t": 399.2,
    "text": "那我們要來宣佈今天的冠軍是"
  },
  {
    "t": 403.8,
    "text": "挖土雞東東"
  },
  {
    "t": 406.6,
    "text": "大家給他拍拍手"
  },
  {
    "t": 412,
    "text": "東東呢又驚又醒"
  },
  {
    "t": 414.1,
    "text": "三位好朋友"
  },
  {
    "t": 415.3,
    "text": "挖土雞東東"
  },
  {
    "t": 416.9,
    "text": "恐龍車多多"
  },
  {
    "t": 418.4,
    "text": "噗噗豬"
  },
  {
    "t": 419.4,
    "text": "一起站上舞臺"
  },
  {
    "t": 421.2,
    "text": "開心的拍了一張大合照"
  },
  {
    "t": 424,
    "text": "挖土雞東東拿了最大杯的爆米花"
  },
  {
    "t": 428.7,
    "text": "開心的不得了"
  },
  {
    "t": 430.7,
    "text": "這時候呢天空飄起了彩色的泡泡"
  },
  {
    "t": 435.3,
    "text": "整個車車遊樂園充滿了笑聲"
  },
  {
    "t": 440.7,
    "text": "今天是快樂的一天"
  },
  {
    "t": 444.3,
    "text": "小朋友"
  },
  {
    "t": 452,
    "text": "今天的故事呢是告訴我們"
  },
  {
    "t": 454.8,
    "text": "說笑話是要讓大家一起開心"
  },
  {
    "t": 458.4,
    "text": "不是要拿別人的害怕或是外表來開玩笑喔"
  },
  {
    "t": 464.8,
    "text": "如果被笑的人沒有笑"
  },
  {
    "t": 467.1,
    "text": "還覺得很難過"
  },
  {
    "t": 468.6,
    "text": "那就不是一個真正的笑話了"
  },
  {
    "t": 472.2,
    "text": "下一次呢想要講笑話的"
  },
  {
    "t": 474.2,
    "text": "的時候我們可以先想一想"
  },
  {
    "t": 476.8,
    "text": "如果今天被笑的人是我"
  },
  {
    "t": 479.6,
    "text": "我會有什麼感覺呢"
  },
  {
    "t": 481.9,
    "text": "不舒服的感覺"
  },
  {
    "t": 484.2,
    "text": "對會有不舒服的感覺喔"
  },
  {
    "t": 487.3,
    "text": "會很難過"
  },
  {
    "t": 489.3,
    "text": "那我們呢要一起做一個"
  },
  {
    "t": 492.4,
    "text": "會讓大家一起笑"
  },
  {
    "t": 494.5,
    "text": "一起快樂的小朋友好嗎"
  },
  {
    "t": 497,
    "text": "好"
  },
  {
    "t": 499.1,
    "text": "好囉今天的故事就說到這邊囉"
  },
  {
    "t": 502.4,
    "text": "下一次"
  },
  {
    "t": 503.2,
    "text": "我們在一起"
  },
  {
    "t": 504.1,
    "text": "一起來車車遊樂園玩吧"
  },
  {
    "t": 507,
    "text": "拜拜"
  }
]
