[{"t":60,"text":"新的車車遊樂園要舉辦一場消防演練"},{"t":63.8,"text":"有好多的小車車都在廣場準備著"},{"t":67.9,"text":"廣場角落還飄出濃濃的爆米花香味"},{"t":72.6,"text":"原來是一臺老爺爺爆米花餐車"},{"t":76.6,"text":"正在做好吃的爆米花"},{"t":79.2,"text":"準備等一下大家消防演練完畢後要分送給大家哦"},{"t":90,"text":"Bonbon：欸欸欸，真好吃的爆米花"},{"t":93,"text":"爆米花好香好香啊"},{"t":96.2,"text":"可是在廣場的另外一邊"},{"t":99.3,"text":"卻傳出了吵架的聲音"},{"t":102.4,"text":"我才不要跟你一起來"},{"t":106.8,"text":"哼 我也不想跟你一起啊"},{"t":109.7,"text":"要不是媽媽已經報名了"},{"t":111.8,"text":"消防演練我也不想跟你一起"},{"t":114,"text":"原來他們是一對雙胞胎消防車"},{"t":119.1,"text":"哥哥呢"},{"t":120,"text":"叫做圈圈"},{"t":120.9,"text":"弟弟叫點點"},{"t":122.8,"text":"他們呢"},{"t":124.3,"text":"長得一模一樣"},{"t":125.9,"text":"都是亮紅色的小小消防車"},{"t":129.1,"text":"有大大的水箱"},{"t":131,"text":"長長的水管"},{"t":132.8,"text":"還有閃閃發亮的警示燈"},{"t":136.6,"text":"可是圈圈心裡一直不太開心"},{"t":139.8,"text":"因為以前大家都說"},{"t":143.7,"text":"圈圈好厲害哦"},{"t":145.7,"text":"他是最棒的小小消防員"},{"t":148.1,"text":"自從呢"},{"t":150,"text":"點點出現了以後"},{"t":151.8,"text":"大家呢常常說"},{"t":153.8,"text":"哇 你們兩個都很厲害耶"},{"t":156.8,"text":"都好帥哦"},{"t":158.1,"text":"圈圈聽了心裡酸酸的"},{"t":161.4,"text":"他心想"},{"t":162.7,"text":"是不是有弟弟在"},{"t":164.8,"text":"我就不特別了"},{"t":166.4,"text":"所以圈圈什麼都想要跟點點比"},{"t":170.1,"text":"圈圈說"},{"t":172.1,"text":"我的水柱一定噴得比較遠"},{"t":174.6,"text":"點點呢也不服氣的說"},{"t":177.6,"text":"才不是呢"},{"t":179.3,"text":"我的水柱一定噴得比較遠"},{"t":180,"text":"我的水管更有力氣"},{"t":182.3,"text":"他們呢"},{"t":183.1,"text":"一下子比誰的鳴笛聲比較響"},{"t":189.6,"text":"一下又比誰的輪胎跑得比較快"},{"t":194.6,"text":"就連停車位也要搶同一個"},{"t":198.9,"text":"鈴鈴清潔車在旁邊看見了"},{"t":201.5,"text":"溫柔的說"},{"t":203.2,"text":"圈圈 點點"},{"t":205.5,"text":"你們都是很棒的消防車"},{"t":208.2,"text":"兄弟不一定要比誰比較厲害"},{"t":209.8,"text":"也可以一起完成任務哦"},{"t":214.2,"text":"圈圈呢低著頭悶悶的說"},{"t":217.2,"text":"可是我就是不想要被比下去啊"},{"t":222.1,"text":"鈴鈴說"},{"t":223.7,"text":"有弟弟，不代表你就不再厲害了，也不代表你不重要"},{"t":228,"text":"你還是你"},{"t":229.8,"text":"點點是點點"},{"t":231.3,"text":"你們在一起就會有新的力量哦"},{"t":235.2,"text":"就在這個時候"},{"t":239.7,"text":"老爺爺爆米花餐車突然冒出了黑煙"},{"t":242.2,"text":"老爺爺嚇了一大跳大聲的喊"},{"t":245.6,"text":"哎喲喂呀"},{"t":247.4,"text":"不好了不好了"},{"t":249,"text":"我的爆米花餐車過熱了"},{"t":252,"text":"冒煙了"},{"t":253.2,"text":"誰可以來幫幫我"},{"t":255.5,"text":"黑煙呢越來越多"},{"t":258.6,"text":"火苗呢也慢慢冒了出來"},{"t":261.5,"text":"圈圈跟點點看到了火苗"},{"t":264.2,"text":"心裡呢都噗通噗通的跳著"},{"t":267,"text":"圈圈說"},{"t":269.5,"text":"點點這次是真的失火了"},{"t":272.3,"text":"點點呢也害怕的說"},{"t":274.9,"text":"哥我們真的可以幫得上忙嗎"},{"t":278.2,"text":"圈圈呢看著弟弟"},{"t":281,"text":"突然發現"},{"t":282.3,"text":"點點不是想要搶走他的厲害"},{"t":284.6,"text":"點點也很害怕"},{"t":286.4,"text":"他也是需要哥哥的幫忙哦"},{"t":288.7,"text":"這時候呢圈圈深深的吸了一口氣"},{"t":293.6,"text":"亮起了警示燈說"},{"t":297.7,"text":"點點我們一起來"},{"t":299.4,"text":"這時候呢，點點用力地點了點頭"},{"t":302.7,"text":"兩臺小小消防車呢就開到了"},{"t":306,"text":"老爺爺爆米花餐車前方的位置"},{"t":311.1,"text":"準備救援"},{"t":314.2,"text":"圈圈呢噴出了第一道水柱"},{"t":318,"text":"點點噴出了第二道水柱"},{"t":321.9,"text":"可是火苗躲在老爺爺爆米花餐車的下面"},{"t":325.7,"text":"圈圈的水柱太偏左邊了"},{"t":329.2,"text":"點點的水柱太偏右邊了"},{"t":332.3,"text":"所以呢兩道水柱都沒有噴到火苗下面"},{"t":336.1,"text":"這時候呢"},{"t":338.9,"text":"圈圈呢深呼吸後冷靜的想了想"},{"t":343,"text":"大聲的說"},{"t":345.1,"text":"點點我們不要各噴各的"},{"t":347.9,"text":"我數到三"},{"t":349.2,"text":"我們一起對準火苗下面"},{"t":351.2,"text":"點點說好我聽你的"},{"t":354,"text":"圈圈喊"},{"t":356.3,"text":"一二三"},{"t":359.2,"text":"這一次兩道水柱在空中合併在一起"},{"t":364.6,"text":"變成一道又大又猛的"},{"t":366.9,"text":"雙胞胎龍捲大水"},{"t":370.7,"text":"哇"},{"t":373.3,"text":"火被熄滅了"},{"t":376.4,"text":"老爺爺感動地說"},{"t":379.9,"text":"哦太好了"},{"t":382,"text":"謝謝你們"},{"t":383.5,"text":"你們兩兄弟合作起來"},{"t":386.1,"text":"真的好厲害喔"},{"t":389.2,"text":"圈圈呢看著點點很感動的說"},{"t":392.5,"text":"謝謝點點跟我一起瞄準火苗"},{"t":396.4,"text":"點點說"},{"t":397.6,"text":"是哥哥先想到辦法的"},{"t":400.5,"text":"這時候呢，在一旁的鈴鈴清潔車也開了過來"},{"t":405.1,"text":"鈴鈴說"},{"t":406.4,"text":"你們看你們兩個合作後就變得更強大更有力量了"},{"t":412.5,"text":"圈圈跟點點看著對方"},{"t":415.3,"text":"點了點頭"},{"t":416.8,"text":"一起大笑了起來"},{"t":419.2,"text":"從那天起"},{"t":422.5,"text":"圈圈和點點"},{"t":424.6,"text":"常常一起練習"},{"t":427.1,"text":"一二三"},{"t":429.4,"text":"雙胞胎大龍捲水發射"},{"t":439.9,"text":"小朋友"},{"t":441,"text":"你在家裡有沒有遇過你的哥哥"},{"t":444,"text":"姐姐"},{"t":445.1,"text":"或是弟弟妹妹"},{"t":446.8,"text":"會跟你吵架呢？"},{"t":449.2,"text":"有時候是在搶同一個玩具"},{"t":452.8,"text":"你可能會覺得說"},{"t":454.8,"text":"我才不要跟他一起玩呢"},{"t":458.4,"text":"下一次當你們快要吵起來的時候"},{"t":461.5,"text":"可以試著練習說看看"},{"t":463.5,"text":"我們要不要一起來玩"},{"t":466.4,"text":"一起合作"},{"t":468.1,"text":"也許你會發現"},{"t":469.9,"text":"一起玩"},{"t":471,"text":"一起合作後"},{"t":472.2,"text":"變得更好玩"},{"t":473.8,"text":"變得更有趣囉"},{"t":476.6,"text":"就算有了弟弟妹妹"},{"t":478.4,"text":"爸爸媽媽"},{"t":479.2,"text":"對哥哥姐姐的愛也不會變少喔"},{"t":483,"text":"你"},{"t":484,"text":"還是一樣很重要"},{"t":486.1,"text":"只是家裡多了一個"},{"t":488.4,"text":"可以一起玩"},{"t":489.9,"text":"一起想辦法"},{"t":491.7,"text":"一起長大的隊友喔"},{"t":495.3,"text":"好咯"},{"t":496.1,"text":"我們今天的故事就說到這邊咯"},{"t":499.9,"text":"謝謝大家歡迎收聽"},{"t":502.2,"text":"如果超好聽的話"},{"t":504.2,"text":"可以訂閱我們的頻道喔"},{"t":506.8,"text":"五星好評論"},{"t":509.1,"text":"記得要留言給我們喔"},{"t":513.2,"text":"我們下禮拜再講"},{"t":514.8,"text":"超級車的故事吧"},{"t":517.1,"text":"拜拜"}]
