[{"t":30,"text":"還可以尋摸"},{"t":31.5,"text":"尋摸 還有呢"},{"t":33.4,"text":"抓小偷"},{"t":36.1,"text":"抓壞蛋"},{"t":38.7,"text":"好"},{"t":39.7,"text":"或是車禍的時候他也會去"},{"t":42.2,"text":"車禍的時候他也會幫忙"},{"t":45.4,"text":"有一些人迷路了他們也會幫忙"},{"t":49.9,"text":"有些人迷路找不到家他們也可以幫忙"},{"t":53.3,"text":"所以警察叔叔跟阿姨他們是不是做了好多好多事情"},{"t":60,"text":"今天呢是6月15日警察節"},{"t":64.8,"text":"車車遊樂園裡面呢掛滿了好多的感謝卡片"},{"t":69.4,"text":"大家都想要謝謝呢守護安全的警察叔叔跟警察阿姨"},{"t":75.8,"text":"還有遊樂園裡面的警車亮亮"},{"t":80,"text":"亮亮呢是一臺深藍色與白色的警車"},{"t":84.8,"text":"頭頂呢有閃亮亮的紅藍警示燈"},{"t":88.6,"text":"遇到呢"},{"t":90,"text":"緊急的事件時他總是呢會穩穩的說"},{"t":93.9,"text":"別怕安全最重要"},{"t":96.8,"text":"就在這個時候"},{"t":98.7,"text":"遊樂園裡傳來緊急的聲音"},{"t":102.1,"text":"小藍巴是說亮亮亮亮請你幫幫忙"},{"t":106.3,"text":"我車上有一個媽媽快要生小寶寶了"},{"t":109.2,"text":"他肚子痛痛的看起來很不舒服"},{"t":112.1,"text":"需要趕快送他去醫院"},{"t":114.1,"text":"媽媽的呼吸很急促"},{"t":116.2,"text":"肚子裡的小寶寶好像等不及要出來了耶"},{"t":119.9,"text":"亮亮說快叫救護車"},{"t":123.8,"text":"小藍巴是說可是救護車剛剛去救援另外一位受傷的小朋友了"},{"t":130.2,"text":"現在不在現場"},{"t":131.9,"text":"大家一聽更緊張了"},{"t":134.3,"text":"小紅賽車呢馬上說"},{"t":136.6,"text":"我開最快我帶他們衝去醫院"},{"t":139.4,"text":"這時候呢亮亮呢警車擋在前面"},{"t":143,"text":"語氣很堅定的說"},{"t":145,"text":"小紅不可以亂衝"},{"t":147.1,"text":"越緊張的時候呢越要冷靜"},{"t":149.9,"text":"我可以幫他們開刀"},{"t":151.7,"text":"讓他們安全的到醫院"},{"t":154,"text":"亮亮呢對小藍巴士說"},{"t":156.5,"text":"請你跟在我後面"},{"t":158.1,"text":"不要超車"},{"t":159.4,"text":"不要突然轉彎"},{"t":161.4,"text":"小藍巴士呢用力點點頭說"},{"t":164,"text":"好的我會更好的"},{"t":166.8,"text":"亮亮呢又對媽媽說"},{"t":169.3,"text":"媽媽請你放心"},{"t":171.4,"text":"請你呢現在深呼吸"},{"t":174.7,"text":"吐氣"},{"t":176,"text":"抓緊車上的手把"},{"t":178,"text":"請放心我們呢"},{"t":179.8,"text":"一起陪你平安到醫院的"},{"t":182.4,"text":"媽媽呢很感動的說"},{"t":185,"text":"謝謝你們的幫忙"},{"t":187,"text":"這時候呢警示燈開啟"},{"t":189.3,"text":"準備出發囉"},{"t":192.9,"text":"警車亮亮呢開在最前方"},{"t":195.7,"text":"小藍巴士呢開在後方"},{"t":198.5,"text":"小紅賽車呢則是留在這個遊樂園的門口幫忙指揮"},{"t":204.2,"text":"到了大路口前面有好多好多車喔"},{"t":208,"text":"亮亮呢他開啟他的"},{"t":209.8,"text":"迴音提醒大家"},{"t":213.1,"text":"現在呢"},{"t":214.4,"text":"有人需要緊急的幫助"},{"t":216.7,"text":"請大家車子呢往旁邊靠"},{"t":219.3,"text":"讓出安全的路"},{"t":221.8,"text":"這時候大家都聽見了"},{"t":223.9,"text":"慢慢的呢把車開到了旁邊"},{"t":226.4,"text":"讓出了一條路"},{"t":228.7,"text":"亮亮呢一邊開"},{"t":230.8,"text":"一邊注意每個紅綠燈"},{"t":233.1,"text":"行人還有每個轉角"},{"t":236.2,"text":"終於醫院到了"},{"t":239.8,"text":"醫院門口的"},{"t":240.8,"text":"醫生還有護理師已經準備好囉"},{"t":243.9,"text":"他們呢對著媽媽說"},{"t":245.6,"text":"媽媽我們來幫你了"},{"t":248.2,"text":"這時候呢小藍巴士鬆了一大口氣"},{"t":251.8,"text":"亮亮謝謝你帶我們快速安全的抵達醫院"},{"t":257.2,"text":"亮亮說"},{"t":258.4,"text":"不用客氣"},{"t":259.5,"text":"守護大家的安全就是我的任務"},{"t":263.1,"text":"過了一會兒"},{"t":264.1,"text":"醫院呢傳來了好訊息"},{"t":266.6,"text":"小寶寶平安出生了"},{"t":269.5,"text":"他是一個長得超級可愛的小baby"},{"t":272.3,"text":"哭聲好洪亮喔"},{"t":275.9,"text":"大家呢都開心的笑"},{"t":283.3,"text":"今天的車車小任務是不是好有意義呢"},{"t":286.6,"text":"對"},{"t":287.1,"text":"萌萌之後如果你遇到警車"},{"t":290.2,"text":"救護車消防車在執行任務時要怎麼辦呢"},{"t":294.8,"text":"讓開"},{"t":296.3,"text":"好的很棒"},{"t":297.9,"text":"我們要記得喔"},{"t":299.4,"text":"停在安全的地方把路讓出來喔"},{"t":302.7,"text":"因為你的讓路也是一種幫忙喔"},{"t":306.1,"text":"今天的警察節呢"},{"t":307.9,"text":"讓我們對這個辛苦的"},{"t":309.9,"text":"警察叔叔"},{"t":311.2,"text":"還有警察阿姨說一聲"},{"t":313.5,"text":"謝謝你們"},{"t":315.5,"text":"祝你們平平安安"},{"t":317.6,"text":"健健剛剛喔"},{"t":319.4,"text":"好"},{"t":319.9,"text":"那我們下一次再一起來車車遊樂園出任務吧"},{"t":325.5,"text":"拜拜"}]
