[{"t":60,"text":"今天我們就要來講如何打敗這個髒髒小怪獸"},{"t":64.8,"text":"那我們就開始來說故事咯"},{"t":68.4,"text":"今天的車車遊樂園好熱鬧啊"},{"t":73.7,"text":"恐龍車多多 還有其他好多的小車車們"},{"t":78.6,"text":"都在彩虹廣場準備吃點心"},{"t":82.1,"text":"桌上有香香的飯糰"},{"t":85.2,"text":"甜甜的水果"},{"t":88.1,"text":"還有冰冰涼涼"},{"t":90,"text":"超好喝的果汁"},{"t":91.2,"text":"就在這個時候"},{"t":93.6,"text":"傳來噗嗤噗嗤的聲音"},{"t":98.4,"text":"一臺白色的小貨車開了過來"},{"t":103.4,"text":"它的車身上有一個大大的噴霧桶"},{"t":107.9,"text":"車身亮晶晶的"},{"t":110,"text":"哦 原來它是消毒車噴噴"},{"t":114.2,"text":"噴噴呢 一邊開 一邊得意的說"},{"t":118.9,"text":"讓開 讓開"},{"t":120,"text":"讓開 我是最厲害的消毒車"},{"t":123.7,"text":"我的車上放著最強的酒精"},{"t":126.2,"text":"只要我噴一噴"},{"t":129.2,"text":"什麼細菌病毒 髒髒小怪獸"},{"t":132.6,"text":"通通都被我嚇得跑光光了"},{"t":135.1,"text":"說完，它就對著桌子旁邊噴了幾下"},{"t":142.7,"text":"恐龍車多多睜大眼睛說"},{"t":145.5,"text":"哇 噴噴 你好厲害哦"},{"t":148.5,"text":"那我們是不是現在可以過來吃點心了呢"},{"t":150,"text":"還是可以不用洗手就吃呢"},{"t":153.6,"text":"噴噴一聽 立刻抬起頭說"},{"t":156.8,"text":"當然可以啊 有我在"},{"t":159.3,"text":"什麼髒髒小怪獸都不用怕"},{"t":162.7,"text":"小車車們聽了正準備拿起點心"},{"t":167.1,"text":"突然 桌子旁邊傳來奇怪的聲音"},{"t":171.6,"text":"嘿嘿嘿 我們在這裡喲"},{"t":177.7,"text":"大家嚇了一大跳"},{"t":179.9,"text":"一群灰灰黑黑的髒髒小怪獸"},{"t":183,"text":"躲在恐龍車多多的輪胎縫縫裡"},{"t":186.6,"text":"挖土機咚咚鏟子的旁邊"},{"t":189.7,"text":"還有小紅賽車的車門把手上"},{"t":194.8,"text":"噴噴不相信的說"},{"t":197.4,"text":"不可能 我剛剛明明噴過了"},{"t":200.8,"text":"髒髒小怪獸們扭來扭去"},{"t":204,"text":"笑嘻嘻的說"},{"t":205.6,"text":"嘿嘿，我們可是很厲害會傳染的病毒"},{"t":209.9,"text":"你們以為隨便噴兩下"},{"t":212,"text":"就可以把我們趕走嗎"},{"t":214.4,"text":"嘿嘿嘿 你們想太多了"},{"t":218.5,"text":"我們最喜歡躲在被摸過的玩具"},{"t":222.4,"text":"被摸過的地板"},{"t":224.5,"text":"還有上完廁所後的門把"},{"t":227.9,"text":"嘿嘿嘿，還有小朋友挖完鼻屎的小手手上面喔"},{"t":235,"text":"我們最喜歡躲在這邊了"},{"t":239.9,"text":"噴噴一聽"},{"t":241.9,"text":"整個臉都脹紅了"},{"t":243.9,"text":"噴噴急得大叫"},{"t":245.4,"text":"怎麼會這樣"},{"t":246.4,"text":"我的酒精不是很厲害嗎"},{"t":248.7,"text":"這時候"},{"t":250.3,"text":"玲玲清潔車開了過來"},{"t":252.7,"text":"溫柔的說"},{"t":253.9,"text":"噴噴"},{"t":255.2,"text":"你的酒精消毒很厲害"},{"t":257.7,"text":"可以幫忙消毒桌子"},{"t":259.9,"text":"玩具"},{"t":260.8,"text":"可是有些髒髒的小怪獸"},{"t":263.8,"text":"會躲在手心"},{"t":265.3,"text":"手背跟指縫裡面"},{"t":268.1,"text":"只靠噴一噴"},{"t":269.9,"text":"不一定能趕走他們"},{"t":271.8,"text":"那我們要怎麼辦"},{"t":274.5,"text":"玲玲清潔車說"},{"t":276.5,"text":"大家跟我一起來吧"},{"t":278.5,"text":"我們一起開到洗手檯旁邊"},{"t":283.3,"text":"要用肥皂和清水"},{"t":285.4,"text":"好好地洗手"},{"t":288.7,"text":"首先"},{"t":289.5,"text":"我們先把我們的小手手沾濕"},{"t":292.7,"text":"再用肥皂搓20秒鐘"},{"t":296.4,"text":"你可以數數哦"},{"t":297.9,"text":"一到二十"},{"t":299.9,"text":"一二三地數，一直數到二十"},{"t":305.4,"text":"也可以唱一首你喜歡的歌哦"},{"t":309.5,"text":"唱完這首歌"},{"t":321.4,"text":"我們在沖水的時候就可以把這些髒髒的小怪獸沖掉咯"},{"t":326.1,"text":"哎呀 太滑了"},{"t":329.1,"text":"我們站不住了"},{"t":330.6,"text":"哎呀 哎呀 趕快逃啊"},{"t":333.1,"text":"稀里嘩啦的水聲"},{"t":335.6,"text":"髒髒小怪獸全部都跟著水沖走了"},{"t":340.3,"text":"大家的手手都變得乾乾淨淨的咯"},{"t":344,"text":"小車車們終於可以安心地吃點心了"},{"t":349,"text":"這時候噴噴低下頭"},{"t":352.3,"text":"小小聲的說"},{"t":354.2,"text":"原來我的酒精"},{"t":356.4,"text":"沒辦法打敗所有的髒髒小怪獸"},{"t":358.4,"text":"遇到這些很壞"},{"t":362.4,"text":"很會躲起來的髒髒小怪獸"},{"t":365,"text":"要用肥皂洗手才能真正把他們趕走"},{"t":369.2,"text":"玲玲清潔車說"},{"t":371.4,"text":"是的，噴噴"},{"t":373,"text":"你還是可以用酒精幫忙消毒桌子門把跟玩具"},{"t":378.4,"text":"我可以提醒大家用肥皂洗手"},{"t":381.6,"text":"我們可以一起合作"},{"t":383.4,"text":"讓車車遊樂園變得更乾淨哦"},{"t":386.4,"text":"噴噴呢開心地點點頭"},{"t":389.5,"text":"從那一天開始"},{"t":391.5,"text":"車車遊樂園有了一個新的規則咯"},{"t":394.8,"text":"吃東西前要洗手"},{"t":399.2,"text":"上完廁所要洗手"},{"t":402.5,"text":"玩完玩具也要洗手"},{"t":406.2,"text":"打完噴嚏咳嗽"},{"t":408.4,"text":"擦完鼻涕也記得要洗手哦"},{"t":416.4,"text":"小朋友今天的故事呢是要告訴大家"},{"t":422.2,"text":"有時候我們在外面找不到洗手檯的時候"},{"t":426.2,"text":"可以先用酒精幫忙消毒你的小手"},{"t":429.3,"text":"可是酒精不是萬能的哦"},{"t":432.6,"text":"最重要的是"},{"t":434.5,"text":"還是要用肥皂和清水"},{"t":437.3,"text":"把小手認真地搓一搓"},{"t":439.7,"text":"洗一洗"},{"t":440.7,"text":"在洗的時候"},{"t":442.2,"text":"記得要數數，從一數到二十哦"},{"t":446.4,"text":"如果你還不會數數"},{"t":447.9,"text":"可以唱一首你最喜歡的歌"},{"t":450.7,"text":"把這首歌唱完"},{"t":453.5,"text":"泡泡衝乾淨"},{"t":454.9,"text":"小手擦乾淨"},{"t":456.4,"text":"我們的洗手任務就完成咯"},{"t":459.3,"text":"好咯"},{"t":460.8,"text":"那我們今天的故事就說到這邊咯"},{"t":464.4,"text":"下一次再一起來車車遊樂園玩吧"},{"t":469.2,"text":"拜拜"}]
