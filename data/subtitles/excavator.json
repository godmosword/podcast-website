[{"t":0,"text":"我們一起出發去"},{"t":2,"text":"戳戳遊園"},{"t":7,"text":"嗨 我是bombo"},{"t":9,"text":"我是Mami"},{"t":11,"text":"今天的主角是一台黃色的小蛙土雞"},{"t":18,"text":"她的名字叫什麼呀"},{"t":20,"text":"東東"},{"t":21,"text":"對 她的名字叫東東"},{"t":24,"text":"她的名字叫東東"},{"t":26,"text":"東東"},{"t":29,"text":"東東有一個很大的什麼東西"},{"t":32,"text":"大鏟子"},{"t":33,"text":"對 她有一個大鏟子"},{"t":35,"text":"看起來很厲害喔"},{"t":37,"text":"但其實她有一點膽小"},{"t":40,"text":"她不敢開上斜坡"},{"t":42,"text":"因為她怕會滑下來"},{"t":44,"text":"也不敢推大石頭"},{"t":46,"text":"怕她的鏟子被壓壞了"},{"t":49,"text":"有一天車車遊樂園的花園小路"},{"t":52,"text":"因為大雨後"},{"t":54,"text":"被泥巴和石頭擋住了"},{"t":58,"text":"小花朵呢 被壓得滴滴的"},{"t":61,"text":"小花朵好像在說什麼啊"},{"t":64,"text":"誰可以來幫幫我"},{"t":69,"text":"東東看見了 心裡想著"},{"t":72,"text":"我是蛙土雞"},{"t":74,"text":"我應該可以幫忙"},{"t":76,"text":"這時候呢 吊車老爺爺呢"},{"t":78,"text":"開了過來"},{"t":80,"text":"吊車老爺爺問"},{"t":82,"text":"東東 你怎麼停在這裡"},{"t":86,"text":"東東呢 低著頭說"},{"t":88,"text":"我想幫忙"},{"t":90,"text":"可是我怕斜坡"},{"t":92,"text":"也怕石頭"},{"t":93,"text":"我是不是不夠勇敢"},{"t":96,"text":"吊車老爺爺說"},{"t":99,"text":"勇敢不是完全不害怕喔"},{"t":103,"text":"勇敢呢 是心裡有點害怕"},{"t":106,"text":"還是願意去試看看喔"},{"t":110,"text":"東東呢 眨眨眼睛"},{"t":113,"text":"想著說 可是我還是怕怕的"},{"t":117,"text":"吊車老爺爺說"},{"t":119,"text":"沒關係"},{"t":121,"text":"不用一次完成全部"},{"t":124,"text":"你只要呢 千種一小步"},{"t":128,"text":"東東呢 點點頭"},{"t":130,"text":"他來到了小斜坡前面"},{"t":132,"text":"輪子呢 有一點發抖"},{"t":135,"text":"吊車老爺爺在後面說"},{"t":138,"text":"來 先深呼吸"},{"t":142,"text":"輪胎呢 才穩"},{"t":146,"text":"慢慢來"},{"t":148,"text":"這時候呢 東東吸了一口氣"},{"t":151,"text":"他呢 一點一點的往上開"},{"t":155,"text":"東東成功開上去了"},{"t":159,"text":"東東開心的說"},{"t":161,"text":"我做到了"},{"t":162,"text":"接著呢 他又看到了一顆大石頭"},{"t":164,"text":"擋在路的中間"},{"t":166,"text":"東東呢 又緊張的想著說"},{"t":169,"text":"我推得動嗎"},{"t":171,"text":"老爺爺呢 看到就說"},{"t":174,"text":"來 先輕輕的推推看"},{"t":178,"text":"東東呢 放下了挖土鏟子"},{"t":181,"text":"輕輕的一推 石頭沒有動"},{"t":184,"text":"他呢 有點失望"},{"t":186,"text":"吊車老爺爺說"},{"t":188,"text":"沒關係"},{"t":190,"text":"我們換個方向再試一次看看"},{"t":194,"text":"東東呢 換的角度"},{"t":197,"text":"再用力一點"},{"t":199,"text":"石頭慢慢滾到旁邊"},{"t":202,"text":"不通了"},{"t":205,"text":"最後呢 東東來到了花圃前面"},{"t":208,"text":"前面呢 好多的泥巴喔"},{"t":211,"text":"他又開始緊張了起來"},{"t":214,"text":"心裡呢 普通普通的跳著"},{"t":217,"text":"這時候呢 吊車老爺爺說"},{"t":220,"text":"還記得嗎 先做一小步"},{"t":224,"text":"東東點點頭說"},{"t":226,"text":"好 我呢 會先挖第一鏟"},{"t":230,"text":"第二鏟 第三鏟"},{"t":233,"text":"東東呢 慢慢的把泥巴清開了"},{"t":237,"text":"小鹿呢 露了出來"},{"t":240,"text":"小花呢 也暫時了"},{"t":242,"text":"好像呢 在對這個 大家說"},{"t":245,"text":"謝謝你們"},{"t":247,"text":"幫我把這個泥巴都清好了"},{"t":251,"text":"東東呢 笑了笑"},{"t":253,"text":"我真的完成了"},{"t":255,"text":"吊車老爺爺說"},{"t":257,"text":"東東 你今天有找到勇氣喔"},{"t":262,"text":"東東說 勇氣在哪裡"},{"t":267,"text":"吊車老爺爺說"},{"t":269,"text":"就在你心裡啊"},{"t":272,"text":"你害怕 但你卻願意嘗試一小步"},{"t":276,"text":"這個就是勇氣喔"},{"t":279,"text":"東東呢 摸摸自己的胸口"},{"t":282,"text":"原來呢 勇敢不是不害怕"},{"t":284,"text":"是你在害怕的時候"},{"t":286,"text":"也願意去試試看喔"},{"t":289,"text":"小朋友 下次呢"},{"t":291,"text":"你遇到害怕的事情的時候"},{"t":293,"text":"也可以像東東一樣喔"},{"t":295,"text":"先深呼吸 慢慢的試一小步看看喔"},{"t":300,"text":"那我們今天的故事呢"},{"t":303,"text":"就分享到這邊啦"},{"t":305,"text":"我們下次再一起來"},{"t":307,"text":"吊車遊樂園玩吧"},{"t":309,"text":"掰掰"}]
