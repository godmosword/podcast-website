[{"t":0,"text":"我們一起出發去"},{"t":4.5,"text":"嗨 我是 Bonbon"},{"t":10.9,"text":"我是馬米"},{"t":12,"text":"蹦蹦你最近是不是有掉牙"},{"t":15.3,"text":"那你要不要分享一下"},{"t":17.4,"text":"你掉牙是什麼感覺呢"},{"t":19.6,"text":"掉牙是"},{"t":22.1,"text":"就是有點流血的感覺"},{"t":25.9,"text":"有流血的感覺"},{"t":27,"text":"那會不舒服嗎"},{"t":29.2,"text":"有點痛辣的"},{"t":31.1,"text":"會有點痛痛的"},{"t":33.8,"text":"在掉之前就有痛痛的感覺"},{"t":36.6,"text":"對啊"},{"t":38.1,"text":"那牙齒會怎麼樣"},{"t":39.9,"text":"牙齒會搖搖晃晃"},{"t":41.7,"text":"超晃的"},{"t":43.4,"text":"會超晃的"},{"t":44.4,"text":"鼻涕在哪裡有晃"},{"t":46.5,"text":"太誇張了"},{"t":47.7,"text":"我們今天要講的故事是"},{"t":51.9,"text":"恐龍車多多的牙齒搖搖晃晃"},{"t":55.4,"text":"換牙的故事"},{"t":57.7,"text":"那我們來去"},{"t":59.2,"text":"說故事吧"},{"t":60.8,"text":"耶"},{"t":64.9,"text":"今天早上呢"},{"t":66.7,"text":"恐龍車多多一起床"},{"t":69.1,"text":"開心的要去吃早餐"},{"t":76.3,"text":"這時候呢"},{"t":78.4,"text":"恐龍多多坐在餐桌上"},{"t":81.3,"text":"張開他大大的嘴巴"},{"t":84,"text":"一口咬下香噴噴的饅頭"},{"t":86.6,"text":"啊"},{"t":87.8,"text":"咦"},{"t":90.6,"text":"恐龍多多停了下來"},{"t":93.6,"text":"他覺得嘴巴里面有一個地方怪怪的"},{"t":98.3,"text":"多多呢輕輕碰了一下牙齒"},{"t":101.4,"text":"他左邊晃晃右邊晃晃"},{"t":105.6,"text":"有一顆牙齒竟然會動耶"},{"t":108.2,"text":"多多呢急急忙忙的跑去找媽媽"},{"t":112.7,"text":"媽媽媽媽"},{"t":114.2,"text":"我的牙齒壞掉了"},{"t":116,"text":"他一直在搖來搖去耶"},{"t":117.7,"text":"媽媽呢請多多張開嘴巴"},{"t":122.2,"text":"來你把嘴巴張大大我看一下"},{"t":125.4,"text":"啊"},{"t":126.3,"text":"媽媽呢仔細看了看"},{"t":128.7,"text":"笑著說"},{"t":129.9,"text":"多多你的牙齒沒有壞掉哦"},{"t":133.3,"text":"這只是一顆乳牙"},{"t":135,"text":"他要準備跟你說再見咯"},{"t":139,"text":"這時候多多瞪大了眼睛"},{"t":141.7,"text":"說再見"},{"t":144.1,"text":"嗯因為呢你慢慢長大了"},{"t":147.7,"text":"你的乳牙呢會一顆一顆的掉下來"},{"t":151.2,"text":"新的橫尺呢就會慢慢的長出來"},{"t":155.1,"text":"這個時候呢我們就叫做換牙"},{"t":158.4,"text":"接下來呢長出新的橫牙"},{"t":161,"text":"就會陪你一輩子哦"},{"t":163.5,"text":"所以呢要不要好好的保護他呢"},{"t":166.5,"text":"呀"},{"t":167.5,"text":"嗯"},{"t":169.1,"text":"多多呢又用了舌頭碰了碰那一顆牙齒"},{"t":173.5,"text":"他說可是他一直咬"},{"t":175.9,"text":"我可以把他拔下來嗎"},{"t":177.6,"text":"多多呢這一顆牙齒呢"},{"t":179.1,"text":"這一顆牙齒呢"},{"t":180.6,"text":"我可以把牙齒擺在這一顆牙齒上"},{"t":334.9,"text":"我可以擺在這一顆牙齒上"}]
