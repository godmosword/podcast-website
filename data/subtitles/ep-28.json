[{"t":0,"text":"我們一起出發去"},{"t":4.5,"text":"嗨我是 Bonbon"},{"t":10.8,"text":"我是馬米"},{"t":12,"text":"你還記得之前你有跟我講說"},{"t":15.3,"text":"你畫畫覺得畫畫不好看的事情嗎"},{"t":18.7,"text":"沒有"},{"t":19.1,"text":"沒有忘記了"},{"t":20.8,"text":"你前幾天才跟我講就忘記了"},{"t":23.7,"text":"好啦那我們今天呢"},{"t":27,"text":"要講的故事是"},{"t":28.2,"text":"金龜車小紅豆"},{"t":30,"text":"畫得很醜也沒有關係"},{"t":32.8,"text":"那我們現在就來去說故事吧"},{"t":36.1,"text":"今天金龜車小紅豆的幼兒園"},{"t":43.4,"text":"要上美術課咯"},{"t":45.6,"text":"暖暖老師呢"},{"t":47.3,"text":"拿出了一大盒的蠟筆"},{"t":49.3,"text":"對大家說"},{"t":51.2,"text":"今天我們要畫自己最喜歡的車車哦"},{"t":56.4,"text":"大家立刻低下頭"},{"t":58.1,"text":"開始認真畫了起來"},{"t":60.6,"text":"小紅豆呢"},{"t":64.9,"text":"也拿起了紅色的蠟筆說"},{"t":66.9,"text":"我要畫F1賽車"},{"t":69.6,"text":"他先畫了一個大大的車身"},{"t":73.1,"text":"再畫四個輪胎"},{"t":76.2,"text":"第一個輪胎"},{"t":78.6,"text":"他畫得小小的"},{"t":80.4,"text":"第二個輪胎"},{"t":82.3,"text":"他畫得扁扁的"},{"t":84,"text":"第三個輪胎"},{"t":86.4,"text":"他畫得比車窗還要大"},{"t":88,"text":"小紅豆歪著頭看了半天"},{"t":92.2,"text":"嗯我怎麼畫的好像怪怪的呢"},{"t":95.9,"text":"小紅豆呢越看越不喜歡"},{"t":100.3,"text":"我的輪胎歪歪的"},{"t":103.5,"text":"車窗也歪歪的"},{"t":105.7,"text":"真是不好看"},{"t":107.4,"text":"小紅豆呢把筆放下說"},{"t":110.6,"text":"我不要畫了"},{"t":112.1,"text":"這時候呢"},{"t":114.2,"text":"暖暖走了過來問小紅豆"},{"t":116,"text":"小紅豆"},{"t":117.7,"text":"小紅豆呢"},{"t":118,"text":"你怎麼了"},{"t":118.6,"text":"小紅豆呢低著頭說"},{"t":122.7,"text":"暖暖"},{"t":123.7,"text":"我覺得我畫得很醜"},{"t":126.1,"text":"你覺得哪裡畫得很醜呢"},{"t":129.7,"text":"我的輪胎一個大一個小"},{"t":134.6,"text":"F1賽車才不是這樣呢"},{"t":137.4,"text":"嗯"},{"t":138,"text":"那我們來想想看"},{"t":140.4,"text":"可以給這個大輪胎跟小輪胎"},{"t":142.9,"text":"他們什麼功能呢"},{"t":144.4,"text":"小紅豆呢想了一下"},{"t":147.8,"text":"他說"},{"t":149.5,"text":"啊我知道了"},{"t":151.5,"text":"F1賽車可以去冒險"},{"t":153.6,"text":"他在大輪胎旁邊呢"},{"t":156.3,"text":"畫了一座山"},{"t":157.3,"text":"又畫了一個小輪胎"},{"t":160,"text":"這個小輪胎呢"},{"t":162,"text":"可以鑽進小小的山洞"},{"t":164.2,"text":"大大的輪胎"},{"t":165.8,"text":"就可以開過大石頭"},{"t":167.6,"text":"小紅豆呢越畫越起勁"},{"t":170.8,"text":"大輪胎"},{"t":173.3,"text":"小輪胎"},{"t":174.3,"text":"歪歪扭扭的車窗"},{"t":176.3,"text":"旁邊還有一座山洞"},{"t":177.7,"text":"一座彩虹山"},{"t":180.4,"text":"最後呢他在車頂上"},{"t":182.5,"text":"畫了一面小旗子"},{"t":185.1,"text":"這時候暖暖說"},{"t":187.1,"text":"哇"},{"t":188,"text":"小紅豆的畫畫得很豐富哦"},{"t":191.2,"text":"你的F1賽車也很有自己的特色呢"},{"t":195.4,"text":"所以畫畫不一定要畫最像"},{"t":199.5,"text":"或是最漂亮"},{"t":201.7,"text":"有些人畫畫會畫得圓圓的"},{"t":204.8,"text":"有些人會畫的歪歪的"},{"t":207.6,"text":"有些人喜歡塗上很多的顏色"},{"t":211.4,"text":"有一些人只喜歡畫一個顏色"},{"t":215.3,"text":"暖暖呢指著他的畫"},{"t":217.9,"text":"但是這一張"},{"t":219.5,"text":"全世界只有小紅豆才畫得出來哦"},{"t":223.2,"text":"別人也畫不出一模一樣的東西哦"},{"t":226.6,"text":"小紅豆的眼睛亮了起來了"},{"t":230.4,"text":"放學後小紅豆呢"},{"t":232.2,"text":"拿著畫給爸爸看"},{"t":234.2,"text":"爸爸爸爸你看"},{"t":235.8,"text":"我跟你介紹哦"},{"t":237.1,"text":"你知道為什麼嗎"},{"t":237.5,"text":"你知道為什麼他的輪胎不一樣大嗎"},{"t":239.6,"text":"為什麼呢"},{"t":242.1,"text":"因為大的可以爬山"},{"t":245.1,"text":"小的呢可以鑽山洞啊"},{"t":247.8,"text":"你看我F1的賽車是不是畫得很厲害呢"},{"t":251.5,"text":"原來是這樣哦"},{"t":253.6,"text":"很有創意哦"},{"t":255.1,"text":"我都沒想到呢"},{"t":256.8,"text":"小紅豆呢"},{"t":259.1,"text":"把畫抱在胸前"},{"t":260.5,"text":"開心的大笑"},{"t":267.5,"text":"I feel like I have to go back to school"},{"t":271.5,"text":"小朋友"},{"t":272.1,"text":"你有沒有遇過在畫畫的時候"},{"t":274.9,"text":"覺得自己畫得不好看的時候呢"},{"t":278.2,"text":"是不是會有一點難過呢"},{"t":280.3,"text":"我聽到咯"},{"t":284.1,"text":"如果有一點難過時"},{"t":289,"text":"可以跟爸爸媽媽說"},{"t":291.5,"text":"或是留言給我們跟蹦蹦分享哦"},{"t":295.6,"text":"因為蹦蹦也遇過一樣的事情哦"},{"t":299.7,"text":"當我們呢遇到這個事情時"},{"t":302,"text":"我們可以想一想"},{"t":303.8,"text":"這個畫得歪歪的地方"},{"t":305.8,"text":"可以變成什麼呢"},{"t":308.1,"text":"發揮一下想象力"},{"t":309.9,"text":"說不定呢"},{"t":311.2,"text":"他就是一個很棒的新點子哦"},{"t":316.3,"text":"因為"},{"t":317.6,"text":"不一樣"},{"t":318.4,"text":"也可以很特別哦"},{"t":321.7,"text":"好咯"},{"t":322.2,"text":"我們今天的故事呢"},{"t":323.5,"text":"就說到這邊咯"},{"t":325.8,"text":"下一次我們再一起學習咯"},{"t":328.1,"text":"吃吃遊樂園玩吧"},{"t":330.9,"text":"拜拜"}]
