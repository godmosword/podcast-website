[{"t":0,"text":"我們一起出發去"},{"t":4.5,"text":"嗨 我是 Bonbon"},{"t":10.9,"text":"我是馬米"},{"t":12,"text":"這個禮拜是父親節"},{"t":16.2,"text":"那你有特別想要送爸爸什麼禮物嗎"},{"t":20,"text":"有驚喜"},{"t":21.9,"text":"你有驚喜喔"},{"t":23.5,"text":"你已經準備好了嗎"},{"t":25.5,"text":"哦好的"},{"t":28,"text":"那爸爸會很開心"},{"t":29.5,"text":"那我們一起來祝父親節快樂吧"},{"t":32.6,"text":"來"},{"t":33.3,"text":"父親節快樂"},{"t":36.3,"text":"那我們來去聽故事吧"},{"t":39,"text":"耶"},{"t":39.6,"text":"今天我們要說的是"},{"t":45.7,"text":"小紅賽車與爸爸的故事"},{"t":48.8,"text":"今天呢是一個很特別的日子"},{"t":54.5,"text":"彩虹廣場掛滿了彩色氣球和照片"},{"t":59,"text":"每一臺小車車都準備了一張小卡片"},{"t":62.6,"text":"因為今天是父親節"},{"t":68.1,"text":"祝大家父親節快樂喔"},{"t":72.3,"text":"小紅賽車開心的跟爸爸一起來到了車車遊樂園"},{"t":77.4,"text":"爸爸呢有著大大的鬍子"},{"t":81.4,"text":"笑起來呢總是很溫暖"},{"t":83.8,"text":"大家都覺得小紅賽車跑得好快好勇敢喔"},{"t":88.5,"text":"可是你知道嗎"},{"t":94.5,"text":"小紅賽車以前也是一臺小小的小baby車喔"},{"t":100.1,"text":"小紅呢看著廣場上的照片"},{"t":103.9,"text":"好奇的問"},{"t":105.1,"text":"爸爸啊爸爸啊"},{"t":107.1,"text":"我以前真的這麼小嗎"},{"t":109.1,"text":"爸爸呢點點頭拿出了手機"},{"t":112.5,"text":"打開了相簿"},{"t":114,"text":"第一張照片裡呢"},{"t":116,"text":"是小紅呢嘴裡還吸著一顆"},{"t":118.5,"text":"綠色的香草奶嘴"},{"t":121,"text":"她的輪子小小的"},{"t":125.7,"text":"開車呢歪歪扭扭的"},{"t":128.5,"text":"連轉彎都會跌倒的躺在草地上"},{"t":135.5,"text":"爸爸笑著說"},{"t":139.6,"text":"那時候你每天都吵著要我陪你"},{"t":144,"text":"小紅呢害羞的笑著說"},{"t":146.8,"text":"真的嗎"},{"t":148.5,"text":"爸爸呢點點頭"},{"t":150.4,"text":"你晚上啊睡不著的時候"},{"t":153.4,"text":"我呢會陪你慢慢繞著花園"},{"t":157.2,"text":"一圈兩圈三圈"},{"t":161.3,"text":"直到你累了困了"},{"t":164.9,"text":"閉上眼睛甜甜的睡著了"},{"t":168.7,"text":"下雨天打雷的時候"},{"t":173.5,"text":"你還會躲到我的旁邊"},{"t":178.5,"text":"爸爸好可怕喔"},{"t":181.2,"text":"別怕有爸爸在"},{"t":184.6,"text":"第一次學開車的時候"},{"t":187.2,"text":"你一直說"},{"t":188.7,"text":"爸爸爸爸我怕怕"},{"t":191.3,"text":"怕怕"},{"t":193.2,"text":"爸爸呢都會回你說"},{"t":195.6,"text":"沒關係"},{"t":196.8,"text":"爸爸陪你慢慢練習"},{"t":200.7,"text":"小紅呢靜靜的聽著"},{"t":203,"text":"爸爸呢又翻到了下一頁"},{"t":205.7,"text":"照片裡面呢"},{"t":207.1,"text":"小紅呢"},{"t":208.4,"text":"第一次學會自己開過小橋"},{"t":211.5,"text":"那一天"},{"t":212.5,"text":"她高興的一直轉圈圈"}