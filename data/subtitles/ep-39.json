  {
    "t": 122.1,
    "text": "哼 我也不要跟你玩了"
  },
  {
    "t": 124.3,
    "text": "圈圈呢"
  },
  {
    "t": 126.8,
    "text": "不開心地轉過頭"
  },
  {
    "t": 128.4,
    "text": "開到了房間的左邊"
  },
  {
    "t": 130.8,
    "text": "點點呢"
  },
  {
    "t": 132.5,
    "text": "也氣噗噗地"
