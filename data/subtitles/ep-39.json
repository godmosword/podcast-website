  {
    "t": 444.8,
    "text": "還能蓋出更多不一樣的作品喔"
  },
  {
    "t": 447.2,
    "text": "有哥哥、姊姊、弟弟、妹妹的陪伴"
  },
  {
    "t": 452.9,
    "text": "是很幸福的事哦"
  },
  {
    "t": 455.2,
    "text": "因為你們可以一起玩"
  },
  {
    "t": 457.1,
    "text": "一起大笑"
  },
  {
    "t": 458.5,
    "text": "一起互相幫忙"
  },
  {
    "t": 460.2,
    "text": "還可以一起長大"
  },
  {
    "t": 462.9,
    "text": "好了"
  },
  {
    "t": 463.7,
    "text": "今天的故事就說到這邊咯"
  },
  {
    "t": 466.1,
    "text": "下一次我們再來車車遊樂園玩吧"
  },
  {
    "t": 470.8,
    "text": "拜拜！拜拜！"
  }
