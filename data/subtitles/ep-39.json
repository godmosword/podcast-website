  {
    "t": 279.9,
    "text": "一下"
  },
  {
    "t": 281.2,
    "text": "兩下"
  },
  {
    "t": 282.7,
    "text": "三下"
  },
  {
    "t": 284.1,
    "text": "火苗越來越小"
  },
  {
    "t": 286.3,
    "text": "越來越小"
