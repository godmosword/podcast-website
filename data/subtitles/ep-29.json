[{"t":0,"text":"我們一起出發去"},{"t":4.4,"text":"嗨我是 Bonbon"},{"t":10.9,"text":"我是馬米"},{"t":12,"text":"我們呢最近有去宜蘭的林場那邊啊"},{"t":17.4,"text":"去玩對不對"},{"t":18.6,"text":"對"},{"t":19,"text":"你有看到什麼東西嗎"},{"t":21.1,"text":"看到一臺大卡車"},{"t":22.8,"text":"你覺得他這一臺車是在做什麼的"},{"t":26.1,"text":"他在搬木廠"},{"t":28.5,"text":"搬木廠"},{"t":30,"text":"他在搬木頭的"},{"t":30.7,"text":"他可以動嗎"},{"t":33.5,"text":"可以啊他以前可以動啊"},{"t":35.8,"text":"因為我們在林場那邊"},{"t":37.6,"text":"是不是看到好多的木頭"},{"t":39.4,"text":"那個卡車要退休"},{"t":41.8,"text":"你覺得他是退休的卡車"},{"t":44,"text":"對不對"},{"t":44.4,"text":"他是一臺歷史很久很久的車子"},{"t":48.2,"text":"那我們今天呢就要來講"},{"t":52.1,"text":"有關於這一臺卡車的故事"},{"t":54.4,"text":"好嗎"},{"t":55.3,"text":"好"},{"t":56.1,"text":"好我們今天"},{"t":57.2,"text":"好"},{"t":59,"text":"那我們"},{"t":60,"text":"那我們今天呢就來講"},{"t":61.9,"text":"大黃卡車的運送任務"},{"t":65.1,"text":"有六根大木頭要怎麼搬呢"},{"t":68.9,"text":"那我們就一起來去聽故事吧"},{"t":71.9,"text":"哇"},{"t":75.9,"text":"今天呢我們要到森林裡面認識一臺大大的工程車"},{"t":81.9,"text":"遠遠的就聽到他的聲音囉"},{"t":84.6,"text":"這部這部大黃我來了"},{"t":92.1,"text":"大黃呢他是一臺黃色的大卡車"},{"t":97.6,"text":"他有高高的駕駛座"},{"t":100.3,"text":"還有黑色的大輪胎"},{"t":103.1,"text":"車身後面還有一個長長的車鬥哦"},{"t":108.5,"text":"你知道他是這個車鬥是要做什麼用的嗎"},{"t":114.6,"text":"就是就是要搬木材"},{"t":117.8,"text":"對"},{"t":118.5,"text":"每天呢大黃都會穿梭在森林裡面"},{"t":123.9,"text":"把一根根的木材呢送到需要的地方"},{"t":127.6,"text":"大黃呢最得意的就是自己的大車鬥"},{"t":132.4,"text":"他說嘿嘿我的大車鬥這麼大"},{"t":137.3,"text":"可以裝好多好多的木頭"},{"t":139.7,"text":"這一天早上呢大黃又接到了任務"},{"t":144.6,"text":"今天有六根木頭要運送哦"},{"t":148.8,"text":"大黃一聽馬上抬起他的車頭"},{"t":152.8,"text":"六根小意思啦"},{"t":156,"text":"我一次就可以全部載完了"},{"t":158.5,"text":"六根小意思"},{"t":161.1,"text":"那我們來看大黃接下來怎麼運送吧"},{"t":167.5,"text":"第一根木頭來咯"},{"t":170.2,"text":"第二根"},{"t":172.1,"text":"第三根"},{"t":173.7,"text":"第四根"},{"t":175.4,"text":"大黃呢越數越開心"},{"t":178.4,"text":"再來再來"},{"t":180.4,"text":"趕快把這些都幫我運上來"},{"t":182.9,"text":"這時候呢東東挖土積經過了"},{"t":188.1,"text":"他說大黃你已經裝了好多根木頭了耶"},{"t":192.5,"text":"沒有問題嗎"},{"t":193.9,"text":"沒有問題"},{"t":195.6,"text":"我的車鬥這麼大"},{"t":197.4,"text":"還有位置呢"},{"t":198.5,"text":"放上來吧"},{"t":199.7,"text":"第五根"},{"t":202,"text":"放上去的時候"},{"t":203.6,"text":"大黃呢"},{"t":204.5,"text":"車身突然沉下去了一點"},{"t":209,"text":"大黃呢看看自己的輪胎"},{"t":212.4,"text":"奇怪我怎麼突然變矮了啊"},{"t":216.1,"text":"東東大笑他說"},{"t":220.3,"text":"不是你變矮啦"},{"t":222,"text":"是你的木頭太重了啦"},{"t":224.8,"text":"可是呢大黃他看看還有剩最後一根木頭耶"},{"t":229.8,"text":"他就說只剩一根了"},{"t":233.1,"text":"全部幫我裝上來啦"},{"t":234.5,"text":"這樣子我就可以一次的完成任務了"},{"t":238.1,"text":"大黃呢拍拍自己的車鬥說"},{"t":241.3,"text":"裝的多就是厲害"},{"t":243.5,"text":"幫我放上來吧"},{"t":246,"text":"我要準備出發咯"},{"t":248.8,"text":"大黃呢發動了引擎"},{"t":251.7,"text":"出發"},{"t":255.8,"text":"結果平常一下子就可以往前的大黃"},{"t":260.5,"text":"今天竟然慢吞吞的"},{"t":264.5,"text":"怎麼這麼重啊"},{"t":266.9,"text":"大黃呢很努力的往前"},{"t":269.8,"text":"用盡了全力踩油門"},{"t":272.1,"text":"我的屁股好像快要跌倒了耶"},{"t":279.7,"text":"怎麼開不動啊"},{"t":281.8,"text":"東東說"},{"t":283.6,"text":"你怎麼開的比刮鳥還慢啊"},{"t":286.5,"text":"你再這樣下去會不會輪胎破掉呢"},{"t":289.5,"text":"那我現在該怎麼辦啊"},{"t":293.2,"text":"大黃呢"},{"t":294.5,"text":"看著大黃看看木頭"},{"t":296.3,"text":"再看看自己的大輪胎"},{"t":299.7,"text":"東東呢突然想到了說"},{"t":302.4,"text":"啊"},{"t":303.3,"text":"不然我們分開兩趟再怎麼樣呢"},{"t":306.7,"text":"一次呢再三根就好了"},{"t":309.2,"text":"第二趟再再三根這樣不就好了嗎"},{"t":313.2,"text":"可是這樣我要跑兩趟耶"},{"t":317.2,"text":"這時候呢吊車阿公呢"},{"t":319.5,"text":"開了過來"},{"t":321.2,"text":"多跑一次沒有關係"},{"t":324.5,"text":"選的方法才是好方法哦"},{"t":329.4,"text":"於是呢大家重新分配木頭"},{"t":332.6,"text":"吊車阿公伸出長長的吊臂"},{"t":338.9,"text":"把幾根木頭呢吊了下來"},{"t":341.7,"text":"大黃呢再試了一次"},{"t":346.9,"text":"咦我又跑得動了"},{"t":349,"text":"我要準備出發囉"},{"t":351.1,"text":"出動吧大卡車"},{"t":353.2,"text":"大黃呢帶著第一批木頭穩穩的送到了目的地"},{"t":360.6,"text":"接著呢再回來再第二趟木頭"},{"t":364.2,"text":"沒多久呢六根木頭全部都平安送到了"},{"t":369.2,"text":"任務完成囉"},{"t":371.8,"text":"大黃呢看看自己的大車鬥突然笑了"},{"t":375.4,"text":"我今天才知道車鬥很大不代表全部都要把東西塞進去"},{"t":383.2,"text":"吊車阿公呢笑著點點頭"},{"t":386.2,"text":"比了一個大大的贊"},{"t":387.8,"text":"從那天開始"},{"t":390.7,"text":"大黃呢還是每天穿梭在森林裡面"},{"t":394.6,"text":"一根"},{"t":396.2,"text":"兩根"},{"t":397.6,"text":"三根"},{"t":398.8,"text":"載著木頭出發"},{"t":400.6,"text":"但是呢他再也不會只想