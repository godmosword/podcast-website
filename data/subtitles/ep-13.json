[{"t":0,"text":"我們一起出發去"},{"t":4.5,"text":"車車遊樂園"},{"t":8,"text":"嗨 我是 Bonbon"},{"t":10.8,"text":"我是馬米"},{"t":12.1,"text":"一大早是誰在唱歌啊"},{"t":19.3,"text":"哦 原來是粉紅色的香香餐車"},{"t":23.5,"text":"她開進來了車車遊樂園"},{"t":26.7,"text":"香香餐車的車窗旁邊呢"},{"t":30.8,"text":"招牌寫著"},{"t":31.8,"text":"今天中午12點"},{"t":33.9,"text":"準時開賣好吃的甜甜圈哦"},{"t":37.2,"text":"小車車們都好想吃哦"},{"t":40.5,"text":"開心的排起隊來"},{"t":42.3,"text":"可是香香餐車"},{"t":45.3,"text":"才剛準備要做新的甜甜圈的時候"},{"t":48.7,"text":"地板下面忽然傳起奇怪的聲音"},{"t":52.7,"text":"哎呀"},{"t":56.5,"text":"不好"},{"t":56.7,"text":"好了"},{"t":57.8,"text":"地底下的小水管被石頭卡住了"},{"t":61.6,"text":"想要做甜甜圈的水流不出來了"},{"t":65.7,"text":"這時候呢"},{"t":66.7,"text":"香香餐車想了想"},{"t":68.7,"text":"嗯"},{"t":69.8,"text":"說這個可能需要請阿酷專遞車來幫忙哦"},{"t":74.9,"text":"一聽到阿酷的名字"},{"t":76.3,"text":"其他的小車車都緊張了起來"},{"t":79.8,"text":"因為呢"},{"t":80.7,"text":"阿酷的身上有一個好大好大的磚頭"},{"t":84.6,"text":"厚厚的輪子"},{"t":86.2,"text":"表情"},{"t":86.7,"text":"很酷酷的"},{"t":87.6,"text":"一動起來就會發出很大聲的巨響"},{"t":91,"text":"他呢看起來很酷"},{"t":96.9,"text":"很不愛笑"},{"t":98.2,"text":"大家呢都有點怕他"},{"t":100.5,"text":"就在這個時候呢"},{"t":102.8,"text":"遠遠的地方呢"},{"t":104.1,"text":"傳來了巨大的聲音"},{"t":105.9,"text":"阿酷呢專遞車開了過來"},{"t":109,"text":"大家都躲在香香車的後面"},{"t":113.6,"text":"不敢太靠近"},{"t":114.6,"text":"沒想到阿酷停下來之後呢"},{"t":116.6,"text":"用很低沉卻很有禮貌的聲音問"},{"t":121,"text":"請問是地下的水管卡住了嗎"},{"t":125.1,"text":"我是來幫忙的"},{"t":127.1,"text":"不過呢等一下聲音會比較大聲"},{"t":130.2,"text":"大家可以站遠一點哦"},{"t":132.8,"text":"才不會被泥土噴到"},{"t":135.6,"text":"其他的小車車呢小聲的說"},{"t":138.4,"text":"哇原來阿酷這麼貼心啊"},{"t":142,"text":"阿酷呢把大磚頭對準地面"},{"t":144.5,"text":"開始認真工作"},{"t":146.6,"text":"地板呢開始震動"},{"t":148.9,"text":"泥土呢一點一點被鑽開"},{"t":151.7,"text":"阿酷呢非常的小心"},{"t":154.3,"text":"也非常的專心看著地面"},{"t":157.1,"text":"他慢慢的鑽"},{"t":159.4,"text":"仔細的找"},{"t":162.7,"text":"終於呢把卡住的石頭推開了"},{"t":166.1,"text":"哇水管呢開通了"},{"t":168.6,"text":"水流出來了"},{"t":170.4,"text":"其他的小車車呢"},{"t":171.9,"text":"這才發現原來阿酷一點都不可怕"},{"t":175.3,"text":"他只是在認真的"},{"t":176.6,"text":"工作"},{"t":178.6,"text":"香香呢開始呢準備起他的甜甜圈麵糊"},{"t":182.7,"text":"他把麵粉牛奶"},{"t":185,"text":"還有雞蛋"},{"t":186,"text":"倒入大碗裡"},{"t":188.1,"text":"可是攪拌機才剛攪拌兩下"},{"t":191.9,"text":"哎呀"},{"t":192.9,"text":"我的攪拌機居然壞掉了"},{"t":196.5,"text":"這下子甜甜圈還是做不出來了"},{"t":199.6,"text":"大家都很失望的垂下頭"},{"t":202.9,"text":"阿酷呢走上前說"},{"t":205.5,"text":"其實"},{"t":206.5,"text":"阿酷的磚頭會轉"},{"t":208.3,"text":"跟攪拌機一樣"},{"t":210.1,"text":"我平常休息的時候"},{"t":211.9,"text":"最喜歡研究做甜點了"},{"t":214.7,"text":"讓我試試看吧"},{"t":217,"text":"哇大家呢都瞪大了眼睛"},{"t":219.8,"text":"沒想到阿酷的磚地車一變身"},{"t":225,"text":"大大的磚頭"},{"t":226.5,"text":"竟然變成小型的攪拌棒"},{"t":229,"text":"在麵糊裡轉動了起來"},{"t":232.4,"text":"這一次呢"},{"t":236.5,"text":"不是攪拌在堅硬的泥土上"},{"t":239,"text":"而是呢"},{"t":239.8,"text":"攪拌在軟綿綿的麵糊裡"},{"t":242.6,"text":"阿酷呢一邊攪拌"},{"t":244.7,"text":"一邊溫柔的說"},{"t":246.5,"text":"做甜甜圈"},{"t":248,"text":"不能太急"},{"t":249.3,"text":"要慢慢的攪拌"},{"t":251.1,"text":"麵糰才會鬆鬆軟軟的喔"},{"t":254.7,"text":"過了一會兒"},{"t":255.7,"text":"這個熱騰騰香噴噴的"},{"t":257.7,"text":"甜甜圈出爐咯"},{"t":261.3,"text":"有粉紅色的草莓甜甜圈"},{"t":264.4,"text":"還有巧克力甜甜圈"},{"t":266.4,"text":"還有灑滿彩色糖霜的彩虹甜甜圈"},{"t":272.6,"text":"香香說"},{"t":274.1,"text":"大家來喔來喔"},{"t":275.7,"text":"我的甜甜圈會準時在中午12點開賣喔"},{"t":280.5,"text":"小車車們呢整齊的呢"},{"t":282.8,"text":"成了一列隊伍"},{"t":284.6,"text":"開始呢要排隊購買甜甜圈"},{"t":287.9,"text":"拿到呢甜甜圈的車車們呢大口大口吃著"},{"t":294.1,"text":"驚訝的說"},{"t":295.6,"text":"哇"},{"t":296.4,"text":"阿酷看起來酷酷的"},{"t":298.2,"text":"可是做出來的甜甜圈怎麼這麼好吃啊"},{"t":302.3,"text":"他們這才明白"},{"t":303.8,"text":"有些車車長得很大"},{"t":306.1,"text":"很酷"},{"t":307.2,"text":"說話的聲音很低沉"},{"t":309.2,"text":"只是因為他們在很專心很努力的工作喔"},{"t":313.3,"text":"其實他們的心裡是非常溫柔的"},{"t":322.8,"text":"小朋友"},{"t":323.5,"text":"聽到阿酷的故事後是不是覺得我們不能"},{"t":326.4,"text":"只看外表呢"},{"t":328.2,"text":"對"},{"t":329.2,"text":"你說他會幫忙做什麼事情"},{"t":331.7,"text":"皮卡丘甜甜圈"},{"t":333.8,"text":"超級帥的飛餅鈴鐺甜甜圈"},{"t":336.9,"text":"喔這麼厲害"},{"t":339.4,"text":"變形金剛的甜甜圈聽起來也很好吃喔"},{"t":342.7,"text":"小朋友下次如果遇到看起來酷酷不愛笑的新朋友"},{"t":347.6,"text":"不要急著害怕喔"},{"t":350.2,"text":"我們可以跟他先揮揮手"},{"t":353.5,"text":"打聲招呼"},{"t":355,"text":"慢慢的認識他"},{"t":356.3,"text":"說不定啊"},{"t":358.1,"text":"他也跟阿酷專遞車一樣"},{"t":360.7,"text":"有一顆像甜甜圈一樣"},{"t":363.2,"text":"香香甜甜暖暖的心喔"},{"t":366.8,"text":"好囉今天故事我們就說到這裡囉"},{"t":370.7,"text":"我們下次再一起來車車遊樂園玩吧"},{"t":374.2,"text":"拜拜"}]
