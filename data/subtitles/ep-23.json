[{"t":0,"text":"我們一起出發去"},{"t":4.4,"text":"車車遊樂園"},{"t":8,"text":"嗨 我是 Bonbon"},{"t":10.8,"text":"我是馬米"},{"t":12,"text":"我們今天要說的故事是"},{"t":15.2,"text":"小紅賽車第一次穿越大山"},{"t":19.4,"text":"那我們就來去聽故事吧"},{"t":22.7,"text":"今天小紅賽車"},{"t":29.6,"text":"要和爸爸一起去宜蘭玩"},{"t":31.9,"text":"一路上小紅興奮得不得了"},{"t":35.1,"text":"她開心的問爸爸"},{"t":36.8,"text":"爸爸 爸爸 宜蘭有什麼啊"},{"t":40.2,"text":"宜蘭有山 有海"},{"t":42.9,"text":"還有好多好吃的東西"},{"t":46.4,"text":"那我們趕快出發吧"},{"t":49.4,"text":"爸爸笑著說"},{"t":51.5,"text":"別急 再到宜蘭以前"},{"t":54.4,"text":"我們要先完成一個特別的任務哦"},{"t":57.9,"text":"爸爸指著前方"},{"t":61.2,"text":"只見一座大山前面"},{"t":63.4,"text":"出現了一個黑黑的大洞"},{"t":66.2,"text":"爸爸說"},{"t":67.7,"text":"就是雪山隧道"},{"t":71.6,"text":"小紅抬頭一看"},{"t":73.7,"text":"哇 我們真的要開進山的肚子裡面嗎"},{"t":78.5,"text":"爸爸點點頭"},{"t":80.7,"text":"咻"},{"t":82.8,"text":"一進了隧道之後"},{"t":84.7,"text":"四周突然變暗了"},{"t":86.7,"text":"剛才亮亮的天空不見了"},{"t":88.7,"text":"頭頂上一盞又一盞的燈"},{"t":92.1,"text":"快速的從小紅的頭上經過"},{"t":95.4,"text":"咻咻咻咻咻"},{"t":97.4,"text":"小紅忍不住的問說"},{"t":100.3,"text":"這一座山的肚子也太大了吧"},{"t":104,"text":"爸爸說"},{"t":106.3,"text":"雪山隧道有12.9公里長哦"},{"t":110.5,"text":"12.9公里那是多長呢"},{"t":114.3,"text":"非常非常的長"},{"t":117.2,"text":"我們呢要在山的肚子裡面開好一會兒"},{"t":121.5,"text":"才會開到另外一邊哦"},{"t":123.6,"text":"那這樣要開多久"},{"t":126.9,"text":"我會不會開到睡著啊"},{"t":129.3,"text":"爸爸呢笑一笑"},{"t":132,"text":"就在這個時候"},{"t":134.2,"text":"一個聲音突然從隧道裡面傳來"},{"t":138.3,"text":"請保持安全距離"},{"t":142.3,"text":"注意行車安全"},{"t":144.5,"text":"小紅呢嚇得輪胎抖了一下"},{"t":147.2,"text":"爸爸啊你有聽到嗎"},{"t":150.7,"text":"聽到了啊"},{"t":152.8,"text":"小紅呢左看看右看看"},{"t":156.1,"text":"是誰是誰在講話啊"},{"t":159.8,"text":"小紅想了想"},{"t":161.5,"text":"難道是雪山姐姐在跟我說話嗎"},{"t":165.2,"text":"爸爸呢故意的問"},{"t":167.9,"text":"那雪山姐姐躲在哪裡呢"},{"t":171.1,"text":"小紅呢開始認真的找啊找"},{"t":175,"text":"牆壁沒有"},{"t":177.2,"text":"頭頂上也沒有"},{"t":178,"text":"嗯難道她藏在前面的車子裡"},{"t":182.9,"text":"雪山姐姐你在哪裡呀"},{"t":187.6,"text":"哪裡呀哪裡呀"},{"t":189.8,"text":"小紅的聲音呢"},{"t":191.4,"text":"在長長的隧道裡面"},{"t":193.3,"text":"傳來了一陣一陣的迴音"},{"t":195.4,"text":"爸爸呢忍不住笑了"},{"t":198.2,"text":"小紅那