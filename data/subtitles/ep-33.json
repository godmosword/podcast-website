[{"t":0,"text":"出發去!"},{"t":30,"text":"彩色的彩哦!"},{"t":32,"text":"那你應該叫彩色漆!"},{"t":35,"text":"嗯!"},{"t":36,"text":"好!"},{"t":37,"text":"那我們來去聽聽看"},{"t":39,"text":"今天是有什麼特別的故事吧!"},{"t":46,"text":"今天車車遊樂園來了一臺新的遊戲車"},{"t":50,"text":"名字呢,叫做彩彩!"},{"t":54,"text":"偷偷的跟你們說"},{"t":56,"text":"彩彩呢,她有一種神奇的能力哦!"},{"t":60,"text":"只要刷一下"},{"t":63,"text":"噴一下"},{"t":66,"text":"每一臺車都能換上新的顏色"},{"t":71,"text":"彩彩說"},{"t":72,"text":"來看看我的巧手一噴!"},{"t":76,"text":"小紅賽車的紅色"},{"t":78,"text":"看起來更帥氣了呢!"},{"t":82,"text":"小藍巴士的天空藍"},{"t":84,"text":"看起來更有精神囉!"},{"t":88,"text":"還有挖土機咚咚的黃色"},{"t":90,"text":"看起來更亮眼了!"},{"t":95,"text":"大家都好開心哦!"},{"t":100,"text":"可是有一臺灰色的小貨車"},{"t":103,"text":"一直躲在角落"},{"t":106,"text":"這一臺小貨車的名字叫做灰灰"},{"t":110,"text":"灰灰呢,一直覺得自己長得不好看"},{"t":114,"text":"灰灰說"},{"t":116,"text":"我想要變成小紅"},{"t":119,"text":"請問彩彩可以幫助我嗎?"},{"t":123,"text":"彩彩說"},{"t":124,"text":"好哦,那我幫你噴成紅色吧!"},{"t":129,"text":"結果噴完之後大家一看"},{"t":131,"text":"咦,好奇怪哦!"},{"t":134,"text":"因為灰灰是方形的小車車"},{"t":137,"text":"紅色呢,配在自己的身上"},{"t":139,"text":"反而不像自己了"},{"t":142,"text":"灰灰又說"},{"t":144,"text":"那我要像警車一樣"},{"t":146,"text":"有藍色跟白色的"},{"t":149,"text":"這時候呢,彩彩幫他噴一噴"},{"t":153,"text":"噴完之後"},{"t":154,"text":"看起來還是怪怪的耶"},{"t":158,"text":"灰灰不滿意"},{"t":160,"text":"接著呢,又繼續變了顏色"},{"t":162,"text":"一下子變黃色"},{"t":164,"text":"一下變綠色"},{"t":165,"text":"一下又變紫色"},{"t":167,"text":"換了好多顏色哦!"},{"t":170,"text":"灰灰呢,卻越來越難過"},{"t":172,"text":"灰灰說"},{"t":174,"text":"是不是"},{"t":175,"text":"我本來就長得很不好看"},{"t":178,"text":"彩彩呢,沒有馬上回答他"},{"t":181,"text":"他帶著灰灰來到了花園"},{"t":184,"text":"花園裡面呢,有好多的花朵"},{"t":188,"text":"有紅色的花"},{"t":190,"text":"黃色的花"},{"t":192,"text":"白色的花"},{"t":193,"text":"好多好多顏色的花哦"},{"t":195,"text":"彩彩問"},{"t":197,"text":"如果這邊的花全部都變成了紅色"},{"t":200,"text":"樹也變成了紅色"},{"t":202,"text":"小鳥也是紅色"},{"t":204,"text":"你覺得這個花園還會像現在這麼特別嗎?"},{"t":208,"text":"灰灰呢,搖搖頭"},{"t":210,"text":"那彩虹有好多好多的顏色"},{"t":214,"text":"紅"},{"t":215,"text":"橙"},{"t":216,"text":"黃"},{"t":217,"text":"綠"},{"t":218,"text":"藍"},{"t":219,"text":"電"},{"t":220,"text":"紫"},{"t":221,"text":"如果全部都變成同一個顏色呢?"},{"t":225,"text":"灰灰呢,大笑說"},{"t":228,"text":"那就不是彩虹了啊!"},{"t":231,"text":"這時候呢,彩彩點點頭說"},{"t":233,"text":"是的,每一臺車都有適合自己的顏色哦"},{"t":239,"text":"於是呢,彩彩呢,幫灰灰呢,再改造最後一次"},{"t":244,"text":"這一次呢,彩彩呢,她沒有照著別人的樣子噴"},{"t":249,"text":"而是呢,慢慢看著灰灰的輪胎"},{"t":252,"text":"窗戶"},{"t":253,"text":"還有她的笑臉"},{"t":255,"text":"最後呢,她幫灰灰設計了一個只屬於她自己的顏色"},{"t":260,"text":"傻傻"},{"t":261,"text":"傻傻傻"},{"t":269,"text":"她保留呢,灰灰原本灰色的車身"},{"t":273,"text":"再幫車框上呢,噴上了一圈溫暖的奶茶色"},{"t":279,"text":"最後,在車頂上畫了一顆亮晶晶的小星星"},{"t":284,"text":"灰灰呢,照著鏡子"},{"t":286,"text":"第一次覺得"},{"t":287,"text":"哇!原來我也可以變得這麼好看哦!"},{"t":291,"text":"其他的小車車呢,圍過來一看就說"},{"t":295,"text":"這就是灰灰啊!一看就知道是你!"},{"t":298,"text":"是灰色的,而且變得更好看了!"},{"t":301,"text":"是啊,灰灰看起來好帥啊!"},{"t":304,"text":"灰灰呢,終於明白"},{"t":307,"text":"不用變成別人"},{"t":309,"text":"因為呢,自己的樣子,也很有自己的特色哦!"},{"t":320,"text":"小朋友,今天的故事呢,是告訴我們"},{"t":323,"text":"每個人都有自己的特色"},{"t":325,"text":"不用跟別人一模一樣"},{"t":328,"text":"有些人有卷卷的頭髮"},{"t":330,"text":"有些人呢,笑起來眼睛彎彎的"},{"t":333,"text":"這些呢,都是你很特別的地方哦!"},{"t":336,"text":"喜歡自己的樣子,就是一件很棒的事哦!"},{"t":341,"text":"好咯,我們今天的故事呢,就說到這邊咯!"},{"t":345,"text":"下一次再一起來車車遊樂園玩吧!"},{"t":349,"text":"拜拜!"}]
