  {
    "t": 183.9,
    "text": "這時候呢"
  },
  {
    "t": 184.6,
    "text": "大家都開始來幫忙要卸下木頭囉"
  },
  {
    "t": 187.7,
    "text": "我們來數一數"
  },
  {
    "t": 189.8,
    "text": "一"
  },
  {
    "t": 190.8,
    "text": "二"
  },
  {
    "t": 191.8,
    "text": "三"
  },
  {
    "t": 192.8,
    "text": "四"
