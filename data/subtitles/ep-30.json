  {
    "t": 89.7,
    "text": "出發之前呢"
  },
  {
    "t": 91.4,
    "text": "八號就仔細數了一遍"
  },
  {
    "t": 93.4,
    "text": "一"
  },
  {
    "t": 94.8,
    "text": "二"
  },
