    "t": 205.9,
    "text": "那我們大家再來數一遍"
  },
  {
    "t": 208.2,
    "text": "一"
  },
  {
    "t": 209.2,
    "text": "二"
  },
  {
    "t": 209.7,
    "text": "三"
  },
  {
    "t": 211.3,
    "text": "四"
