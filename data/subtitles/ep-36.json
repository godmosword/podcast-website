  {
    "t": 344.4,
    "text": "謝謝你的幫忙"
  },
  {
    "t": 346.2,
    "text": "小西立刻在他的面板上"
  },
  {
    "t": 349.2,
    "text": "開啟地圖搜尋"
  },
  {
    "t": 350.7,
    "text": "小西說"
  },
  {
    "t": 354.3,
    "text": "修理站就在前面"
  },
  {
    "t": 356.4,
    "text": "我們出發吧"
  },
  {
    "t": 357.9,
    "text": "過了一會兒"
  },
  {
    "t": 361,
    "text": "他們來到了修理站"
  },
  {
    "t": 362.3,
    "text": "哇 我看到了"
