[
  {
    "t": 330,
    "text": "我的紅色工具箱不見了"
  },
  {
    "t": 331.9,
    "text": "東東想了一想"
  },
  {
    "t": 334.4,
    "text": "啊 我早上看到有一個紅色的工具箱放在路邊"
  },
  {
    "t": 338.5,
    "text": "怕其他的車子撞到"
  },
  {
    "t": 340.3,
    "text": "就先把它搬到修理站了"
  },
  {
    "t": 342.7,
    "text": "原來如此 謝謝你的幫忙"
  },
  {
    "t": 346.7,
    "text": "小西立刻在她的面板上開啟地圖搜尋"
  },
  {
    "t": 350.7,
    "text": "小西說 修理站就在前面"
  },
  {
    "t": 356.4,
    "text": "我們出發吧"
  },
  {
    "t": 360,
    "text": "過了一會兒 他們來到了修理站"
  },
  {
    "t": 362.3,
    "text": "哇 我看到了 我的紅色工具箱"
  },
  {
    "t": 368.7,
    "text": "沃特呢 開心地開啟他的工具箱"
  },
  {
    "t": 375.2,
    "text": "螺絲七支 有"
  },
  {
    "t": 377.9,
    "text": "小扮手 有"
  },
  {
    "t": 379.6,
    "text": "小鐵錘 也有"
  },
  {
    "t": 381.4,
    "text": "太好了 全部都找到了"
  },
  {
    "t": 384.4,
    "text": "沃特呢 開心地轉了一個大圈圈"
  },
  {
    "t": 390,
    "text": "謝謝你 小西"
  },
  {
    "t": 391.3,
    "text": "你真的是一臺很聰明的車車"
  },
  {
    "t": 394.1,
    "text": "小西呢 笑著說"
  },
  {
    "t": 397.2,
    "text": "其實 找東西是有方法的哦"
  },
  {
    "t": 400.6,
    "text": "先想一想 剛剛做過了哪些事情"
  },
  {
    "t": 404.6,
    "text": "再仔細地找找經過的地方"
  },
  {
    "t": 408.1,
    "text": "就比較容易找到不見的東西哦"
  },
  {
    "t": 412.1,
    "text": "沃特呢 點點頭"
  },
  {
    "t": 414.5,
    "text": "我知道了 以後用完東西"
  },
  {
    "t": 417.4,
    "text": "一定要放回固定的位置"
  },
  {
    "t": 420,
    "text": "小朋友 今天小西呢"
  },
  {
    "t": 429.5,
    "text": "和沃特一起找回了紅色工具箱"
  },
  {
    "t": 432.1,
    "text": "下次如果找不到玩具"
  },
  {
    "t": 435,
    "text": "也可以試試看"
  },
  {
    "t": 436.6,
    "text": "先想一想 剛剛我們在哪邊玩呢"
  },
  {
    "t": 440.5,
    "text": "再仔細地找一找"
  },
  {
    "t": 443.6,
    "text": "看看附近有沒有留下什麼線索呢"
  },
  {
    "t": 446.5,
    "text": "找到了玩具之後"
  },
  {
    "t": 449.8,
    "text": "也可以試試看"
  },
  {
    "t": 450,
    "text": "也記得要把東西收好"
  },
  {
    "t": 451.8,
    "text": "放回原位哦"
  },
  {
    "t": 453.4,
    "text": "好咯 今天的故事呢"
  },
  {
    "t": 456.8,
    "text": "就說到這邊咯"
  },
  {
    "t": 458.5,
    "text": "下一次我們再一起來車車遊樂園玩吧"
  },
  {
    "t": 462.2,
    "text": "拜拜"
  }
]
