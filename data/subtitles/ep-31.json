[{"t":0,"text":"我們一起出發去"},{"t":4.4,"text":"嗨我是 Bonbon"},{"t":10.9,"text":"我是馬米"},{"t":12,"text":"小朋友你們喜歡中秋節嗎"},{"t":15.9,"text":"喜歡"},{"t":16.8,"text":"那中秋節都會做哪些事情呢"},{"t":20.3,"text":"烤肉"},{"t":21.2,"text":"吃月餅"},{"t":22.7,"text":"還有會"},{"t":24.2,"text":"看月亮"},{"t":26.5,"text":"對"},{"t":27,"text":"還有會吃柚子對不對"},{"t":30,"text":"對"},{"t":30.6,"text":"中秋節呢是每年農曆的8月15日"},{"t":35.8,"text":"到了這一天呢"},{"t":37.4,"text":"大家會一起賞月"},{"t":38.9,"text":"吃月餅"},{"t":40.3,"text":"還有跟家人朋友聚在一起"},{"t":43.1,"text":"今年的中秋節"},{"t":45.9,"text":"車車遊樂園也要舉辦賞月跟烤肉活動哦"},{"t":50.6,"text":"期待嗎"},{"t":51.5,"text":"期待"},{"t":52.9,"text":"那我們一起來去聽故事吧"},{"t":56.2,"text":"耶"},{"t":60,"text":"今天呢是中秋節"},{"t":63,"text":"天氣很好哦"},{"t":65.8,"text":"天空呢漸漸變暗了"},{"t":68.9,"text":"一顆呢又大又圓的月亮"},{"t":71.7,"text":"慢慢的升上天空"},{"t":76.6,"text":"車車遊樂園的彩虹廣場"},{"t":79.2,"text":"正在舉辦一年一度的"},{"t":81.5,"text":"中秋烤肉大會"},{"t":85.6,"text":"恐龍車多多第一個到哦"},{"t":88.4,"text":"他說"},{"t":89.8,"text":"我帶了好多玉米來哦"},{"t":92.4,"text":"挖土雞東東也跟著開了過來"},{"t":96.7,"text":"他說"},{"t":100.5,"text":"我帶了肉片和香腸"},{"t":102.9,"text":"肉片和香腸"},{"t":105.9,"text":"對"},{"t":106.3,"text":"小紅賽車也來咯"},{"t":110.3,"text":"他說"},{"t":113.3,"text":"我有帶吐司"},{"t":114.9,"text":"等等大家可以夾肉吃哦"},{"t":117.6,"text":"大家呢"},{"t":119,"text":"把食材呢"},{"t":119.8,"text":"一樣一樣的放到桌上"},{"t":122.1,"text":"有玉米"},{"t":123.6,"text":"香腸"},{"t":125.2,"text":"肉片"},{"t":126.4,"text":"甜不辣"},{"t":127.5,"text":"還有好多好吃的食材"},{"t":133.6,"text":"要準備烤肉咯"},{"t":134.9,"text":"耶"},{"t":135.9,"text":"好想吃哦"},{"t":139,"text":"肉片呢"},{"t":139.7,"text":"一放上烤肉架"},{"t":141.3,"text":"立刻發出滋滋滋的聲音"},{"t":146.4,"text":"好香啊"},{"t":148.5,"text":"哇好香啊"},{"t":149.8,"text":"好香哦"},{"t":152.1,"text":"就在這個時候"},{"t":154.9,"text":"頓頓頓頓頓"},{"t":156.9,"text":"遠遠的地方"},{"t":158.5,"text":"有一臺急急忙忙的車開了過來"},{"t":161,"text":"是誰呀"},{"t":164.9,"text":"原來是撲撲豬"},{"t":168.4,"text":"中秋節烤肉"},{"t":170,"text":"怎麼可以沒有我這個最帥的豬呢"},{"t":177.2,"text":"撲撲豬的車頂上還頂著一個"},{"t":179.2,"text":"大大的鍋子"},{"t":181.2,"text":"挖土機咚咚好奇的問"},{"t":183.6,"text":"撲撲豬你帶了什麼東西呀"