[{"t":0,"text":"我們一起出發去"},{"t":4.6,"text":"車車遊樂園"},{"t":8,"text":"嗨我是 Bonbon"},{"t":10.8,"text":"我是馬米"},{"t":12,"text":"在車車遊樂園裡面呢"},{"t":15.1,"text":"有一臺很特別的清潔車"},{"t":17.4,"text":"名字呢叫做鈴鈴清潔車"},{"t":20.4,"text":"每天早上呢"},{"t":21.9,"text":"鈴鈴清潔車都會準時的開到廣場"},{"t":25.1,"text":"播放那個溫柔又可愛的提醒音樂"},{"t":28.9,"text":"叫大家起床咯"},{"t":31.3,"text":"大家起床咯"},{"t":34.7,"text":"準備吃早餐"},{"t":35.9,"text":"準備出任務咯"},{"t":38.3,"text":"小紅賽車呢"},{"t":39.9,"text":"聽到鈴鈴的音樂"},{"t":41.1,"text":"就會咻一下的跳了起來"},{"t":44.1,"text":"安安呢"},{"t":44.9,"text":"救護車聽到鈴鈴的音樂"},{"t":46.7,"text":"就會馬上整理好他的急救箱"},{"t":49.4,"text":"黃色計程車呢"},{"t":51.9,"text":"也會開心的說"},{"t":53.1,"text":"謝謝你鈴鈴清潔車"},{"t":55.1,"text":"有你提醒大家"},{"t":56.7,"text":"我們都不會遲到哦"},{"t":58.5,"text":"鈴鈴清潔車呢"},{"t":61.2,"text":"拍拍車門認真的說"},{"t":62.8,"text":"我答應大家"},{"t":64.2,"text":"每天早上都會準時醒來"},{"t":66.5,"text":"提醒大家起床哦"},{"t":67.9,"text":"可是有一天晚上"},{"t":70.7,"text":"車車遊樂園裡下起了大雨"},{"t":73.4,"text":"雨水呢"},{"t":78.9,"text":"打在鈴鈴清潔車的車窗上"},{"t":81.5,"text":"也打溼了他的音樂喇叭"},{"t":84,"text":"隔天早上"},{"t":85.9,"text":"鈴鈴清潔車起床"},{"t":87.6,"text":"想要播放早安音樂"},{"t":89.7,"text":"可是"},{"t":90.9,"text":"怎麼音樂喇叭發不出聲音啊"},{"t":95.2,"text":"這時候呢"},{"t":96.6,"text":"鈴鈴很著急的想著說"},{"t":98.4,"text":"怎麼辦怎麼辦"},{"t":99.5,"text":"糟糕了"},{"t":100.7,"text":"我答應要提醒大家"},{"t":102.6,"text":"他們要起床了"},{"t":103.8,"text":"可是我現在的喇叭壞掉了"},{"t":106.3,"text":"他很焦急"},{"t":108,"text":"不知道要怎麼辦"},{"t":109.4,"text":"本來很想要留在車庫裡面休息的"},{"t":112.6,"text":"可是他想到大家還在睡覺"},{"t":115.5,"text":"可能會遲到"},{"t":116.8,"text":"他就出發努力的轉動輪胎"},{"t":119.7,"text":"鈴鈴呢"},{"t":122.8,"text":"先開車開到了小紅賽車家門口"},{"t":125.6,"text":"因為呢"},{"t":127.1,"text":"他沒有辦法播放音樂"},{"t":128.9,"text":"就用車燈一閃一閃的"},{"t":131.3,"text":"這時候呢"},{"t":133.6,"text":"小紅賽車揉揉眼睛說"},{"t":135.5,"text":"咦"},{"t":136.2,"text":"鈴鈴"},{"t":137.3,"text":"你今天怎麼沒有音樂呢"},{"t":140.4,"text":"鈴鈴清潔車呢"},{"t":143.2,"text":"小聲的說"},{"t":144.1,"text":"我的音樂喇叭壞掉了"},{"t":146.8,"text":"但是我答應要叫大家起床了"},{"t":150.5,"text":"所以我還是來了"},{"t":152.3,"text":"接著呢"},{"t":154.2,"text":"鈴鈴呢又開車"},{"t":155.6,"text":"開到了安安救護車家的門口"},{"t":158.4,"text":"用雨刷刷著刷"},{"t":160.8,"text":"刷著刷"},{"t":162.1,"text":"這時候呢"},{"t":164.3,"text":"安安救護車醒過來了"},{"t":166,"text":"感動的說"},{"t":167.4,"text":"啊鈴鈴"},{"t":169.2,"text":"你的音樂喇叭壞掉了"},{"t":171.6,"text":"還記得要叫大家起床的事啊"},{"t":174.1,"text":"最後呢"},{"t":175.6,"text":"計程車"},{"t":176.3,"text":"小挖土機"},{"t":177.7,"text":"還有警車呢"},{"t":179,"text":"大家都準時起床了"},{"t":180.6,"text":"大家呢"},{"t":182.1,"text":"一起陪鈴鈴呢"},{"t":183.4,"text":"去維修廠"},{"t":184.4,"text":"修理車的叔叔呢"},{"t":186.4,"text":"幫他檢查後說了"},{"t":187.9,"text":"哦原來啊"},{"t":189.5,"text":"你只是喇叭進水了"},{"t":192.1,"text":"休息一下就會好了"},{"t":193.7,"text":"這時候呢"},{"t":195.6,"text":"鈴鈴很不好意思的說"},{"t":197.2,"text":"我以後會記得保護好"},{"t":199.4,"text":"我自己的音樂喇叭的"},{"t":201,"text":"小紅賽車說"},{"t":203.4,"text":"鈴鈴"},{"t":204.4,"text":"你真的很守信用耶"},{"t":206.3,"text":"答應了大家"},{"t":207.2,"text":"就會努力做到哦"},{"t":209.5,"text":"這時候呢"},{"t":210.4,"text":"鈴鈴清潔車呢"},{"t":211.7,"text":"開心的笑了"},{"t":213.2,"text":"他的喇叭終於好嘍"},{"t":217.2,"text":"從那天開始呢"},{"t":218.5,"text":"大家更相信鈴鈴了"},{"t":220.8,"text":"因為他們知道呢"},{"t":222,"text":"鈴鈴呢"},{"t":222.7,"text":"是一臺會說到做到的車"},{"t":225.6,"text":"小朋友你可以想想看"},{"t":227.3,"text":"我們是不是呢"},{"t":228.3,"text":"有時候會答應別人要做的事情呢"},{"t":231.6,"text":"那我們答應了"},{"t":232.6,"text":"就要努力做到哦"},{"t":234.6,"text":"因為守信用"},{"t":236.1,"text":"會讓朋友更相信你"},{"t":238,"text":"然後也會覺得你是一個安心的人哦"},{"t":240.5,"text":"好"},{"t":241.9,"text":"那我們今天"},{"t":243.6,"text":"車車遊樂園的故事"},{"t":245.3,"text":"就說到這裡咯"},{"t":246.3,"text":"下一集見"},{"t":247.9,"text":"拜拜"}]