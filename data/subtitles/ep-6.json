[{"t":0,"text":"我們一起出發去"},{"t":4.4,"text":"車車遊樂園"},{"t":8,"text":"嗨 我是 Bonbon"},{"t":10.8,"text":"我是馬米"},{"t":12.1,"text":"歡迎來到車車遊樂園"},{"t":15.5,"text":"今天的主講是一臺白色的救護車"},{"t":19.3,"text":"名字叫做安安"},{"t":23.2,"text":"安安救護車有紅色的十字標誌"},{"t":27,"text":"還有亮亮的車燈"},{"t":29.1,"text":"只要聽到有人需要幫忙"},{"t":31.2,"text":"它就會立刻出發"},{"t":32.9,"text":"這一天早上"},{"t":35,"text":"車車遊樂園陽光暖暖的"},{"t":38,"text":"大家都在廣場裡面玩得很開心"},{"t":41.8,"text":"小紅賽車在練習轉彎"},{"t":44.5,"text":"藍色小巴士載著小乘客繞圈圈"},{"t":48.3,"text":"東東挖土機正在整理沙坑"},{"t":50.9,"text":"突然廣播傳來緊急的聲音"},{"t":54.6,"text":"請注意 請注意"},{"t":59.1,"text":"山坡的花園"},{"t":60.4,"text":"那邊有一臺三輪車卡在泥巴里面需要幫忙"},{"t":64.9,"text":"這時候安安救護車一聽到"},{"t":68.4,"text":"馬上說"},{"t":69.1,"text":"我來 我可以幫忙"},{"t":71.2,"text":"他開啟車燈準備出任務"},{"t":74.2,"text":"安安一路開呀開"},{"t":76.9,"text":"很快的開到了山坡花園"},{"t":78.9,"text":"他看見了三輪車的輪子陷在泥巴里面"},{"t":83.2,"text":"動也不動"},{"t":84.2,"text":"三輪車很害怕的說"},{"t":86.5,"text":"安安"},{"t":88.2,"text":"我的三輪車的輪子卡住了"},{"t":91.7,"text":"我好緊張喔"},{"t":93.3,"text":"安安溫柔的說"},{"t":95.6,"text":"別怕 我來幫你了"},{"t":97.6,"text":"安安拿出了小繩子"},{"t":100,"text":"想要幫三輪車拉出來"},{"t":102,"text":"他呢用力拉了一下"},{"t":104.3,"text":"可是三輪車沒有動"},{"t":107.3,"text":"三輪車還是卡在泥巴里面"},{"t":111.5,"text":"這時候安安呢又再用力拉了一下"},{"t":115.4,"text":"嘿 咻"},{"t":116.9,"text":"可是三輪車沒有動"},{"t":118.2,"text":"但是三輪車還是卡在泥巴里面"},{"t":122.1,"text":"這時候呢"},{"t":122.9,"text":"安安心裡面有一點急了"},{"t":125.7,"text":"他心想我是救護車"},{"t":128,"text":"我應該要自己完成任務才對啊"},{"t":130.8,"text":"如果我做不到"},{"t":132.3,"text":"是不是大家都會覺得我不厲害呢"},{"t":136.1,"text":"於是呢"},{"t":136.8,"text":"安安呢又再試了一次"},{"t":139.4,"text":"可是泥巴太黏了"},{"t":141.5,"text":"三輪車還是沒有被拉了出來"},{"t":145.3,"text":"安安自己的輪胎也差一點陷進去了"},{"t":147.4,"text":"這時候三輪車說"},{"t":150.9,"text":"安安你還好嗎"},{"t":153.3,"text":"安安呢停下來深深吸了一口氣"},{"t":156.7,"text":"他看著溼溼的泥巴"},{"t":159.5,"text":"又看著很害怕的三輪車"},{"t":162.2,"text":"心裡面明白了"},{"t":164.1,"text":"幫忙呢不一定是要自己完成"},{"t":167,"text":"更重要的是要冷靜下來"},{"t":169.9,"text":"想辦法救援成功"},{"t":172.3,"text":"這時候呢"},{"t":173.9,"text":"安安拿起了對講機說"},{"t":175.7,"text":"東東挖土機這裡是安安救護車"},{"t":177.3,"text":"有一臺小的三輪車卡在泥巴里面"},{"t":177.4,"text":"唯一一個人拉不出來"},{"t":179.1,"text":"需要你的幫忙"},{"t":186.6,"text":"東東挖土機說收到"},{"t":188.9,"text":"不一會兒呢"},{"t":190.6,"text":"東東挖土機呢就開了過來"},{"t":193,"text":"安安我來了"},{"t":194.9,"text":"東東呢用這個大大的挖土鏟子"},{"t":198.4,"text":"把三輪車旁邊的泥土呢挖開"},{"t":201.3,"text":"這時候呢藍色小巴士也開來咯"},{"t":205.3,"text":"藍色小巴士說"},{"t":206.8,"text":"我來吧"},{"t":207.4,"text":"我可以呢幫忙擋在旁邊"},{"t":209.3,"text":"提醒其他的車車不要靠近"},{"t":211.3,"text":"小紅賽車呢也過來幫忙指揮交通"},{"t":214.8,"text":"大家一起合作"},{"t":216.5,"text":"東東挖土機呢挖開了泥巴"},{"t":219.4,"text":"安安救護車呢拉住了三輪車"},{"t":223.7,"text":"小紅賽車呢跟藍色小巴士呢"},{"t":226.8,"text":"在旁邊引導交通保護大家"},{"t":229.4,"text":"一二三嘿咻"},{"t":232.7,"text":"三輪車的輪子終於從泥巴里出來了"},{"t":236.9,"text":"藍色小巴士呢在旁邊引導交通保護大家"},{"t":237.4,"text":"三輪車呢開心的說"},{"t":239.4,"text":"太好了我出來了謝謝你們"},{"t":242,"text":"安安呢也鬆了一口氣"},{"t":244.3,"text":"不好意思的說"},{"t":245.5,"text":"一開始我以為自己一定要一個人完成任務才算勇敢"},{"t":250.9,"text":"可是後來我發現自己呢需要幫忙"},{"t":254.7,"text":"願意開口求救呢是更重要的"},{"t":257.8,"text":"東東挖土機笑著說"},{"t":260.1,"text":"沒錯每個人呢都有自己擅長的地方"},{"t":264.1,"text":"我們一起做合作力量大"},{"t":266.9,"text":"合作力量大"},{"t":267.4,"text":"事情就會變得更簡單哦"},{"t":269.4,"text":"這時候呢回到了車車遊樂園後"},{"t":273,"text":"園長呢在這個廣播上面說"},{"t":275.9,"text":"今天安安呢救護車做得很好"},{"t":281.1,"text":"他知道自己需要別人的幫忙"},{"t":284.8,"text":"會呢呼叫他的同伴"},{"t":287.1,"text":"大家一起合作"},{"t":289.2,"text":"就讓三輪車平安回來了"},{"t":292,"text":"那天開始呢安安知道了"},{"t":295.3,"text":"遇到困難的時候呢"},{"t":297.3,"text":"可以自己先試試看"},{"t":299,"text":"如果真的做不到"},{"t":300.7,"text":"就要勇敢的開口說"},{"t":302.8,"text":"我需要幫忙"},{"t":304.7,"text":"小朋友你有遇過需要幫忙的時候嗎"},{"t":308.5,"text":"你可以告訴你的同學"},{"t":311.4,"text":"你的老師"},{"t":313,"text":"或是爸爸媽媽"},{"t":315.8,"text":"請別人幫忙呢不代表你不厲害哦"},{"t":318.8,"text":"而是呢你知道要怎麼保護自己"},{"t":321.8,"text":"也保護別人"},{"t":323.8,"text":"有一天別人也會需要你的幫忙哦"},{"t":327.3,"text":"那我們今天的故事就說到這邊啦"},{"t":330,"text":"謝謝你們的收聽"},{"t":331.9,"text":"我們下次再一起來車車遊樂園玩吧"},{"t":335.7,"text":"拜拜"}]