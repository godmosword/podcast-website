[{"t":0,"text":"我們一起出發去"},{"t":4.4,"text":"嗨 我是 Bonbon"},{"t":10.8,"text":"我是馬米"},{"t":12,"text":"我們今天呢要講的故事是"},{"t":15.7,"text":"恐龍車多多闖禍了"},{"t":18.6,"text":"不能亂開門"},{"t":21.8,"text":"糟糕了"},{"t":22.8,"text":"恐龍車多多這一次又做錯了什麼事情呢"},{"t":26.4,"text":"那我們來去聽故事吧"},{"t":29.3,"text":"今天的天氣很好哦"},{"t":35.6,"text":"太陽大大的"},{"t":37.6,"text":"小鳥啾啾啾啾叫"},{"t":40.1,"text":"車車遊樂園正準備開門咯"},{"t":45.3,"text":"小車車們一臺一臺的排好隊"},{"t":50.1,"text":"準備要進場玩咯"},{"t":52.4,"text":"這時候呢"},{"t":57.8,"text":"爆米花"},{"t":58.8,"text":"老爺車"},{"t":59.6,"text":"也慢慢的開了過來"},{"t":61.8,"text":"他每天都會在彩虹廣場"},{"t":66.1,"text":"做出香香甜甜的爆米花"},{"t":69.7,"text":"一顆一顆的爆米花跳起來"},{"t":83.9,"text":"是小車車們最喜歡的點心"},{"t":88.3,"text":"小車車們還會哼起快樂的爆米花歌哦"},{"t":92.2,"text":"就當大家都在很開心的唱歌"},{"t":96.7,"text":"等待的時候"},{"t":98.1,"text":"突然發出了一聲巨響"},{"t":101.3,"text":"爆米花老爺爺大喊"},{"t":108.9,"text":"哎喲喂呀"},{"t":112.3,"text":"我被撞到了"},{"t":114,"text":"痛死我了"},{"t":118.3,"text":"恐龍車多多"},{"t":119.5,"text":"完全沒有注意到爆米花老爺車"},{"t":122.7,"text":"正從旁邊經過"},{"t":124.5,"text":"多多呢就突然的把車門打開了"},{"t":127.9,"text":"剛好撞到了爆米花老爺車"},{"t":131,"text":"爆米花老爺車呢"},{"t":133.6,"text":"重重晃了一下"},{"t":134.8,"text":"慢慢的停了下來"},{"t":137.1,"text":"多多也嚇了一大跳"},{"t":139.5,"text":"他的車門卡住了"},{"t":141.5,"text":"車身也痛痛的"},{"t":143.1,"text":"多多趕快問"},{"t":144.7,"text":"老爺爺你還好嗎"},{"t":148.3,"text":"老爺爺說"},{"t":149.2,"text":"我現在好痛"},{"t":152,"text":"我動不了了"},{"t":153.8,"text":"可能沒辦法自己開車了"},{"t":156.8,"text":"多多呢"},{"t":158.9,"text":"他知道自己闖禍了"},{"t":160.8,"text":"趕快對旁邊的小車車說"},{"t":163.2,"text":"請你們幫幫忙"},{"t":165,"text":"快點叫救護車安安來"},{"t":167.3,"text":"小車車們呢"},{"t":169.5,"text":"皺起眉頭說"},{"t":170.8,"text":"多多都是你沒看清楚"},{"t":173.5,"text":"就亂開車門"},{"t":174.9,"text":"才害老爺爺受傷"},{"t":176.7,"text":"其他的小車車們呢"},{"t":178.3,"text":"也難過了說"},{"t":179.3,"text":"對啊對啊"},{"t":180.4,"text":"都是你害大家"},{"t":181.8,"text":"最近都吃不到香噴噴的爆米花了"},{"t":184.7,"text":"多多呢低下頭"},{"t":187.6,"text":"心裡呢又害怕又難過"},{"t":190.7,"text":"他大哭的說"},{"t":192.2,"text":"對不起"},{"t":193.4,"text":"我真的不是故意的"},{"t":195.9,"text":"對不起"},{"t":197.1,"text":"很快的救護車安安就來了"},{"t":201.3,"text":"安安呢"},{"t":204.6,"text":"把老爺爺跟恐龍車多多呢"},{"t":207.2,"text":"送去了醫院"},{"t":208.2,"text":"老爺爺因為受傷很嚴重"},{"t":211.6,"text":"必須在醫院住好幾天"},{"t":213.7,"text":"暫時沒有辦法工作賣爆米花了"},{"t":217,"text":"多多呢是輕微的受傷"},{"t":219.9,"text":"擦完藥以後就可以出院回家"},{"t":222.7,"text":"多多呢走到老爺車旁邊說"},{"t":226.3,"text":"老爺爺對不起"},{"t":229.3,"text":"我剛剛沒有看清楚"},{"t":231.6,"text":"就亂開門害你受傷了"},{"t":233.9,"text":"老爺爺呢雖然很痛"},{"t":236.7,"text":"還是很溫柔的回答"},{"t":238.2,"text":"老爺爺呢說 你自己知道做錯就好了"},{"t":242,"text":"下次要記得要改進不要再犯錯哦"},{"t":247,"text":"多多呢用力的點點頭說"},{"t":251,"text":"我知道了我會記得不能亂開門的"},{"t":255,"text":"小朋友今天的故事呢是告訴我們"},{"t":265.4,"text":"安全最重要"},{"t":267.2,"text":"不論呢"},{"t":268.2,"text":"你是待在車上"},{"t":269.5,"text":"還是呢家裡的大門"},{"t":271.5,"text":"都不可以隨便的開啟哦"},{"t":274.3,"text":"要開門之前"},{"t":276.4,"text":"一定要請大人陪同哦"},{"t":279.6,"text":"都不能隨便開啟"},{"t":283.7,"text":"你知道為什麼不能隨便開啟嗎"},{"t":286.3,"text":"對"},{"t":286.8,"text":"因為如果撞到的話非常的危險"},{"t":291.3,"text":"可能自己會受傷"},{"t":293,"text":"別人也會受傷對不對"},{"t":295,"text":"那蹦蹦你還有記得嗎"},{"t":298.1,"text":"還有什麼呢"},{"t":299.3,"text":"哎喲喂好痛哦"},{"t":301.9,"text":"你在學爆米花老爺爺的聲音哦"},{"t":304.4,"text":"痛死我了"},{"t":307.2,"text":"哎喲喂啊"},{"t":308.9,"text":"老爺爺那麼痛"},{"t":315.9,"text":"你還在笑"},{"t":318.3,"text":"老爺爺哭哭了啦"},{"t":321.5,"text":"好吧給蹦蹦表演一下咯"},{"t":323.9,"text":"那我們今天的故事就說到這邊咯"},{"t":328.1,"text":"下一次我們再一起來車車遊樂園玩吧"},{"t":333,"text":"拜拜"}]
