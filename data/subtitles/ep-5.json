[{"t":0,"text":"我們一起出發去"},{"t":4.4,"text":"嗨 我是 Bonbon"},{"t":10.8,"text":"我是馬米"},{"t":12.1,"text":"今天的主角是一臺黃色的小蛙土機"},{"t":18.1,"text":"它的名字叫什麼呀"},{"t":22.1,"text":"咚咚"},{"t":23.3,"text":"對 它的名字叫咚咚"},{"t":26,"text":"它的名字叫咚咚"},{"t":28.3,"text":"咚咚有一個很大的什麼東西"},{"t":32.4,"text":"大鏟子"},{"t":33.5,"text":"對 它有一個大鏟子"},{"t":35.2,"text":"看起來很厲害哦"},{"t":36.6,"text":"但其實它有一點膽小"},{"t":39.6,"text":"它不敢開上斜坡"},{"t":42.1,"text":"因為它怕會滑下來"},{"t":44,"text":"也不敢推大石頭"},{"t":46,"text":"怕它的鏟子被壓壞了"},{"t":48.5,"text":"有一天 徹徹遊樂園的花園小路"},{"t":52.1,"text":"因為大雨後"},{"t":53.6,"text":"被泥巴和石頭擋住了"},{"t":57.4,"text":"小花朵呢 被壓得滴滴的"},{"t":60.2,"text":"小花朵好像在說什麼啊"},{"t":63.3,"text":"誰可以來幫幫我"},{"t":68.3,"text":"咚咚看見了 心裡想著"},{"t":71.6,"text":"我是蛙土機"},{"t":73.4,"text":"我應該可以幫忙"},{"t":75.2,"text":"這時候呢 吊車老爺爺呢"},{"t":78.3,"text":"開了過來"},{"t":79.4,"text":"吊車老爺爺問"},{"t":81.1,"text":"咚咚 你怎麼停在這裡"},{"t":84.9,"text":"咚咚呢 低著頭說"},{"t":87.4,"text":"我想幫忙"},{"t":89.9,"text":"可是我怕斜坡 也怕石頭"},{"t":93.1,"text":"我是不是不夠勇敢"},{"t":95.3,"text":"吊車老爺爺說"},{"t":97.9,"text":"勇敢不是完全不害怕哦"},{"t":102.5,"text":"勇敢呢 是心裡有點害怕"},{"t":105.9,"text":"還是願意去試看看哦"},{"t":108.9,"text":"咚咚呢 眨眨眼睛"},{"t":112.4,"text":"想著說 可是我還是怕怕的"},{"t":117.4,"text":"吊車老爺爺說"},{"t":119.3,"text":"沒關係"},{"t":121.2,"text":"不用一次完成全部"},{"t":124.1,"text":"你只要呢 先走一小步"},{"t":127.9,"text":"咚咚呢 點點頭"},{"t":129.9,"text":"他來到了呢 小斜坡前面"},{"t":132.6,"text":"輪子呢 有一點發抖"},{"t":135.1,"text":"吊車老爺爺在後面說"},{"t":138.3,"text":"來 先深呼吸"},{"t":142.2,"text":"輪胎呢 踩穩"},{"t":146.6,"text":"慢慢來"},{"t":147.3,"text":"這時候呢 咚咚吸了一口氣"},{"t":151,"text":"他呢 一點一點的往上開"},{"t":154.2,"text":"哦 咚咚成功開上去了"},{"t":158.3,"text":"咚咚開心的說"},{"t":160.3,"text":"我做到了"},{"t":161.6,"text":"接著呢 他又看到了一顆大石頭擋在路的中間"},{"t":165.6,"text":"咚咚呢 又緊張的想著說"},{"t":168.2,"text":"我推得動嗎"},{"t":170.4,"text":"老爺爺呢 看到就說"},{"t":173.1,"text":"來 先輕輕的推推看"},{"t":177.1,"text":"咚咚呢 放下了挖土鏟子"},{"t":179.2,"text":"輕輕的一推"},{"t":181,"text":"石頭沒有動"},{"t":182.5,"text":"他呢 有點失望"},{"t":184.8,"text":"吊車老爺爺說"},{"t":186.6,"text":"沒關係"},{"t":188.4,"text":"我們換個方向再試一次看看"},{"t":192,"text":"咚咚呢 換了角度"},{"t":194.3,"text":"再用力一點"},{"t":196.8,"text":"誒 石頭慢慢滾到旁邊"},{"t":200.7,"text":"不通了"},{"t":202,"text":"最後呢 咚咚來到了花瓣巷"},{"t":204.9,"text":"咚咚呢 換了角度了"},{"t":207.1,"text":"到花瓣巷的花瓣巷前面"},{"t":208.7,"text":"前面呢 好多的泥巴喔"},{"t":211.5,"text":"他又開始緊張了起來"},{"t":214,"text":"心裡呢 撲通撲通的跳著"},{"t":217.4,"text":"這時候呢 吊車老爺爺說"},{"t":220.4,"text":"還記得嗎"},{"t":222.2,"text":"先做一小步"},{"t":224.8,"text":"咚咚點點頭說"},{"t":226.3,"text":"好"},{"t":227.3,"text":"我呢 會先挖第一鏟"},{"t":229.9,"text":"第二鏟"},{"t":232.5,"text":"第三鏟"},{"t":233.7,"text":"咚咚呢 慢慢的把泥巴清開了"},{"t":237.1,"text":"小鹿呢 露了出來"},{"t":240.2,"text":"小花呢 也站直了"},{"t":242.2,"text":"好像呢 在對這個 大家說"},{"t":245.8,"text":"謝謝你們"},{"t":247.1,"text":"幫我"},{"t":248.1,"text":"把這個泥巴都清好了"},{"t":251.4,"text":"咚咚呢"},{"t":252.7,"text":"笑了笑"},{"t":253.7,"text":"我真的完成了"},{"t":255.8,"text":"吊車老爺爺說"},{"t":257.6,"text":"咚咚"},{"t":258.8,"text":"你今天有找到勇氣喔"},{"t":262.9,"text":"咚咚說"},{"t":264.7,"text":"勇氣在哪裡"},{"t":267,"text":"吊車老爺爺說"},{"t":269.1,"text":"就在你心裡啊"},{"t":271.6,"text":"你害怕"},{"t":273.2,"text":"但你卻願意嘗試一小步"},{"t":276.3,"text":"這個就是勇氣喔"},{"t":278.6,"text":"咚咚呢 摸摸自己的胸口"},{"t":281.6,"text":"原來呢 勇敢不是不害怕"},{"t":284.4,"text":"是你在害怕的時候也願意去試試看喔"},{"t":287.8,"text":"小朋友"},{"t":290.1,"text":"下次呢 你遇到害怕的事情的時候"},{"t":293.4,"text":"也可以像咚咚一樣喔"},{"t":295.5,"text":"先深呼吸"},{"t":297,"text":"慢慢的試一小步看看喔"},{"t":299.8,"text":"那我們今天的故事呢"},{"t":303.4,"text":"就分享到這邊啦"},{"t":304.9,"text":"我們下次再一起來車車遊樂園玩吧"},{"t":308.8,"text":"拜拜"}]
