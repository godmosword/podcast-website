[{"t":0,"text":"我們一起出發去"},{"t":4.5,"text":"嗨我是 Bonbon"},{"t":10.8,"text":"我是馬米"},{"t":12,"text":"最近是不是有看到好多人在拜拜呢"},{"t":16.8,"text":"也有聽到爸爸媽媽在說"},{"t":19.9,"text":"我們要準備去買東西"},{"t":22.2,"text":"然後來參加一些普渡的活動"},{"t":25.3,"text":"我們今天呢就要講"},{"t":28,"text":"有關於中元節的故事哦"},{"t":30.7,"text":"那我們一起來去聽故事吧"},{"t":34.1,"text":"今天呢普渡豬心情很好"},{"t":41.6,"text":"邊開著車呢還邊唱歌"},{"t":44.9,"text":"突然他聞到一個香香的味道"},{"t":52.5,"text":"動動他的豬鼻子"},{"t":55.8,"text":"嗯好香哦"},{"t":58,"text":"噗噗豬呢往前一看"},{"t":60.7,"text":"哇"},{"t":62,"text":"廣場上呢有好大好長的桌子"},{"t":66.9,"text":"桌子上呢有紅色的蘋果"},{"t":69.6,"text":"黃色的香蕉"},{"t":71.7,"text":"還有好多好多的洋芋片"},{"t":75.2,"text":"果凍"},{"t":76.3,"text":"餅乾"},{"t":77.5,"text":"跟飲料"},{"t":78.7,"text":"全部都是好吃的東西"},{"t":82.2,"text":"噗噗豬呢開心的跳了起來"},{"t":85.2,"text":"哦耶"},{"t":87.2,"text":"今天呢"},{"t":88,"text":"我們是要來開零食派對嗎"},{"t":91.4,"text":"這時候呢"},{"t":92.3,"text":"噗噗豬呢摸摸他的肚子"},{"t":95,"text":"聽到咕嚕咕嚕咕嚕的聲音"},{"t":98.5,"text":"哦我肚子餓了"},{"t":101.7,"text":"他呢正伸出手"},{"t":103.7,"text":"想要拿一包餅乾"},{"t":105.9,"text":"哎噗噗豬稍等一下"},{"t":109.3,"text":"這個時候呢"},{"t":110.5,"text":"海龜暖暖老師走了過來"},{"t":114.6,"text":"這些零食還不能吃哦"},{"t":118,"text":"噗噗豬歪著頭說"},{"t":119.8,"text":"為什麼呢"},{"t":121.6,"text":"因為今天是農曆的7月15日"},{"t":125.9,"text":"也是中元節"},{"t":128,"text":"中元節"},{"t":130.3,"text":"那個是什麼節日啊"},{"t":133.6,"text":"中元節呢"},{"t":135.2,"text":"是很久很久以前就流傳下來的傳統節日哦"},{"t":139.5,"text":"這一天會有很多人準備好吃的食物來祭拜"},{"t":145.1,"text":"也有一些地方呢"},{"t":146.9,"text":"會一起普通節日"},{"t":147.9,"text":"也有一些地方呢"},{"t":148.9,"text":"會一起普通節日啊"},{"t":149.9,"text":"那這些東西呢"},{"t":150.9,"text":"就會有很多人準備吃的啊"},{"t":151.9,"text":"那這些東西呢"},{"t":152.9,"text":"就會有很多人準備吃的啊"},{"t":153.9,"text":"那這些東西呢"},{"t":154.9,"text":"就會有很多人準備吃的啊"},{"t":155.9,"text":"那這些東西呢"},{"t":156.9,"text":"就會有很多人準備吃的啊"},{"t":157.9,"text":"那這些東西呢"},{"t":158.9,"text":"就會有很多人準備吃的啊"},{"t":159.9,"text":"那這些東西呢"},{"t":160.9,"text":"就會有很多人準備吃的啊"},{"t":161.9,"text":"那這些東西呢"},{"t":162.9,"text":"就會有很多人準備吃的啊"},{"t":163.9,"text":"那這些東西呢"},{"t":164.9,"text":"就會有很多人準備吃的啊"},{"t":165