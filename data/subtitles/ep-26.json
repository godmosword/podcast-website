[{"t":0,"text":"我們一起出發去"},{"t":4.5,"text":"嗨 我是 Bonbon"},{"t":10.8,"text":"我是馬米"},{"t":12,"text":"最近是不是有看到好多人在拜拜呢"},{"t":16.8,"text":"也有聽到爸爸媽媽在說"},{"t":19.9,"text":"我們要準備去買東西"},{"t":22.2,"text":"然後來參加一些普渡的活動"},{"t":25.3,"text":"我們今天呢就要講"},{"t":28,"text":"有關於中元節的故事哦"},{"t":30.7,"text":"那我們一起來去聽故事吧"},{"t":34.1,"text":"今天呢噗噗豬心情很好"},{"t":41.6,"text":"邊開著車呢還邊唱歌"},{"t":44.9,"text":"突然他聞到一個香香的味道"},{"t":52.5,"text":"動動他的豬鼻子"},{"t":55.8,"text":"嗯好香哦"},{"t":58,"text":"噗噗豬呢往前一看"},{"t":60.7,"text":"哇"},{"t":62,"text":"廣場上呢有好大好長的桌子"},{"t":66.9,"text":"桌子上呢有紅色的蘋果"},{"t":69.6,"text":"黃色的香蕉"},{"t":71.8,"text":"還有好多好多的洋芋片"},{"t":75.2,"text":"果凍"},{"t":76.3,"text":"餅乾"},{"t":77.5,"text":"跟飲料"},{"t":78.7,"text":"全部都是好吃的東西"},{"t":82.2,"text":"噗噗豬呢開心的跳了起來"},{"t":85.2,"text":"哦耶"},{"t":87.2,"text":"今天呢"},{"t":88,"text":"今天我們是要來開零食派對嗎"},{"t":91.5,"text":"這時候呢"},{"t":92.3,"text":"噗噗豬呢摸摸他的肚子"},{"t":95.1,"text":"聽到咕嚕咕嚕咕嚕的聲音"},{"t":99.5,"text":"我肚子餓了"},{"t":101.7,"text":"他呢正想要拿一包餅乾"},{"t":106,"text":"噗噗豬稍等一下"},{"t":109.4,"text":"這個時候呢"},{"t":110.6,"text":"海龜老師暖暖走了過來"},{"t":114.6,"text":"這些零食還不能吃哦"},{"t":117.9,"text":"噗噗豬歪著頭說"},{"t":119.9,"text":"為什麼呢"},{"t":121.6,"text":"因為今天是農曆的七月十五日"},{"t":125.9,"text":"也是中元節"},{"t":128,"text":"中元節"},{"t":130.3,"text":"那個是什麼節日啊"},{"t":133.6,"text":"中元節呢"},{"t":135.1,"text":"是很久很久以前就流傳下來的傳統節日哦"},{"t":139.6,"text":"這一天會有很多人準備好吃的食物來祭拜"},{"t":145.1,"text":"也有一些地方呢"},{"t":146.9,"text":"會一起普渡"},{"t":147.9,"text":"就像是在家裡面吃飯的時候呢"},{"t":165.1,"text":"噗噗豬呢"},{"t":166.1,"text":"看著滿桌的零食"},{"t":167.9,"text":"所以這些不是我的零食"},{"t":171.3,"text":"是的是的"},{"t":173,"text":"現在這些零食還不能吃哦"},{"t":176.6,"text":"在車車遊樂園裡面啊"},{"t":179.4,"text":"還有關於一個中元節的小故事"},{"t":182.9,"text":"你想要聽嗎"},{"t":184.6,"text":"噗噗豬呢"},{"t":186.2,"text":"點點頭說"},{"t":187.1,"text":"好哦"},{"t":188,"text":"想聽想聽"},{"t":190.2,"text":"傳說"},{"t":193.8,"text":"在很遠很遠的地方"},{"t":196.8,"text":"有一群呢"},{"t":197.8,"text":"旅行中的流浪小車車"},{"t":200.7,"text":"他們呢"},{"t":201.9,"text":"有的是小卡車"},{"t":206.5,"text":"有的是吉普車"},{"t":212.4,"text":"還有消防車"},{"t":217,"text":"跟好多好多種的車車"},{"t":219.9,"text":"他們呢"},{"t":220.9,"text":"開過大山"},{"t":225,"text":"開過森林"},{"t":226,"text":"又開過好多好多條路"},{"t":230.9,"text":"開著開著"},{"t":232.7,"text":"肚子都餓了"},{"t":234.5,"text":"這些流浪小車車呢"},{"t":236.8,"text":"旅行了好久好久"},{"t":238.5,"text":"很辛苦"},{"t":239.8,"text":"所以我們在中元節這一天"},{"t":243.2,"text":"準備好吃的食物"},{"t":245.2,"text":"請他們吃得飽飽的"},{"t":247,"text":"這時候呢"},{"t":249,"text":"噗噗豬一聽到馬上說"},{"t":250.8,"text":"那我也要分享"},{"t":252.6,"text":"我要把我最喜歡的"},{"t":254.9,"text":"草莓餅乾送給他們"},{"t":257,"text":"噗噗豬咻一下就跑回家了"},{"t":260.6,"text":"過了一會兒"},{"t":261.6,"text":"他抱了一大盒的草莓餅乾回來"},{"t":265.4,"text":"這些餅乾啊"},{"t":267.5,"text":"超級好吃的喔"},{"t":269.3,"text":"他對著空氣說"},{"t":271.8,"text":"流浪小車車"},{"t":273.4,"text":"你們辛苦了"},{"t":274.7,"text":"這些草莓餅乾請你們吃"},{"t":277.5,"text":"海龜老師暖暖笑了"},{"t":280,"text":"噗噗豬學會分享了呢"},{"t":283.4,"text":"到了傍晚"},{"t":284.9,"text":"風呢輕輕的吹過來"},{"t":287.7,"text":"風鈴呢發出了聲音"},{"t":293.9,"text":"噗噗豬呢耳朵動了一下"},{"t":297.2,"text":"咦"},{"t":298,"text":"是不是有"},{"t":299.5,"text":"小車車在吃我的餅乾啊"},{"t":303.1,"text":"也許他們收到你的心意囉"},{"t":306.7,"text":"噗噗豬呢閉上眼睛想像"},{"t":310.2,"text":"小卡車在吃著餅乾"},{"t":314.9,"text":"吉普車呢正在喝一大口的果汁"},{"t":321,"text":"消防車正在吃著草莓餅乾"},{"t":326.9,"text":"吃得飽飽的小車車們"},{"t":331.8,"text":"一起按下喇叭"},{"t":335.6,"text":"彷彿好像在說"},{"t":337.9,"text":"謝謝你們"},{"t":339.4,"text":"這時候暖暖老師小聲的說"},{"t":342.5,"text":"車車遊樂園"},{"t":344.8,"text":"還有一個溫暖的傳說"},{"t":348.7,"text":"就是"},{"t":349.9,"text":"收到心意的流浪小車車"},{"t":352.8,"text":"會把這一份心意"},{"t":354.8,"text":"轉變成祝福喔"},{"t":357.6,"text":"這樣子大家在每天開車出門的時候"},{"t":360.9,"text":"就可以"},{"t":362,"text":"快快樂樂的出門"},{"t":364,"text":"平平安安的回家"},{"t":366.8,"text":"這時候呢"},{"t":367.9,"text":"噗噗豬開心的揮揮他的雨刷"},{"t":370.9,"text":"謝謝流浪小車車們"},{"t":374.3,"text":"普渡"},{"t":374.8,"text":"結束之後呢"},{"t":375.8,"text":"大家把桌上的食物收起來"},{"t":378.6,"text":"噗噗豬問說"},{"t":379.9,"text":"現在可以吃了嗎"},{"t":382.2,"text":"暖暖老師點點頭"},{"t":384,"text":"可以喔"},{"t":385,"text":"大家現在可以一起分享吃囉"},{"t":388.3,"text":"噗噗豬呢馬上大喊"},{"t":390.1,"text":"喔耶我想要來吃我最喜歡的草莓餅乾"},{"t":397.3,"text":"太好吃了"},{"t":404.8,"text":"小朋友"},{"t":406.6,"text":"你有聽過中元節嗎"},{"t":409.9,"text":"最近走在路上"},{"t":411.4,"text":"有沒有看到好多人擺著桌子"},{"t":414,"text":"準備好多的食物在普渡拜拜呢"},{"t":418.3,"text":"中元節是流傳很久的傳統節日"},{"t":421.9,"text":"有些家庭呢會祭拜祖先"},{"t":424.7,"text":"也有一些會準備食物普渡"},{"t":427.6,"text":"分享給那些我們看不見"},{"t":429.9,"text":"在外面流浪的朋友們"},{"t":432.7,"text":"就像故事裡面的"},{"t":434.7,"text":"流浪小車車一樣"},{"t":436.3,"text":"我們雖然看不見他們"},{"t":438.3,"text":"也可以準備一份小小的心意"},{"t":441.1,"text":"送上祝福喔"},{"t":443.2,"text":"把好吃的食物跟滿滿的祝福"},{"t":446,"text":"一起分享出去"},{"t":448.1,"text":"祝大家都平平安安"},{"t":450.6,"text":"健健康康快快樂樂"},{"t":452.9,"text":"好了我們今天的故事呢"},{"t":454.7,"text":"就說到這邊囉"},{"t":456.5,"text":"下一次"},{"t":457.8,"text":"我們再一起來車車遊樂園玩吧"},{"t":462.1,"text":"拜拜"}]
