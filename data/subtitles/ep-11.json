[{"t":0,"text":"我們一起出發去"},{"t":4.5,"text":"嗨我是 Bonbon"},{"t":10.9,"text":"我是馬米"},{"t":12,"text":"我們呢今天要講的故事呢"},{"t":15.8,"text":"是摩天輪高高的溫柔超能力"},{"t":19.3,"text":"小朋友你有沒有遇過一種情況啊"},{"t":23.8,"text":"就算你已經很努力了"},{"t":25.7,"text":"還是有同學啊或是朋友對你說"},{"t":28.6,"text":"我討厭你我不想跟你玩"},{"t":31.8,"text":"這時候你是不是會覺得心裡酸酸的好難過呢"},{"t":36.2,"text":"萌萌有遇過這樣的事情嗎"},{"t":40,"text":"嗯有"},{"t":41,"text":"那感覺怎麼樣呢"},{"t":43.7,"text":"很不舒服"},{"t":45.3,"text":"很不舒服哦"},{"t":46.8,"text":"好的那我們今天來分享這個故事好嗎"},{"t":51.4,"text":"今天呢遊樂園裡面呢脾氣最好"},{"t":57.7,"text":"長得最高的摩天輪叫高高"},{"t":61.6,"text":"他就遇到了這個大難題"},{"t":63.7,"text":"高高呢每天呢都笑咪咪的"},{"t":67,"text":"然後呢他會慢慢的轉動"},{"t":70.1,"text":"把大家呢送到天空上去看風景"},{"t":75.7,"text":"今天呢有一臺呢叫做小蔥的黃色菜車呢開了過來"},{"t":81.4,"text":"小蔥呢是一臺喜歡追求速度感的車車"},{"t":85.6,"text":"他喜歡開的很快"},{"t":87.7,"text":"他看著高高很不耐煩按的喇叭說"},{"t":92.5,"text":"哎我最討厭高高了"},{"t":95.9,"text":"轉的那麼慢一點都不刺激無聊透頂了"},{"t":99.5,"text":"我再也不想要坐摩天輪了"},{"t":101.3,"text":"說完以後呢小蔥呢就轟一聲的"},{"t":105.4,"text":"然後飆車去玩"},{"t":108,"text":"已經要飛車了"},{"t":109.1,"text":"聽到這句話呢高高心裡好難過"},{"t":113.5,"text":"他身上呢的彩色燈泡啪一聲"},{"t":117.7,"text":"全部都按了下來"},{"t":120.5,"text":"高高呢低著頭傷心的想"},{"t":123.6,"text":"小蔥討厭我"},{"t":125.2,"text":"原來呢慢吞吞是一件糟糕的事情"},{"t":129.2,"text":"大家來遊樂園就是想要找刺激的"},{"t":132.3,"text":"我是不是一個很沒有用很不好玩的遊樂設施呢"},{"t":137.3,"text":"高高呢越想越難過"},{"t":139.8,"text":"他呢甚至想要把自己停下來再也不要轉動了"},{"t":144.6,"text":"這個時候呢來了一臺小小的粉紅露營車"},{"t":148.8,"text":"叫做小柔"},{"t":150.5,"text":"他開了過來喔"},{"t":153,"text":"小柔呢剛剛呢才玩完雲霄飛車"},{"t":156.1,"text":"他嚇得呢輪胎一直在發抖"},{"t":158.9,"text":"頭呢也暈暈的"},{"t":161.2,"text":"小柔呢輕輕的開進高高的車廂裡"},{"t":164.8,"text":"小聲的說"},{"t":166.1,"text":"高高"},{"t":167.4,"text":"拜託你帶我上去休息一下"},{"t":169.9,"text":"我現在好需要你喔"},{"t":172.5,"text":"高高呢一邊慢慢的轉動"},{"t":174.6,"text":"一邊忍不住的問"},{"t":176.9,"text":"小柔"},{"t":178.2,"text":"大家都喜歡快快的車"},{"t":180.5,"text":"我轉的這麼慢又這麼無聊"},{"t":182.8,"text":"難道你不討厭我嗎"},{"t":185.6,"text":"小柔呢搖搖頭"},{"t":187.6,"text":"閉著眼睛呢享受這個吹來涼涼的風"},{"t":193,"text":"他溫柔的說"},{"t":194.5,"text":"才不會呢高高"},{"t":196.3,"text":"就是因為你轉得很慢"},{"t":198.6,"text":"我暈暈的腦袋才舒服了"},{"t":201.5,"text":"就是因為你很平穩"},{"t":203.3,"text":"我才不會害怕"},{"t":204.6,"text":"在這麼高的地方還可以看到這麼漂亮的風景"},{"t":209.2,"text":"對我來說你的慢吞吞"},{"t":212.3,"text":"是最棒的超能力喔"},{"t":215.8,"text":"高高聽了之後眼睛突然亮了起來"},{"t":218.9,"text":"身上的燈泡呢也亮了起來"},{"t":223.5,"text":"他突然明白了喔"},{"t":225.3,"text":"小蔥喜歡吃雞"},{"t":227.1,"text":"那換個角度看"},{"t":229.2,"text":"他的慢吞吞是缺點"},{"t":230.9,"text":"所以小蔥討厭他"},{"t":233,"text":"可是小柔需要按摩啊"},{"t":234.6,"text":"安全感與安靜"},{"t":236.9,"text":"換成這樣的角度看"},{"t":238.7,"text":"他的慢吞吞就變成了優點喔"},{"t":242,"text":"所以呢小柔超級喜歡他"},{"t":246.1,"text":"高高想"},{"t":247.1,"text":"原來我不糟糕"},{"t":249.2,"text":"換一個角度看我的慢可以帶給別人滿滿的安全感"},{"t":254.3,"text":"高高不再難過了"},{"t":255.8,"text":"他知道呢就算有人討厭他"},{"t":258.6,"text":"也不代表他很差勁喔"},{"t":264.6,"text":"小朋友如果有一天呢有人對你說我不喜歡你"},{"t":270.5,"text":"請你不要馬上覺得自己很糟糕喔"},{"t":273.8,"text":"你只要在心裡記住這個很重要的魔法"},{"t":277.9,"text":"別人不喜歡你只是因為"},{"t":280.5,"text":"你們剛好不一樣"},{"t":282.2,"text":"絕對不是你很差勁"},{"t":284.3,"text":"只要換個角度看"},{"t":286.1,"text":"你一定可以找到自己超級的優點"},{"t":289.2,"text":"在這個世界上的一定有另外一個人也超級喜歡原本的你喔"},{"t":294.6,"text":"下次如果覺得心裡酸酸的"},{"t":297.1,"text":"記得想起高高的溫柔超能力喔"},{"t":301,"text":"那我們今天的故事就說到這裡咯"},{"t":304.6,"text":"你喜歡坐摩天輪嗎"},{"t":306.6,"text":"但是我"},{"t":307.6,"text":"我害怕雲霄飛車"},{"t":309.7,"text":"為什麼"},{"t":310.7,"text":"因為"},{"t":311.7,"text":"我怕它太高"},{"t":313.5,"text":"太高"},{"t":314.5,"text":"然後怕它滑下來"},{"t":316.9,"text":"我不小心買車我就跌下去"},{"t":319.2,"text":"喔你覺得雲霄飛車"},{"t":321.2,"text":"飛得很快然後又很刺激對不對"},{"t":324.5,"text":"我怕我晚上會做噩夢"},{"t":326.8,"text":"喔那你喜歡坐摩天輪嗎"},{"t":329.7,"text":"習慣"},{"t":330.9,"text":"因為摩天輪慢慢的又可以吹風好舒服對不對"},{"t":334.8,"text":"還可以看風景對吧"},{"t":336.6,"text":"對"},{"t":337.1,"text":"哇所以你是喜歡高高的咯"},{"t":339.4,"text":"嗯"},{"t":340.2,"text":"好啦"},{"t":340.9,"text":"我們下次再一起來車車遊樂園玩吧"},{"t":344.8,"text":"拜拜"}]
