[{"t":0,"text":"我們一起出發去"},{"t":4.5,"text":"嗨,我是蹦蹦"},{"t":10.8,"text":"我是馬明"},{"t":12,"text":"今天要講的是神奇未來的電動車"},{"t":17.3,"text":"我們就這樣子看著哦"},{"t":19.9,"text":"太陽公公呢,他早起哦"},{"t":23,"text":"然後呢,有一個小男孩叫蹦蹦"},{"t":25.8,"text":"他也起得很早"},{"t":27.1,"text":"然後呢,他揹著黃色的小書包"},{"t":30.5,"text":"大聲的,興奮的喊著"},{"t":33.2,"text":"耶,我們今天要去動物園咯"},{"t":36,"text":"可是呢,動物園好遠好遠哦"},{"t":39.7,"text":"大概要搭一個多小時的車程"},{"t":42,"text":"蹦蹦呢,嘟著小嘴說"},{"t":44.4,"text":"一個小時好久哦"},{"t":46.9,"text":"要在車上做什麼呢"},{"t":49.5,"text":"就在這個時候呢"},{"t":52,"text":"門口呢,傳來一個很輕快的聲音"},{"t":55.1,"text":"嗶嗶嗶,嗶嗶嗶"},{"t":57.1,"text":"哦,一個閃亮亮的未來電動車"},{"t":61.1,"text":"停在蹦蹦面前"},{"t":63.3,"text":"他呢,像這個翅膀一樣"},{"t":66.7,"text":"車門慢慢慢慢的開啟"},{"t":69,"text":"圓滾滾的小機器"},{"t":71.2,"text":"人呢,叫做沃特"},{"t":73.1,"text":"他呢,就飄了出來"},{"t":75.1,"text":"很有禮貌的問說"},{"t":76.9,"text":"你好啊,蹦蹦"},{"t":78.7,"text":"我是你的小竹手沃特"},{"t":81.1,"text":"別擔心,路途很遙遠"},{"t":83.5,"text":"這一臺車會變魔術哦"},{"t":85.9,"text":"哇!"},{"t":87.1,"text":"我可以在車上剪頭髮"},{"t":89.1,"text":"我們來看看車上裡面有什麼東西哦"},{"t":92.6,"text":"蹦蹦呢,他坐進了車裡之後"},{"t":95.4,"text":"發現,嗯?"},{"t":97,"text":"車子裡面沒有方向盤耶"},{"t":98.9,"text":"可是呢,有好多軟綿綿的沙發"},{"t":101.9,"text":"跟好多彩色的按鈕哦"},{"t":104.4,"text":"這時候呢"},{"t":106,"text":"這個時候呢,沃特呢"},{"t":107.9,"text":"就按下了一個綠色的按鈕"},{"t":109.6,"text":"車車呢,就開始很平穩的出發咯"},{"t":112.6,"text":"這時候呢,沃特就說"},{"t":114.9,"text":"我們要開啟"},{"t":117,"text":"這個車"},{"t":117.1,"text":"自動駕駛模式咯"},{"t":119.1,"text":"蹦蹦,你準備好了嗎?"},{"t":122.3,"text":"準備好了嗎?"},{"t":123.2,"text":"準備好了"},{"t":124.1,"text":"那我們要開始走咯"},{"t":125.6,"text":"GO!"},{"t":127,"text":"突然間呢"},{"t":127.8,"text":"車廂變成很漂亮的理髮廳"},{"t":131.1,"text":"咔嚓咔嚓"},{"t":132.1,"text":"哦!"},{"t":132.7,"text":"兩隻很靈巧的手臂"},{"t":134.7,"text":"就伸的出來了"},{"t":136.3,"text":"嗯?"},{"t":137,"text":"這個是要幫忙剪頭髮的哦?"},{"t":140.4,"text":"我們要幫蹦蹦剪一個很帥的頭髮哦"},{"t":144.1,"text":"這時候呢"},{"t":144.9,"text":"蹦蹦是不是覺得頭很癢?"},{"t":147.1,"text":"然後就忍不住"},{"t":148.1,"text":"哈哈哈哈"},{"t":149,"text":"一直在笑,對不對?"},{"t":151.3,"text":"這時候呢"},{"t":152.3,"text":"這個小機器人呢"},{"t":153.8,"t