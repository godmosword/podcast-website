[{"t":0,"text":"我們一起出發去"},{"t":4.4,"text":"嗨 我是 Bonbon"},{"t":10.9,"text":"我是馬米"},{"t":11.9,"text":"我們今天要講的故事呢"},{"t":15,"text":"跟101有關"},{"t":16.5,"text":"我們最近有去101的觀景臺"},{"t":19.5,"text":"對不對"},{"t":19.9,"text":"那你對那邊"},{"t":21.8,"text":"你覺得有什麼特別的印象呢"},{"t":23.9,"text":"我就是印象它"},{"t":25.8,"text":"它那裡風景很美麗"},{"t":28.8,"text":"風景很美麗"},{"t":29.7,"text":"就是如果從上面看呢"},{"t":32.1,"text":"從上面往下看"},{"t":33.6,"text":"就是會很像TOMICA小車車"},{"t":37.2,"text":"喔 這樣子喔"},{"t":39.5,"text":"像小車車在移動"},{"t":40.6,"text":"超級小可愛"},{"t":43,"text":"我們今天呢"},{"t":44.1,"text":"要講的是水泥車阿尼的101任務故事"},{"t":50,"text":"那接下來我們就來去說故事吧"},{"t":53.3,"text":"耶"},{"t":57.7,"text":"車車遊樂園"},{"t":59.5,"text":"最近呢出了一個很特別的任務"},{"t":62.8,"text":"這個任務就是要蓋101層高的大樓喔"},{"t":69.3,"text":"今天的故事呢"},{"t":70.7,"text":"跟一臺水泥車有關"},{"t":73.4,"text":"它的名字叫做阿尼"},{"t":76.6,"text":"阿尼呢"},{"t":77.4,"text":"她有一個大大的水泥桶"},{"t":80.3,"text":"是一臺黃色圓滾滾的水泥車"},{"t":85,"text":"她的工作呢"},{"t":86.2,"text":"就是把水泥沙石"},{"t":89.2,"text":"還有水"},{"t":90.6,"text":"滾動滾動"},{"t":92.5,"text":"攪拌攪拌"},{"t":94.6,"text":"攪拌在一起之後呢"},{"t":96.7,"text":"再運送到工地"},{"t":102.5,"text":"可是阿尼常常覺得自己好像沒有很厲害"},{"t":107.5,"text":"每次呢她看見跑車很快的開過去"},{"t":111,"text":"咻"},{"t":114.1,"text":"她心裡就會想說"},{"t":116.3,"text":"跑車開的好快好帥喔"},{"t":118.9,"text":"她又看見吊車呢"},{"t":120.9,"text":"把鋼筋舉的高高的"},{"t":124,"text":"心裡就想著"},{"t":125.9,"text":"吊車也好厲害喔"},{"t":129,"text":"可以把東西送到這麼高的地方"},{"t":134.2,"text":"有一天"},{"t":135.5,"text":"阿尼呢"},{"t":136.3,"text":"接到一個超級任務喔"},{"t":140.3,"text":"她要去幫忙蓋一棟"},{"t":142.3,"text":"好高好高的大樓"},{"t":144.3,"text":"這棟大樓叫做101"},{"t":148.6,"text":"我有知道就是101"},{"t":152.5,"text":"你為什麼知道是101"},{"t":153.9,"text":"因為我有去過"},{"t":156,"text":"喔因為你有去過"},{"t":157.6,"text":"好"},{"t":159.2,"text":"這邊呢工地有好多的工程車喔"},{"t":163.2,"text":"挖土機東東呢正在挖呀挖"},{"t":166.8,"text":"努力的挖地基"},{"t":170.6,"text":"大吊車阿公正把這個鋼筋吊的高高的"},{"t":176.3,"text":"阿尼呢也開始工作囉"},{"t":178.3,"text":"她的水泥桶呢滾動滾動的轉著"},{"t":182.2,"text":"一趟水泥"},{"t":187.5,"text":"兩趟水泥"},{"t":189.8,"text":"三趟水泥"},{"t":192.3,"text":"阿尼呢把水泥一趟又一趟的"},{"t":196.4,"text":"送到大樓下面"},{"t":198.1,"text":"可是大樓越蓋越高"},{"t":202.2,"text":"阿尼呢卻只能一直待在最下面"},{"t":205.5,"text":"她呢嘆了一口氣說"},{"t":208,"text":"哎"},{"t":211,"text":"大家都看見高高的大樓"},{"t":213.8,"text":"有誰會看見在下面的我呢"},{"t":218.3,"text":"這時候呢大吊車阿公輕輕拍拍阿尼的車身"},{"t":223.9,"text":"跟阿尼說"},{"t":226,"text":"阿尼你知道為什麼這一棟大樓叫101嗎"},{"t":233,"text":"阿尼搖搖頭"},{"t":235,"text":"吊車阿公呢笑了笑說"},{"t":237.7,"text":"100分已經很棒了"},{"t":240.3,"text":"就像滿分一樣"},{"t":242.4,"text":"可是101是比100再多一點點"},{"t":248.9,"text":"代表我們還可以再努力一點點"},{"t":252.9,"text":"再勇敢一點點哦"},{"t":255.9,"text":"阿尼呢眨眨眼睛認真的聽著"},{"t":259.4,"text":"大吊車阿公又說"},{"t":261.5,"text":"高高的大樓要站得很穩"},{"t":264.8,"text":"最重要的是什麼"},{"t":267.4,"text":"是下面的地基"},{"t":270,"text":"如果沒有你送來很穩固的水泥"},{"t":273.8,"text":"大樓就沒有辦法一層一層的往上蓋哦"},{"t":278.6,"text":"阿尼聽完心裡暖暖的"},{"t":281.7,"text":"原來默默的在下面幫忙"},{"t":284.8,"text":"也是一件很重要的事哦"},{"t":288.2,"text":"認真做好自己的工作"},{"t":290.7,"text":"就是一個很棒的任務"},{"t":293.2,"text":"從那天開始"},{"t":294.8,"text":"阿尼不再一直羨慕別人"},{"t":297.1,"text":"她每天都很認真負責任的工作"},{"t":300.4,"text":"滾動攪拌著她的大圓筒"},{"t":303.7,"text":"一趟又一趟的水泥"},{"t":306.3,"text":"被阿尼穩穩的送到101旁邊"},{"t":312.4,"text":"終於有一天"},{"t":314,"text":"101蓋好了"},{"t":320.6,"text":"那是一棟又高又壯的大樓"},{"t":325,"text":"阿尼呢停在遠遠的地方"},{"t":326.8,"text":"看著高大的101"},{"t":329.6,"text":"心裡呢很開心的笑了"},{"t":332.9,"text":"因為她知道這棟大樓裡面有她的努力哦"},{"t":337.5,"text":"阿尼的101任務完成了"},{"t":348.3,"text":"小朋友今天的故事呢是跟我們說"},{"t":351.6,"text":"有時候我們幫忙別人"},{"t":354.2,"text":"或是認真的在做一件事情"},{"t":356.5,"text":"不一定會馬上被看見"},{"t":359.3,"text":"但是每天負責任"},{"t":361.6,"text":"完成自己的小小任務"},{"t":363.9,"text":"就是很棒很棒的事哦"},{"t":367.2,"text":"例如你可以自己整理好自己的書包"},{"t":371.1,"text":"時間到了去刷牙"},{"t":373.6,"text":"玩玩具玩完自己收好"},{"t":376.4,"text":"這些都是很棒的小任務哦"},{"t":380.5,"text":"從今天開始"},{"t":381.8,"text":"我們也可以像阿尼一樣"},{"t":383.9,"text":"試著把自己的事情做好好嗎"},{"t":386.5,"text":"好啊"},{"t":388,"text":"一點一點的"},{"t":389,"text":"把它做完"},{"t":390.3,"text":"就會變得更厲害咯"},{"t":393.1,"text":"可以嗎"},{"t":393.9,"text":"可以"},{"t":395.7,"text":"好咯"},{"t":396.5,"text":"那我們今天的故事就說到這邊咯"},{"t":399.5,"text":"下一次"},{"t":400.3,"text":"我們再一起來車車遊樂園玩吧"},{"t":404.9,"text":"拜拜"}]
